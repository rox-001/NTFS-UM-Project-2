 61: def _should_ignore_path(path: str) -> bool:
 62:     """
 63:     Return True if the file should be ignored:
 64:       - Internal application folders (logs/, reports/, build/, dist/, .git/)
 65:       - Zero-length system/lock files (desktop.ini, thumbs.db)
