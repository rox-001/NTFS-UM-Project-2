175: def is_allowlisted(filepath: str, digest: str = None) -> bool:
176:     if not filepath:
177:         return False
178:     norm_path = os.path.normcase(os.path.normpath(os.path.abspath(filepath)))
179:     _, ext = os.path.splitext(norm_path)
180: 
181:     with _db_lock, _get_connection() as conn:
182:         # Check path
183:         row = conn.execute("SELECT 1 FROM allowlist WHERE entry = ? AND entry_type = 'path'", (norm_path,)).fetchone()
184:         if row:
185:             return True
186:         # Check extension
187:         if ext:
188:             row = conn.execute("SELECT 1 FROM allowlist WHERE entry = ? AND entry_type = 'ext'", (ext,)).fetchone()
189:             if row:
190:                 return True
191:         # Check hash
192:         if digest:
193:             row = conn.execute("SELECT 1 FROM allowlist WHERE entry = ? AND entry_type = 'hash'", (digest.lower(),)).fetchone()
194:             if row:
195:                 return True
196:     return False
