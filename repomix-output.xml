 99:     basename = os.path.basename(norm).lower()
100: 
101:     # 3. System metadata files
102:     if basename in _IGNORED_NAMES_SET:
103:         return True
104: 
105:     # 4. Office lock files (~$)
106:     if basename.startswith("~$") or basename.startswith(".~"):
107:         try:
108:             if os.path.exists(path) and os.path.getsize(path) > 1024:
