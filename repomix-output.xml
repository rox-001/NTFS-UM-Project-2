<file path="hasher.py">
 1: """
 2: hasher.py - File Integrity Hashing Module
 3: Uses Python's built-in hashlib — no installation required.
 4: Supports SHA256, SHA512, and MD5 algorithms.
 5: """
 6: 
 7: from __future__ import annotations   # PEP 563: compatible with Python 3.7+
 8: 
 9: import hashlib
10: import os
11: from config import HASH_ALGORITHM, HASH_CHUNK_SIZE
12: 
13: # In-memory snapshot: {filepath: hash_digest}
14: # Populated before a transfer for pre/post comparison.
15: _hash_snapshot: dict[str, str] = {}
16: 
17: 
18: def compute_hash(filepath: str, algorithm: str = HASH_ALGORITHM) -> str | None:
19:     """
20:     Compute the hash of a file using the specified algorithm.
21: 
22:     Args:
23:         filepath:  Absolute path to the file.
24:         algorithm: Hash algorithm name ('sha256', 'sha512', 'md5').
25: 
26:     Returns:
27:         Hex digest string, or None if the file cannot be read.
28:     """
29:     try:
30:         h = hashlib.new(algorithm)
31:         with open(filepath, "rb") as f:
32:             while chunk := f.read(HASH_CHUNK_SIZE):
33:                 h.update(chunk)
34:         return h.hexdigest()
35:     except (FileNotFoundError, PermissionError, OSError, ValueError):
36:         return None
37: 
38: 
39: def verify_integrity(pre_hash: str | None, post_hash: str | None) -> tuple[bool, str]:
40:     """
41:     Compare pre- and post-transfer hashes.
42: 
43:     Returns:
44:         (True, "INTACT")       if hashes match
45:         (False, "TAMPERED")    if hashes differ
46:         (False, "UNAVAILABLE") if either hash is None
47:     """
48:     if pre_hash is None or post_hash is None:
49:         return False, "UNAVAILABLE"
50:     if pre_hash == post_hash:
51:         return True, "INTACT"
52:     return False, "TAMPERED"
53: 
54: 
55: def snapshot_file(filepath: str) -> str | None:
56:     """
57:     Compute and store the hash of a file in the snapshot dict.
58:     Call this BEFORE a transfer occurs.
59: 
60:     Returns:
61:         The computed hash, or None on failure.
62:     """
63:     digest = compute_hash(filepath)
64:     if digest:
65:         _hash_snapshot[filepath] = digest
66:     return digest
67: 
68: 
69: def check_against_snapshot(filepath: str) -> tuple[bool, str, str | None, str | None]:
70:     """
71:     Compare a file's current hash against its stored snapshot.
72:     Call this AFTER a transfer/modification occurs.
73: 
74:     Returns:
75:         (integrity_ok, status, pre_hash, post_hash)
76:     """
77:     pre_hash  = _hash_snapshot.get(filepath)
78:     post_hash = compute_hash(filepath)
79:     ok, status = verify_integrity(pre_hash, post_hash)
80:     return ok, status, pre_hash, post_hash
81: 
82: 
83: def clear_snapshot(filepath: str = None):
84:     """Remove a specific file from the snapshot, or clear all."""
85:     if filepath:
86:         _hash_snapshot.pop(filepath, None)
87:     else:
88:         _hash_snapshot.clear()
89: 
90: 
91: def get_snapshot() -> dict:
92:     """Return a copy of the current hash snapshot."""
93:     return dict(_hash_snapshot)
</file>

<file path="logger.py">
  1: """
  2: logger.py - Structured Audit Logging Module
  3: Writes JSON-line entries to logs/audit.log.
  4: Also provides colored console output via colorama (always available, no network needed).
  5: """
  6: 
  7: from __future__ import annotations   # PEP 563: compatible with Python 3.7+
  8: 
  9: import json
 10: import os
 11: import sys
 12: from datetime import datetime
 13: 
 14: from colorama import Fore, Style, init as colorama_init
 15: 
 16: from config import AUDIT_LOG_PATH, LOG_DIR, HASH_ALGORITHM
 17: 
 18: # Initialize colorama (autoreset=True resets color after each print)
 19: colorama_init(autoreset=True)
 20: 
 21: # Ensure log directory exists
 22: os.makedirs(LOG_DIR, exist_ok=True)
 23: 
 24: # Color map for alert levels
 25: _LEVEL_COLORS = {
 26:     "INFO":     Fore.CYAN,
 27:     "WARNING":  Fore.YELLOW,
 28:     "CRITICAL": Fore.RED,
 29:     "NORMAL":   Fore.GREEN,
 30: }
 31: 
 32: _LEVEL_PREFIX = {
 33:     "INFO":     "[INFO]    ",
 34:     "WARNING":  "[WARNING] ",
 35:     "CRITICAL": "[CRITICAL]",
 36:     "NORMAL":   "[NORMAL]  ",
 37: }
 38: 
 39: 
 40: def _console_print(level: str, message: str):
 41:     """Print a color-coded line to the console safely across all Windows code pages."""
 42:     color  = _LEVEL_COLORS.get(level, Fore.WHITE)
 43:     prefix = _LEVEL_PREFIX.get(level, "[?]       ")
 44:     ts     = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
 45:     out    = f"{color}{ts} {prefix} {message}{Style.RESET_ALL}"
 46:     try:
 47:         print(out)
 48:     except UnicodeEncodeError:
 49:         print(out.encode("ascii", errors="replace").decode("ascii"))
 50: 
 51: 
 52: def log_event(
 53:     event_type: str,
 54:     source: str,
 55:     destination: str,
 56:     user: str,
 57:     process: str,
 58:     hash_pre: str | None,
 59:     hash_post: str | None,
 60:     integrity_status: str,
 61:     alert_level: str,
 62:     extra: dict = None,
 63: ):
 64:     """
 65:     Write a structured JSON log entry to audit.log and print to console.
 66: 
 67:     Args:
 68:         event_type:        Type of FS event (CREATED, MODIFIED, MOVED, DELETED).
 69:         source:            Source file path.
 70:         destination:       Destination path (empty string if not applicable).
 71:         user:              OS username performing the action.
 72:         process:           Name of the triggering process (or 'N/A').
 73:         hash_pre:          Hash before event (or None).
 74:         hash_post:         Hash after event (or None).
 75:         integrity_status:  'INTACT', 'TAMPERED', or 'UNAVAILABLE'.
 76:         alert_level:       'INFO', 'WARNING', or 'CRITICAL'.
 77:         extra:             Optional dict of additional fields.
 78:     """
 79:     entry = {
 80:         "timestamp":        datetime.now().isoformat(),
 81:         "event_type":       event_type,
 82:         "source":           source,
 83:         "destination":      destination,
 84:         "user":             user,
 85:         "process":          process,
 86:         "hash_algorithm":   HASH_ALGORITHM,
 87:         "hash_pre":         hash_pre or "N/A",
 88:         "hash_post":        hash_post or "N/A",
 89:         "integrity_status": integrity_status,
 90:         "alert_level":      alert_level,
 91:     }
 92:     if extra:
 93:         entry.update(extra)
 94: 
 95:     # Write to audit log file (always utf-8)
 96:     with open(AUDIT_LOG_PATH, "a", encoding="utf-8") as f:
 97:         f.write(json.dumps(entry) + "\n")
 98: 
 99:     # Print to console with colors (using ASCII -> arrow)
100:     dest_str = f" -> {destination}" if destination else ""
101:     msg = f"{event_type:10} | {os.path.basename(source)}{dest_str} | {integrity_status}"
102:     _console_print(alert_level, msg)
103: 
104: 
105: def load_logs(limit: int = None, level_filter: str = None, keyword: str = None) -> list[dict]:
106:     """
107:     Read and parse audit.log entries with optional filtering.
108: 
109:     Args:
110:         limit:        Maximum number of recent entries to return. None = all.
111:         level_filter: Filter by alert level string ('INFO', 'WARNING', 'CRITICAL').
112:         keyword:      Filter entries where keyword appears in source or destination.
113: 
114:     Returns:
115:         List of log entry dicts, most recent last.
116:     """
117:     if not os.path.exists(AUDIT_LOG_PATH):
118:         return []
119: 
120:     entries = []
121:     with open(AUDIT_LOG_PATH, "r", encoding="utf-8") as f:
122:         for line in f:
123:             line = line.strip()
124:             if not line:
125:                 continue
126:             try:
127:                 entry = json.loads(line)
128:                 # Apply filters
129:                 if level_filter and entry.get("alert_level") != level_filter:
130:                     continue
131:                 if keyword:
132:                     kw = keyword.lower()
133:                     if kw not in entry.get("source", "").lower() \
134:                        and kw not in entry.get("destination", "").lower() \
135:                        and kw not in entry.get("event_type", "").lower():
136:                         continue
137:                 entries.append(entry)
138:             except json.JSONDecodeError:
139:                 continue
140: 
141:     if limit:
142:         entries = entries[-limit:]
143:     return entries
144: 
145: 
146: def get_stats() -> dict:
147:     """Return summary statistics from the audit log."""
148:     entries = load_logs()
149:     stats = {
150:         "total":              len(entries),
151:         "info":               sum(1 for e in entries if e.get("alert_level") == "INFO"),
152:         "warning":            sum(1 for e in entries if e.get("alert_level") == "WARNING"),
153:         "critical":           sum(1 for e in entries if e.get("alert_level") == "CRITICAL"),
154:         "integrity_tampered": sum(1 for e in entries if e.get("integrity_status") == "TAMPERED"),
155:         "integrity_ok":       sum(1 for e in entries if e.get("integrity_status") == "INTACT"),
156:     }
157:     return stats
158: 
159: 
160: def print_banner():
161:     """Print styled startup banner to the console safely across Windows terminals."""
162:     line = "=" * 62
163:     banner = f"""
164: {Fore.CYAN}+{line}+
165: |       SECURE FILE TRANSFER MONITORING SYSTEM                 |
166: |       Blue Team DLP & Integrity Checker  |  v1.0             |
167: +{line}+{Style.RESET_ALL}
168: """
169:     try:
170:         print(banner)
171:     except UnicodeEncodeError:
172:         print(banner.encode("ascii", errors="replace").decode("ascii"))
