229: .filter-select {
230:   background: var(--bg-card);
231:   border: 1px solid var(--border);
232:   border-radius: var(--radius);
233:   color: var(--text-primary);
234:   padding: 8px 12px;
235:   font-size: 13px;
236:   outline: none;
237:   cursor: pointer;
238:   min-width: 130px;
239:   transition: border-color 0.2s;
240: }
241: .filter-select:focus { border-color: var(--accent); }
242: 
243: .btn-refresh {
244:   background: var(--accent);
245:   color: #000;
246:   border: none;
247:   border-radius: var(--radius);
248:   padding: 8px 16px;
249:   font-size: 13px;
250:   font-weight: 600;
251:   cursor: pointer;
252:   transition: opacity 0.15s, transform 0.1s;
253: }
254: .btn-refresh:hover  { opacity: 0.85; transform: scale(1.02); }
255: .btn-refresh:active { transform: scale(0.98); }
256: 
257: /* ── Log Table Section ───────────────────────────────────────────────────── */
258: .table-section {
259:   background: var(--bg-card);
260:   border: 1px solid var(--border-subtle);
261:   border-radius: var(--radius-lg);
262:   overflow: hidden;
263:   display: flex;
264:   flex-direction: column;
265:   min-height: 300px;
266: }
267: .table-header-row {
268:   display: flex;
269:   justify-content: space-between;
270:   align-items: center;
271:   padding: 12px 18px;
272:   background: var(--bg-elevated);
273:   border-bottom: 1px solid var(--border);
274: }
275: .table-title { font-weight: 600; font-size: 14px; margin-right: 10px; }
276: .table-tip   { font-size: 11px; color: var(--accent); opacity: 0.9; }
277: .table-meta  { font-size: 12px; color: var(--text-muted); }
278: 
279: .table-wrapper { overflow-x: auto; flex: 1; }
280: .table-wrapper::-webkit-scrollbar { height: 4px; }
281: .table-wrapper::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
282: 
283: table {
284:   width: 100%;
285:   border-collapse: collapse;
286:   font-size: 12.5px;
287: }
288: thead tr { background: var(--bg-base); }
289: th {
290:   text-align: left;
291:   padding: 10px 14px;
292:   font-size: 11px;
293:   font-weight: 600;
294:   text-transform: uppercase;
295:   letter-spacing: 0.5px;
296:   color: var(--text-muted);
297:   border-bottom: 1px solid var(--border);
298:   white-space: nowrap;
299: }
300: td {
301:   padding: 9px 14px;
302:   border-bottom: 1px solid var(--border-subtle);
303:   vertical-align: middle;
304:   max-width: 250px;
305:   overflow: hidden;
306:   text-overflow: ellipsis;
307:   white-space: nowrap;
308: }
309: tbody tr {
310:   cursor: pointer;
311:   transition: background 0.15s, border-left 0.15s;
312: }
313: tbody tr:hover {
314:   background: var(--bg-hover) !important;
315: }
316: tbody tr.selected-row {
317:   background: rgba(88, 166, 255, 0.12) !important;
318:   border-left: 3px solid var(--accent);
319: }
320: tbody tr:last-child td { border-bottom: none; }
321: 
322: .empty-row { text-align: center; color: var(--text-muted); padding: 40px; cursor: default; }
323: 
324: /* ── Inline Badges ───────────────────────────────────────────────────────── */
325: .badge-level {
326:   display: inline-block;
327:   font-size: 10px;
328:   font-weight: 700;
329:   letter-spacing: 0.5px;
330:   padding: 2px 8px;
331:   border-radius: 20px;
332:   text-transform: uppercase;
333: }
334: .badge-level.info     { background: var(--info-bg);  color: var(--info-color);  border: 1px solid var(--info-color);  }
335: .badge-level.warning  { background: var(--warn-bg);  color: var(--warn-color);  border: 1px solid var(--warn-color);  }
336: .badge-level.critical { background: var(--crit-bg);  color: var(--crit-color);  border: 1px solid var(--crit-color);  }
337: 
338: .integrity-badge {
339:   display: inline-block;
340:   font-size: 10px;
341:   font-weight: 600;
342:   padding: 2px 8px;
343:   border-radius: 20px;
344: }
345: .integrity-badge.intact      { background: var(--ok-bg);   color: var(--ok-color);   border: 1px solid var(--ok-color);   }
346: .integrity-badge.tampered    { background: var(--crit-bg); color: var(--crit-color); border: 1px solid var(--crit-color); }
347: .integrity-badge.unavailable { background: var(--bg-base); color: var(--text-muted); border: 1px solid var(--border);     }
348: 
349: .event-type { font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); }
350: .mono  { font-family: var(--font-mono); }
351: .hash  { font-size: 11px; color: var(--text-muted); }
352: .ts    { font-size: 11px; color: var(--text-muted); }
353: .path  { color: var(--text-primary); }
354: 
355: /* ── Pagination ──────────────────────────────────────────────────────────── */
356: .pagination {
357:   display: flex;
358:   justify-content: center;
359:   align-items: center;
360:   gap: 10px;
361:   padding: 12px;
362:   border-top: 1px solid var(--border-subtle);
363: }
364: .pagination button {
365:   background: var(--bg-elevated);
366:   border: 1px solid var(--border);
367:   color: var(--text-primary);
368:   padding: 5px 14px;
369:   border-radius: var(--radius);
370:   cursor: pointer;
371:   font-size: 12px;
372:   transition: border-color 0.15s, background 0.15s;
373: }
374: .pagination button:hover { background: var(--bg-hover); border-color: var(--accent); }
375: .page-info { font-size: 12px; color: var(--text-muted); }
376: 
377: /* ═══════════════════════════════════════════════════════════════════════════
378:    VERTICAL REPORT DRAWER — CHAT BLOCK FORM
379:    ═══════════════════════════════════════════════════════════════════════════ */
380: .report-drawer {
381:   background: var(--bg-elevated);
382:   border-left: 1px solid var(--border);
383:   display: flex;
384:   flex-direction: column;
385:   height: 100%;
386:   overflow: hidden;
387:   box-shadow: -4px 0 24px rgba(0, 0, 0, 0.4);
388: }
389: 
390: .drawer-header {
391:   display: flex;
392:   justify-content: space-between;
393:   align-items: center;
394:   padding: 14px 18px;
395:   background: var(--bg-card);
396:   border-bottom: 1px solid var(--border);
397: }
398: .drawer-title-box { display: flex; align-items: center; gap: 10px; }
399: .drawer-icon  { font-size: 20px; }
400: .drawer-title { font-weight: 700; font-size: 14px; color: var(--text-primary); }
401: .drawer-sub   { font-size: 11px; color: var(--text-muted); font-family: var(--font-mono); max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
402: 
403: .btn-close-drawer {
404:   background: transparent;
405:   border: 1px solid var(--border);
406:   color: var(--text-secondary);
407:   border-radius: 50%;
408:   width: 28px;
409:   height: 28px;
410:   cursor: pointer;
411:   display: flex;
412:   align-items: center;
413:   justify-content: center;
414:   font-size: 12px;
415:   transition: background 0.15s, color 0.15s;
416: }
417: .btn-close-drawer:hover { background: var(--bg-hover); color: var(--text-primary); }
418: 
419: /* Chat Stream Container */
420: .chat-stream {
421:   flex: 1;
422:   overflow-y: auto;
423:   padding: 16px;
424:   display: flex;
425:   flex-direction: column;
426:   gap: 14px;
427: }
428: .chat-stream::-webkit-scrollbar { width: 4px; }
429: .chat-stream::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
430: 
431: /* Empty / Placeholder State */
432: .chat-placeholder {
433:   display: flex;
434:   flex-direction: column;
435:   align-items: center;
436:   justify-content: center;
437:   text-align: center;
438:   height: 100%;
439:   padding: 40px 24px;
440:   color: var(--text-muted);
441: }
442: .placeholder-icon  { font-size: 38px; margin-bottom: 12px; opacity: 0.6; }
443: .placeholder-title { font-size: 14px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; }
444: .placeholder-desc  { font-size: 12px; line-height: 1.6; }
445: 
446: /* Individual Chat Block */
447: .chat-block {
448:   display: flex;
449:   gap: 12px;
450:   animation: slideFadeIn 0.25s ease-out;
451: }
452: 
453: @keyframes slideFadeIn {
454:   from { opacity: 0; transform: translateY(6px); }
455:   to   { opacity: 1; transform: translateY(0); }
456: }
457: 
458: .chat-avatar {
459:   width: 34px;
460:   height: 34px;
461:   border-radius: 8px;
462:   background: var(--bg-card);
463:   border: 1px solid var(--border);
464:   display: flex;
465:   align-items: center;
466:   justify-content: center;
467:   font-size: 17px;
468:   flex-shrink: 0;
469: }
470: .chat-avatar.critical { border-color: var(--crit-color); background: var(--crit-bg); }
471: .chat-avatar.warning  { border-color: var(--warn-color); background: var(--warn-bg); }
472: 
473: .chat-body {
474:   flex: 1;
475:   min-width: 0;
476: }
477: .chat-meta {
478:   display: flex;
479:   align-items: center;
480:   gap: 8px;
481:   margin-bottom: 4px;
482: }
483: .chat-sender {
484:   font-size: 11px;
485:   font-weight: 600;
486:   color: var(--text-secondary);
487: }
488: .chat-time, .chat-tag {
489:   font-size: 10px;
490:   color: var(--text-muted);
491:   font-family: var(--font-mono);
492: }
493: 
494: /* Chat Speech Bubbles */
495: .chat-bubble {
496:   background: var(--bg-card);
497:   border: 1px solid var(--border-subtle);
498:   border-radius: 10px;
499:   padding: 12px 14px;
500:   font-size: 12.5px;
501:   line-height: 1.5;
502:   box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
503: }
504: .chat-bubble.critical { border-left: 3px solid var(--crit-color); }
505: .chat-bubble.warning  { border-left: 3px solid var(--warn-color); }
506: .chat-bubble.info     { border-left: 3px solid var(--info-color); }
507: 
508: .bubble-headline {
509:   display: flex;
510:   align-items: center;
511:   gap: 8px;
512:   margin-bottom: 8px;
513: }
514: .bubble-p { color: var(--text-primary); margin: 0; }
515: .bubble-p code {
516:   background: var(--bg-base);
517:   padding: 2px 6px;
518:   border-radius: 4px;
519:   color: var(--accent);
520:   font-family: var(--font-mono);
521:   font-size: 11.5px;
522: }
523: 
524: /* Key-Value Telemetry Grid */
525: .kv-grid {
526:   display: flex;
527:   flex-direction: column;
528:   gap: 8px;
529: }
530: .kv-item {
531:   display: flex;
532:   flex-direction: column;
533:   gap: 2px;
534: }
535: .kv-item.flex-row {
536:   flex-direction: row;
537:   justify-content: space-between;
538:   border-top: 1px solid var(--border-subtle);
539:   padding-top: 8px;
540:   margin-top: 2px;
541: }
542: .kv-label {
543:   font-size: 10.5px;
544:   font-weight: 600;
545:   color: var(--text-muted);
546:   text-transform: uppercase;
547:   letter-spacing: 0.4px;
548: }
549: .kv-val {
550:   font-size: 12px;
551:   color: var(--text-primary);
552: }
553: .break-all { word-break: break-all; }
554: .text-amber { color: #f2cc60 !important; }
555: .font-semibold { font-weight: 600; }
556: .font-medium { font-weight: 500; }
557: .mt-8 { margin-top: 8px; }
558: 
559: /* Hash Box in Integrity Bubble */
560: .hash-status-text {
561:   font-size: 11.5px;
562:   color: var(--text-secondary);
563: }
564: .hash-box {
565:   background: var(--bg-base);
566:   border: 1px solid var(--border-subtle);
567:   border-radius: var(--radius);
568:   padding: 8px 10px;
569:   margin-top: 8px;
570:   display: flex;
571:   flex-direction: column;
572:   gap: 6px;
573: }
574: .hash-line {
575:   display: flex;
576:   flex-direction: column;
577:   gap: 2px;
578: }
579: .hash-label {
580:   font-size: 10px;
581:   font-weight: 600;
582:   color: var(--text-muted);
583:   text-transform: uppercase;
584: }
585: .mono-code {
586:   font-family: var(--font-mono);
587:   font-size: 11px;
588:   color: var(--text-secondary);
589:   word-break: break-all;
590: }
591: 
592: /* Policy & Verdict Section */
593: .policy-section {
594:   display: flex;
595:   flex-direction: column;
596:   gap: 3px;
597: }
598: .sec-title {
599:   font-size: 10.5px;
600:   font-weight: 700;
601:   text-transform: uppercase;
602:   letter-spacing: 0.5px;
603:   color: var(--text-muted);
604: }
605: .sec-body {
606:   font-size: 12px;
607:   color: var(--text-primary);
608:   line-height: 1.45;
609: }
610: 
611: /* Action Footer */
612: .action-footer {
613:   display: flex;
614:   gap: 8px;
615:   margin-top: 4px;
616: }
617: .btn-action {
618:   flex: 1;
619:   background: var(--bg-card);
620:   border: 1px solid var(--border);
621:   color: var(--text-primary);
622:   padding: 8px 10px;
623:   border-radius: var(--radius);
624:   font-size: 11.5px;
625:   font-weight: 600;
626:   cursor: pointer;
627:   transition: background 0.15s, border-color 0.15s;
628: }
629: .btn-action:hover {
630:   background: var(--bg-hover);
