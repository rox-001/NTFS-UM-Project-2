 1: """
 2: dashboard/app.py - SPLUNK-style Local Web Dashboard
 3: Serves a real-time log viewer at http://localhost:5000
 4: 100% LOCAL — no internet, no external APIs, reads only from local log files.
 5: """
 6: 
 7: import sys
 8: import os
 9: 
10: # Allow imports from parent directory
11: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
12: 
13: from flask import Flask, render_template, jsonify, request
14: import logger
15: import alerter
16: from config import DASHBOARD_HOST, DASHBOARD_PORT, DASHBOARD_DEBUG, LOGS_PER_PAGE, RESOURCE_DIR
17: 
18: template_dir = os.path.join(RESOURCE_DIR, "dashboard", "templates")
19: static_dir   = os.path.join(RESOURCE_DIR, "dashboard", "static")
20: 
21: app = Flask(__name__, template_folder=template_dir, static_folder=static_dir)
22: 
23: 
24: @app.route("/")
25: def index():
26:     """Serve the main dashboard page."""
27:     return render_template("index.html")
28: 
29: 
30: @app.route("/api/logs")
31: def api_logs():
32:     """
33:     Return paginated, filterable, and sortable log entries as JSON.
34:     Query params:
35:       - level:     Filter by alert level (INFO / WARNING / CRITICAL)
36:       - keyword:   Search in source/destination/event_type/user
37:       - sort_by:   Field to sort by (timestamp, source, ext, level, integrity)
38:       - order:     Sort direction (asc / desc)
39:       - file_type: Filter by file category (documents, secrets, databases, scripts, archives)
40:       - directory: Filter by directory path substring
41:       - page:      Page number (1-indexed)
42:     """
43:     level     = request.args.get("level", "").upper() or None
44:     keyword   = request.args.get("keyword", "") or None
45:     sort_by   = request.args.get("sort_by", "timestamp")
46:     order     = request.args.get("order", "desc").lower()
47:     file_type = request.args.get("file_type", "") or None
48:     directory = request.args.get("directory", "") or None
49:     page      = max(1, int(request.args.get("page", 1)))
50: 
51:     entries = logger.load_logs(
52:         level_filter=level,
53:         keyword=keyword,
54:         sort_by=sort_by,
55:         order=order,
56:         file_type=file_type,
57:         directory=directory,
58:     )
59:     total = len(entries)
60:     start = (page - 1) * LOGS_PER_PAGE
61:     end   = start + LOGS_PER_PAGE
62:     page_entries = entries[start:end]
63: 
64:     return jsonify({
65:         "logs":        page_entries,
66:         "total":       total,
67:         "page":        page,
68:         "per_page":    LOGS_PER_PAGE,
69:         "total_pages": max(1, (total + LOGS_PER_PAGE - 1) // LOGS_PER_PAGE),
70:         "sort_by":     sort_by,
71:         "order":       order,
72:     })
73: 
74: 
75: @app.route("/api/stats")
76: def api_stats():
77:     """Return summary statistics."""
78:     return jsonify(logger.get_stats())
79: 
80: 
81: @app.route("/api/alerts")
82: def api_alerts():
83:     """Return the most recent alerts."""
84:     limit  = int(request.args.get("limit", 30))
85:     alerts = alerter.load_alerts(limit=limit)
86:     return jsonify(list(reversed(alerts)))  # Most recent first
87: 
88: 
89: def run_dashboard(host: str = DASHBOARD_HOST, port: int = DASHBOARD_PORT):
90:     """Start the Flask development server (blocking call)."""
91:     print(f"\n  Dashboard → http://{host}:{port}  (local only, no internet needed)")
92:     app.run(host=host, port=port, debug=DASHBOARD_DEBUG, use_reloader=False)
