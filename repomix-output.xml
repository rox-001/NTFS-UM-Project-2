106: def is_cloud_or_removable_location(path: str) -> bool:
107:     """
108:     Return True if the path is located on removable media (USB), network shares,
109:     or cloud-sync folders (OneDrive, Dropbox, Google Drive, iCloud, Box).
110:     """
111:     if not path:
112:         return False
113: 
114:     raw_path = path.strip()
115:     norm = os.path.normpath(raw_path)
116: 
117:     # 1. UNC network paths: \\server\share or //server/share
118:     if raw_path.startswith("\\\\") or raw_path.startswith("//") or norm.startswith(r"\\"):
119:         return True
120: 
121:     # 2. Windows drive type check (Removable media / Network drives)
122:     if sys.platform == "win32" and len(norm) >= 2 and norm[1] == ":":
123:         drive_letter = norm[:2].upper() + "\\"
124:         dtype = _get_drive_type_windows(drive_letter)
125:         # 2 = DRIVE_REMOVABLE, 4 = DRIVE_REMOTE, 5 = DRIVE_CDROM
126:         if dtype in (2, 4, 5):
127:             return True
128:         elif dtype == 3:
129:             # Internal disk
130:             pass
131:         else:
132:             if drive_letter in [d.upper() for d in SUSPICIOUS_DRIVE_LETTERS]:
133:                 return True
134:     elif sys.platform != "win32":
135:         norm_lower = norm.lower()
136:         if any(norm_lower.startswith(p) for p in ("/media/", "/mnt/", "/volumes/")):
137:             return True
138:         drive_letter = norm[:3].upper() if len(norm) >= 3 and norm[1:3] == ":\\" else ""
139:         if drive_letter and drive_letter in [d.upper() for d in SUSPICIOUS_DRIVE_LETTERS]:
140:             return True
141: 
142:     # 3. Path component analysis for directory path (excluding filename)
143:     dir_path = os.path.dirname(norm)
144:     if dir_path:
145:         parts = [p.lower() for p in dir_path.replace("/", "\\").split("\\") if p]
146:         for part in parts:
147:             if any(part == ck or part.startswith(ck + " ") or part.startswith(ck + "-") for ck in _CLOUD_KEYWORDS):
148:                 return True
149: 
150:     return False
