161: def add_to_allowlist(entry: str, entry_type: str = "path", reason: str = "") -> bool:
162:     if not entry:
163:         return False
164:     norm = os.path.normcase(os.path.normpath(entry)) if entry_type == "path" else entry.strip().lower()
165:     with _db_lock, _get_connection() as conn:
166:         conn.execute("""
167:             INSERT INTO allowlist (entry, entry_type, reason, added_at)
168:             VALUES (?, ?, ?, ?)
