153: def is_suspicious_destination(path: str) -> bool:
154:     """
155:     Return True if the destination path represents an exfiltration vector:
156:       - Removable media (USB drives)
157:       - Network shares (UNC paths \\\\server\\share or //server/share)
158:       - Cloud synchronization folders (OneDrive, Dropbox, Google Drive, iCloud)
159:       - Recycle bin staging
160:       - System or user Temp staging locations
161: 
162:     Uses whole-path-component matching to avoid false positives (e.g. 'Templates' or 'attempt2.txt').
163:     """
164:     if not path:
165:         return False
166: 
167:     # Check cloud, network, and removable media
168:     if is_cloud_or_removable_location(path):
169:         return True
170: 
171:     norm = os.path.normpath(path.strip())
172:     dir_path = os.path.dirname(norm)
173:     if dir_path:
174:         parts = [p.lower() for p in dir_path.replace("/", "\\").split("\\") if p]
175: 
176:         # Check recycle bin components
177:         if any(part in _RECYCLER_KEYWORDS for part in parts):
178:             return True
179: 
180:         # Check temp directory components:
181:         # Must match actual system temp directory path OR be an exact folder named 'temp' or 'tmp'
182:         norm_case_dir = os.path.normcase(os.path.abspath(dir_path))
183:         for sys_temp in _SYSTEM_TEMP_DIRS:
184:             if norm_case_dir == sys_temp or norm_case_dir.startswith(sys_temp.rstrip(os.sep) + os.sep):
185:                 return True
186: 
187:         if any(part in {"temp", "tmp"} for part in parts):
188:             return True
189: 
190:     return False
