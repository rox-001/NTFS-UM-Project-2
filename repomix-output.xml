 86:             VALUES (?, ?, ?, ?, ?)
 87:             ON CONFLICT(norm_path) DO UPDATE SET
 88:                 hash = excluded.hash,
 89:                 size = excluded.size,
 90:                 mtime = excluded.mtime,
 91:                 updated_at = excluded.updated_at
 92:         """, (norm, digest, size, mtime, now))
 93:         conn.commit()
