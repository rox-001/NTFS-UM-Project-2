 26: class TestDiffTracker(unittest.TestCase):
 27:     """Test Requirement 1: Exact line-by-line diff tracking for modified operations."""
 28: 
 29:     def setUp(self):
 30:         self.tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".txt", mode="w", encoding="utf-8")
 31:         self.tmp.write("line 1\nline 2\nline 3\n")
 32:         self.tmp.close()
 33:         self.filepath = self.tmp.name
 34:         diff_tracker.record_initial_state(self.filepath)
 35: 
 36:     def tearDown(self):
 37:         try:
 38:             os.unlink(self.filepath)
 39:         except OSError:
 40:             pass
 41: 
 42:     def test_text_file_modification_diff(self):
 43:         """Modifying lines in a text file produces a structured unified diff."""
 44:         # Append and modify
 45:         with open(self.filepath, "w", encoding="utf-8") as f:
 46:             f.write("line 1\nline 2 MODIFIED\nline 3\nline 4 NEW\n")
 47: 
 48:         diff = diff_tracker.compute_file_diff("MODIFIED", self.filepath)
 49:         self.assertEqual(diff["type"], "text")
 50:         self.assertGreater(diff["added_count"], 0)
 51:         self.assertIn("+", diff["snippet"])
 52:         self.assertIn("line 4 NEW", diff["snippet"])
 53:         self.assertIn("added", diff["summary"])
 54: 
 55:     def test_binary_file_modification_delta(self):
 56:         """Binary files report byte delta size changes rather than text diffs."""
 57:         bin_tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".docx", mode="wb")
 58:         bin_tmp.write(b"PK\x03\x04InitialBinaryDocxBytes" * 10)
 59:         bin_tmp.close()
 60:         diff_tracker.record_initial_state(bin_tmp.name)
 61: 
 62:         # Expand binary size
 63:         with open(bin_tmp.name, "ab") as f:
 64:             f.write(b"ExtraAppendedBinaryDataBytes" * 5)
 65: 
 66:         diff = diff_tracker.compute_file_diff("MODIFIED", bin_tmp.name)
 67:         os.unlink(bin_tmp.name)
 68: 
 69:         self.assertEqual(diff["type"], "binary")
 70:         self.assertGreater(diff["size_delta"], 0)
 71:         self.assertIn("Binary content modified", diff["summary"])
