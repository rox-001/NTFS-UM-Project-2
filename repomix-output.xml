 814:   function formatBytes(bytes) {
 815:     if (!bytes || bytes === 0) return "0 B";
 816:     const k = 1024;
 817:     const sizes = ["B", "KB", "MB", "GB"];
 818:     const i = Math.floor(Math.log(bytes) / Math.log(k));
 819:     return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
 820:   }
