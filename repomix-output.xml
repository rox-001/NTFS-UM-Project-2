266: def restore_quarantined_file(record_id: int) -> dict:
267:     """Safely restore a quarantined file back to its original location."""
268:     with _db_lock, _get_connection() as conn:
269:         row = conn.execute("SELECT * FROM quarantine_vault WHERE id = ?", (record_id,)).fetchone()
270:         if not row:
271:             return {"success": False, "error": f"Quarantine record ID {record_id} not found."}
272: 
273:         orig_path = row["original_path"]
274:         vault_path = row["quarantined_path"]
275: 
276:         if not os.path.exists(vault_path):
277:             return {"success": False, "error": f"Quarantined file missing from vault: '{vault_path}'"}
278: 
279:         try:
280:             # Re-enable write permissions
281:             try:
282:                 os.chmod(vault_path, 0o666)
283:             except OSError:
284:                 pass
285: 
286:             os.makedirs(os.path.dirname(orig_path), exist_ok=True)
287:             shutil.move(vault_path, orig_path)
288: 
289:             conn.execute("DELETE FROM quarantine_vault WHERE id = ?", (record_id,))
290:             conn.commit()
291: 
292:             return {
293:                 "success": True,
294:                 "original_path": orig_path,
295:                 "message": f"Successfully restored '{os.path.basename(orig_path)}' to its original location."
296:             }
297:         except Exception as e:
298:             return {"success": False, "error": str(e)}
