<file path="dashboard/templates/index.html">
  1: <!DOCTYPE html>
  2: <html lang="en">
  3: <head>
  4:   <meta charset="UTF-8" />
  5:   <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  6:   <title>FileSentinel DLP — File Transfer Dashboard</title>
  7:   <link rel="preconnect" href="https://fonts.googleapis.com">
  8:   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  9:   <link rel="stylesheet" href="/static/style.css"/>
 10: </head>
 11: <body>
 12: 
 13: <!-- ═══════════════════════════════ TOP NAV ═══════════════════════════════ -->
 14: <header class="top-bar">
 15:   <div class="top-bar-inner">
 16:     <div class="logo-area">
 17:       <span class="logo-icon">🛡</span>
 18:       <span class="logo-text">FileSentinel DLP</span>
 19:       <span class="logo-sub">Security Operations</span>
 20:     </div>
 21:     <div class="status-area">
 22:       <span class="status-dot" id="statusDot"></span>
 23:       <span class="status-label" id="statusLabel">Connecting…</span>
 24:       <span class="refresh-label">Auto-refresh: 5s</span>
 25:     </div>
 26:   </div>
 27: </header>
 28: 
 29: <!-- ═══════════════════════════════ MAIN LAYOUT ═══════════════════════════ -->
 30: <div class="layout" id="mainLayout">
 31: 
 32:   <!-- ─── LEFT SIDEBAR: Alerts ─── -->
 33:   <aside class="sidebar">
 34:     <div class="sidebar-header">
 35:       <span>🚨 Live Alerts</span>
 36:       <span class="badge" id="alertCount">0</span>
 37:     </div>
 38:     <div class="alert-feed" id="alertFeed">
 39:       <div class="alert-empty">No alerts yet.</div>
 40:     </div>
 41:   </aside>
 42: 
 43:   <!-- ─── MAIN CONTENT ─── -->
 44:   <main class="main-content">
 45: 
 46:     <!-- Stats Cards -->
 47:     <section class="stats-row">
 48:       <div class="stat-card total">
 49:         <div class="stat-icon">📋</div>
 50:         <div class="stat-body">
 51:           <div class="stat-value" id="statTotal">0</div>
 52:           <div class="stat-label">Total Events</div>
 53:         </div>
 54:       </div>
 55:       <div class="stat-card info">
 56:         <div class="stat-icon">ℹ</div>
 57:         <div class="stat-body">
 58:           <div class="stat-value" id="statInfo">0</div>
 59:           <div class="stat-label">INFO</div>
 60:         </div>
 61:       </div>
 62:       <div class="stat-card warning">
 63:         <div class="stat-icon">⚠</div>
 64:         <div class="stat-body">
 65:           <div class="stat-value" id="statWarning">0</div>
 66:           <div class="stat-label">WARNINGS</div>
 67:         </div>
 68:       </div>
 69:       <div class="stat-card critical">
 70:         <div class="stat-icon">🔴</div>
 71:         <div class="stat-body">
 72:           <div class="stat-value" id="statCritical">0</div>
 73:           <div class="stat-label">CRITICAL</div>
 74:         </div>
 75:       </div>
 76:       <div class="stat-card tampered">
 77:         <div class="stat-icon">🔐</div>
 78:         <div class="stat-body">
 79:           <div class="stat-value" id="statTampered">0</div>
 80:           <div class="stat-label">Tampered</div>
 81:         </div>
 82:       </div>
 83:     </section>
 84: 
 85:     <!-- Filter Bar -->
 86:     <section class="filter-bar">
 87:       <input type="text"  id="searchInput"  class="filter-input" placeholder="🔍  Search source, destination, event type…" />
 88:       <select id="levelFilter" class="filter-select">
 89:         <option value="">All Levels</option>
 90:         <option value="INFO">INFO</option>
 91:         <option value="WARNING">WARNING</option>
 92:         <option value="CRITICAL">CRITICAL</option>
 93:       </select>
 94:       <button class="btn-refresh" id="btnRefresh" onclick="fetchAll()">↺ Refresh</button>
 95:     </section>
 96: 
 97:     <!-- Log Table -->
 98:     <section class="table-section">
 99:       <div class="table-header-row">
100:         <div>
101:           <span class="table-title">Event Log</span>
102:           <span class="table-tip">💡 Click any row to view security incident report in chat format</span>
103:         </div>
104:         <span class="table-meta" id="tableMeta">Loading…</span>
105:       </div>
106:       <div class="table-wrapper">
107:         <table id="logTable">
108:           <thead>
109:             <tr>
110:               <th>Timestamp</th>
111:               <th>Level</th>
112:               <th>Event</th>
113:               <th>Source</th>
114:               <th>Destination</th>
115:               <th>User</th>
116:               <th>Hash Pre</th>
117:               <th>Hash Post</th>
118:               <th>Integrity</th>
119:             </tr>
120:           </thead>
121:           <tbody id="logBody">
122:             <tr><td colspan="9" class="empty-row">No events yet. Start monitoring to see data.</td></tr>
123:           </tbody>
124:         </table>
125:       </div>
126: 
127:       <!-- Pagination -->
128:       <div class="pagination" id="pagination"></div>
129:     </section>
130: 
131:   </main>
132: 
133:   <!-- ─── RIGHT VERTICAL REPORT DRAWER: Chat Block Form ─── -->
134:   <aside class="report-drawer" id="reportDrawer">
135:     <div class="drawer-header">
136:       <div class="drawer-title-box">
137:         <span class="drawer-icon">💬</span>
138:         <div>
139:           <div class="drawer-title">Security Incident Report</div>
140:           <div class="drawer-sub" id="drawerSub">Click any log row on the left</div>
141:         </div>
142:       </div>
143:       <button class="btn-close-drawer" onclick="closeDrawer()" title="Close Report">✕</button>
144:     </div>
145: 
146:     <!-- Scrollable Chat Stream -->
147:     <div class="chat-stream" id="chatStream">
148:       <div class="chat-placeholder">
149:         <div class="placeholder-icon">🔍</div>
150:         <div class="placeholder-title">No Event Selected</div>
151:         <div class="placeholder-desc">Click on any file transfer log row to see the full vertical security report breakdown in interactive chat blocks.</div>
152:       </div>
153:     </div>
154:   </aside>
155: 
156: </div>
157: 
158: <!-- ═════════════════════════════ JAVASCRIPT ══════════════════════════════ -->
159: <script>
160:   let currentPage     = 1;
161:   let refreshTimer    = null;
162:   let isConnected     = false;
163:   let currentLogs     = [];
164:   let selectedEventId = null;
165: 
166:   // ── Fetch everything ────────────────────────────────────────────────────
167:   async function fetchAll() {
168:     await Promise.all([fetchStats(), fetchLogs(), fetchAlerts()]);
169:   }
170: 
171:   // ── Stats ────────────────────────────────────────────────────────────────
172:   async function fetchStats() {
173:     try {
174:       const res  = await fetch("/api/stats");
175:       const data = await res.json();
176:       document.getElementById("statTotal").textContent    = data.total    ?? 0;
177:       document.getElementById("statInfo").textContent     = data.info     ?? 0;
178:       document.getElementById("statWarning").textContent  = data.warning  ?? 0;
179:       document.getElementById("statCritical").textContent = data.critical  ?? 0;
180:       document.getElementById("statTampered").textContent = data.integrity_tampered ?? 0;
181:       setConnected(true);
182:     } catch (e) {
183:       setConnected(false);
184:     }
185:   }
186: 
187:   // ── Logs ─────────────────────────────────────────────────────────────────
188:   async function fetchLogs(page = currentPage) {
189:     const level   = document.getElementById("levelFilter").value;
190:     const keyword = document.getElementById("searchInput").value.trim();
191:     let url = `/api/logs?page=${page}`;
192:     if (level)   url += `&level=${encodeURIComponent(level)}`;
193:     if (keyword) url += `&keyword=${encodeURIComponent(keyword)}`;
194: 
195:     try {
