112: 
113:     <!-- Log Table -->
114:     <section class="table-section">
115:       <div class="table-header-row">
116:         <div>
117:           <span class="table-title">Event Log</span>
118:           <span class="table-tip">💡 Click any row to view security incident report in chat format</span>
119:         </div>
120:         <span class="table-meta" id="tableMeta">Loading…</span>
121:       </div>
122:       <div class="table-wrapper">
123:         <table id="logTable">
124:           <thead>
125:             <tr>
126:               <th onclick="toggleSort('timestamp')" class="sortable-th">Timestamp <span class="sort-icon" id="th-timestamp">▼</span></th>
127:               <th onclick="toggleSort('level')" class="sortable-th">Level <span class="sort-icon" id="th-level"></span></th>
128:               <th onclick="toggleSort('event_type')" class="sortable-th">Event <span class="sort-icon" id="th-event_type"></span></th>
129:               <th onclick="toggleSort('source')" class="sortable-th">Source <span class="sort-icon" id="th-source"></span></th>
130:               <th onclick="toggleSort('destination')" class="sortable-th">Destination <span class="sort-icon" id="th-destination"></span></th>
131:               <th>User</th>
132:               <th>Hash Pre</th>
133:               <th>Hash Post</th>
134:               <th onclick="toggleSort('integrity')" class="sortable-th">Integrity <span class="sort-icon" id="th-integrity"></span></th>
135:             </tr>
136:           </thead>
137:           <tbody id="logBody">
138:             <tr><td colspan="9" class="empty-row">No events yet. Start monitoring to see data.</td></tr>
139:           </tbody>
140:         </table>
141:       </div>
142: 
143:       <!-- Pagination -->
144:       <div class="pagination" id="pagination"></div>
145:     </section>
146: 
147:   </main>
148: 
149:   <!-- ─── RIGHT VERTICAL REPORT DRAWER: Chat Block Form ─── -->
150:   <aside class="report-drawer" id="reportDrawer">
151:     <div class="drawer-header">
152:       <div class="drawer-title-box">
153:         <span class="drawer-icon">💬</span>
154:         <div>
155:           <div class="drawer-title">Security Incident Report</div>
156:           <div class="drawer-sub" id="drawerSub">Click any log row on the left</div>
157:         </div>
158:       </div>
159:       <button class="btn-close-drawer" onclick="closeDrawer()" title="Close Report">✕</button>
160:     </div>
161: 
162:     <!-- Scrollable Chat Stream -->
163:     <div class="chat-stream" id="chatStream">
164:       <div class="chat-placeholder">
165:         <div class="placeholder-icon">🔍</div>
166:         <div class="placeholder-title">No Event Selected</div>
167:         <div class="placeholder-desc">Click on any file transfer log row to see the full vertical security report breakdown in interactive chat blocks.</div>
168:       </div>
169:     </div>
170:   </aside>
171: 
172: </div>
173: 
174: <!-- ═════════════════════════════ JAVASCRIPT ══════════════════════════════ -->
175: <script>
176:   let currentPage     = 1;
177:   let refreshTimer    = null;
178:   let isConnected     = false;
179:   let currentLogs     = [];
180:   let currentAlerts   = [];
181:   let selectedEventId = null;
182:   let currentSortBy   = "timestamp";
183:   let currentOrder    = "desc";
184: 
185:   // ── Fetch everything ────────────────────────────────────────────────────
186:   async function fetchAll() {
187:     await Promise.all([fetchStats(), fetchLogs(), fetchAlerts()]);
188:   }
189: 
190:   // ── Stats ────────────────────────────────────────────────────────────────
191:   async function fetchStats() {
192:     try {
193:       const res  = await fetch("/api/stats");
194:       const data = await res.json();
195:       document.getElementById("statTotal").textContent    = data.total    ?? 0;
196:       document.getElementById("statInfo").textContent     = data.info     ?? 0;
197:       document.getElementById("statWarning").textContent  = data.warning  ?? 0;
198:       document.getElementById("statCritical").textContent = data.critical  ?? 0;
199:       document.getElementById("statTampered").textContent = data.integrity_tampered ?? 0;
200:       setConnected(true);
201:     } catch (e) {
202:       setConnected(false);
203:     }
204:   }
205: 
206:   // ── Sorting Handlers ─────────────────────────────────────────────────────
207:   function toggleSort(col) {
208:     if (currentSortBy === col) {
209:       currentOrder = currentOrder === "asc" ? "desc" : "asc";
210:     } else {
211:       currentSortBy = col;
212:       currentOrder = (col === "level" || col === "timestamp") ? "desc" : "asc";
213:     }
214:     const matchVal = `${currentSortBy}_${currentOrder}`;
215:     const sortSelect = document.getElementById("sortSelect");
216:     if (sortSelect && sortSelect.querySelector(`option[value="${matchVal}"]`)) {
217:       sortSelect.value = matchVal;
218:     }
219:     updateSortHeaderIcons();
220:     fetchLogs(1);
221:   }
222: 
223:   function onSortSelectChange() {
224:     const val = document.getElementById("sortSelect").value;
225:     const parts = val.split("_");
226:     currentSortBy = parts[0];
227:     currentOrder = parts[1] || "desc";
228:     updateSortHeaderIcons();
229:     fetchLogs(1);
230:   }
231: 
232:   function updateSortHeaderIcons() {
233:     document.querySelectorAll(".sort-icon").forEach(el => el.textContent = "");
234:     const activeIcon = document.getElementById(`th-${currentSortBy}`);
235:     if (activeIcon) {
236:       activeIcon.textContent = currentOrder === "asc" ? " ▲" : " ▼";
237:     }
238:   }
239: 
240:   // ── Logs ─────────────────────────────────────────────────────────────────
241:   async function fetchLogs(page = currentPage) {
242:     const level    = document.getElementById("levelFilter").value;
243:     const fileType = document.getElementById("fileTypeFilter").value;
244:     const keyword  = document.getElementById("searchInput").value.trim();
245:     let url = `/api/logs?page=${page}&sort_by=${encodeURIComponent(currentSortBy)}&order=${encodeURIComponent(currentOrder)}`;
246:     if (level)    url += `&level=${encodeURIComponent(level)}`;
247:     if (fileType) url += `&file_type=${encodeURIComponent(fileType)}`;
248:     if (keyword)  url += `&keyword=${encodeURIComponent(keyword)}`;
249: 
250:     try {
251:       const res  = await fetch(url);
252:       const data = await res.json();
253:       currentLogs = data.logs || [];
254:       renderLogs(currentLogs);
255:       renderPagination(data.page, data.total_pages, data.total);
256:       document.getElementById("tableMeta").textContent =
257:         `Showing ${currentLogs.length} of ${data.total} events`;
258:     } catch (e) {
259:       document.getElementById("tableMeta").textContent = "Could not load logs.";
260:     }
261:   }
262: 
263:   function renderLogs(logs) {
264:     const tbody = document.getElementById("logBody");
265:     if (!logs || logs.length === 0) {
266:       tbody.innerHTML = `<tr><td colspan="9" class="empty-row">No matching events.</td></tr>`;
267:       return;
268:     }
269:     tbody.innerHTML = logs.map((e, idx) => {
270:       const isSelected = selectedEventId === (e.timestamp + e.source);
271:       const selectedClass = isSelected ? "selected-row" : "";
272:       return `
273:         <tr class="row-${(e.alert_level||"INFO").toLowerCase()} ${selectedClass}"
274:             onclick="selectLogEvent(${idx}, this)"
275:             title="Click to inspect this security event in chat format">
276:           <td class="mono ts">${(e.timestamp||"").slice(0,19).replace("T"," ")}</td>
277:           <td><span class="badge-level ${(e.alert_level||"INFO").toLowerCase()}">${e.alert_level||"—"}</span></td>
278:           <td><span class="event-type">${e.event_type||"—"}</span></td>
279:           <td class="mono path" title="${e.source||""}">${truncate(e.source||"", 35)}</td>
280:           <td class="mono path" title="${e.destination||""}">${truncate(e.destination||"—", 25)}</td>
281:           <td>${e.user||"—"}</td>
282:           <td class="mono hash" title="${e.hash_pre||""}">${shortHash(e.hash_pre)}</td>
283:           <td class="mono hash" title="${e.hash_post||""}">${shortHash(e.hash_post)}</td>
284:           <td><span class="integrity-badge ${(e.integrity_status||"").toLowerCase()}">${e.integrity_status||"—"}</span></td>
285:         </tr>
286:       `;
287:     }).join("");
288:   }
289: 
290:   // ── Vertical Chat Report Selection ────────────────────────────────────────
291:   function selectLogEvent(index, rowEl) {
292:     const event = currentLogs[index];
293:     if (!event) return;
294: 
295:     selectedEventId = (event.timestamp + event.source);
296: 
297:     // Update row highlights
298:     document.querySelectorAll("#logTable tbody tr").forEach(tr => tr.classList.remove("selected-row"));
299:     if (rowEl) rowEl.classList.add("selected-row");
300: 
301:     // Open drawer
302:     const layout = document.getElementById("mainLayout");
303:     layout.classList.add("drawer-open");
304: 
305:     // Update subtitle
306:     const fileName = getBasename(event.source);
307:     document.getElementById("drawerSub").textContent = `${event.event_type} • ${fileName}`;
308: 
309:     // Render Chat Blocks
310:     renderChatReport(event);
311:   }
312: 
313:   function closeDrawer() {
314:     document.getElementById("mainLayout").classList.remove("drawer-open");
315:     selectedEventId = null;
316:     document.querySelectorAll("#logTable tbody tr").forEach(tr => tr.classList.remove("selected-row"));
317:   }
318: 
319:   function renderFormattedDiff(snippet) {
320:     if (!snippet) return "";
321:     const lines = snippet.split("\n");
322:     return lines.map(line => {
323:       const escaped = escapeHtml(line);
324:       if (line.startsWith("+++") || line.startsWith("---") || line.startsWith("@@")) {
325:         return `<span class="diff-line-meta">${escaped}</span>`;
326:       } else if (line.startsWith("+")) {
327:         return `<span class="diff-line-add">${escaped}</span>`;
328:       } else if (line.startsWith("-")) {
329:         return `<span class="diff-line-del">${escaped}</span>`;
330:       }
331:       return `<span class="diff-line-ctx">${escaped}</span>`;
332:     }).join("\n");
333:   }
334: 
335:   function renderChatReport(e) {
336:     const stream = document.getElementById("chatStream");
337:     const level = (e.alert_level || "INFO").toUpperCase();
338:     const fileName = getBasename(e.source);
339:     const tsFormatted = (e.timestamp || "").replace("T", " ").slice(0, 19);
340: 
341:     // Dynamic advice and policy text
342:     let policyText = "";
343:     let recText = "";
344:     if (level === "CRITICAL") {
345:       policyText = "High-Risk Security Policy Triggered: Sensitive file moved or transferred to an unauthorized destination (e.g. external USB drive, cloud folder, or network UNC share).";
346:       recText = "🚨 Immediate Action Required: Verify user identity and confirm if transfer was authorized. Isolate destination storage or block exfiltration path.";
347:     } else if (level === "WARNING") {
348:       policyText = "Data Loss Prevention (DLP) Warning: Creation or modification of a restricted sensitive file type in a monitored directory.";
349:       recText = "⚠️ Monitoring Advisory: Verify user context and ensure sensitive file adheres to corporate retention policies.";
350:     } else {
351:       policyText = "Standard Operational Event: Normal file activity within monitored local parameters.";
352:       recText = "✅ Routine Logging: No further blue team action needed. Activity cataloged in audit ledger.";
353:     }
354: 
355:     const html = `
356:       <!-- Block 1: Incident Trigger (System Alert) -->
357:       <div class="chat-block bot-block">
358:         <div class="chat-avatar system-av ${level.toLowerCase()}">🤖</div>
359:         <div class="chat-body">
360:           <div class="chat-meta">
361:             <span class="chat-sender">FileSentinel Agent</span>
362:             <span class="chat-time">${tsFormatted}</span>
363:           </div>
364:           <div class="chat-bubble ${level.toLowerCase()}">
365:             <div class="bubble-headline">
366:               <span class="badge-level ${level.toLowerCase()}">${level}</span>
367:               <strong>${e.event_type} event detected</strong>
368:             </div>
369:             <p class="bubble-p">Filesystem monitor intercepted a file <strong>${e.event_type}</strong> operation for <code>${escapeHtml(fileName)}</code>.</p>
370:           </div>
371:         </div>
372:       </div>
373: 
374:       <!-- Block 2: File & Transfer Telemetry -->
375:       <div class="chat-block bot-block">
376:         <div class="chat-avatar file-av">📁</div>
377:         <div class="chat-body">
378:           <div class="chat-meta">
379:             <span class="chat-sender">Filesystem Telemetry</span>
380:             <span class="chat-tag">Transfer Details</span>
381:           </div>
382:           <div class="chat-bubble info-bubble">
383:             <div class="kv-grid">
384:               <div class="kv-item">
385:                 <span class="kv-label">Source Path:</span>
386:                 <div class="kv-val mono break-all" id="srcPathVal">${escapeHtml(e.source || "—")}</div>
387:               </div>
388:               ${e.destination ? `
389:               <div class="kv-item">
390:                 <span class="kv-label">Destination Path:</span>
391:                 <div class="kv-val mono break-all text-amber">${escapeHtml(e.destination)}</div>
392:               </div>` : ""}
393:               <div class="kv-item flex-row">
394:                 <div>
395:                   <span class="kv-label">User / Account:</span>
396:                   <div class="kv-val font-semibold">${escapeHtml(e.user || "N/A")}</div>
397:                 </div>
398:                 <div>
399:                   <span class="kv-label">Triggering Process:</span>
400:                   <div class="kv-val mono">${escapeHtml(e.process || "N/A")}</div>
401:                 </div>
402:               </div>
403:             </div>
404:           </div>
405:         </div>
406:       </div>
407: 
408:       <!-- Block 3: Exact Content Changes & Diff Telemetry -->
409:       ${e.diff ? `
410:       <div class="chat-block bot-block">
411:         <div class="chat-avatar diff-av">📝</div>
412:         <div class="chat-body">
413:           <div class="chat-meta">
414:             <span class="chat-sender">Diff Analysis Engine</span>
415:             <span class="chat-tag">${e.diff.type === 'text' ? 'Unified Text Diff' : (e.diff.type === 'binary' ? 'Binary Delta' : 'Lifecycle Event')}</span>
416:           </div>
417:           <div class="chat-bubble diff-bubble">
418:             <div class="diff-summary-row">
419:               <span class="diff-summary-text">${escapeHtml(e.diff.summary || "Change recorded")}</span>
420:               ${e.diff.size_delta !== undefined ? `<span class="diff-badge-delta ${e.diff.size_delta > 0 ? 'pos' : (e.diff.size_delta < 0 ? 'neg' : 'zero')}">${e.diff.size_delta > 0 ? '+' : ''}${e.diff.size_delta} bytes</span>` : ''}
421:             </div>
422:             ${e.diff.snippet ? `
423:             <div class="diff-code-wrapper">
424:               <pre class="diff-code"><code>${renderFormattedDiff(e.diff.snippet)}</code></pre>
425:             </div>` : ''}
426:           </div>
427:         </div>
428:       </div>
429:       ` : `
430:       <div class="chat-block bot-block">
431:         <div class="chat-avatar diff-av">📝</div>
432:         <div class="chat-body">
433:           <div class="chat-meta">
434:             <span class="chat-sender">Diff Analysis Engine</span>
435:             <span class="chat-tag">Change Telemetry</span>
436:           </div>
437:           <div class="chat-bubble info-bubble">
438:             <p class="bubble-p text-muted">No line-by-line diff recorded for this historical log entry.</p>
439:           </div>
440:         </div>
441:       </div>
442:       `}
443: 
444:       <!-- Block 4: Cryptographic Integrity Hashing -->
445:       <div class="chat-block bot-block">
446:         <div class="chat-avatar hash-av">🔐</div>
447:         <div class="chat-body">
448:           <div class="chat-meta">
449:             <span class="chat-sender">Integrity Engine</span>
450:             <span class="chat-tag">${(e.hash_algorithm || "SHA256").toUpperCase()}</span>
451:           </div>
452:           <div class="chat-bubble">
453:             <div class="bubble-headline">
454:               <span class="integrity-badge ${(e.integrity_status||"").toLowerCase()}">
455:                 ${e.integrity_status === "INTACT" ? "✓ INTACT" : (e.integrity_status === "TAMPERED" ? "🚨 TAMPERED" : "UNAVAILABLE")}
456:               </span>
457:               <span class="hash-status-text">
458:                 ${e.integrity_status === "INTACT" ? "Cryptographic checksum matched baseline." : (e.integrity_status === "TAMPERED" ? "Hash disparity detected (content changed)." : "Hash snapshot unavailable.")}
459:               </span>
460:             </div>
461:             <div class="hash-box">
462:               <div class="hash-line">
463:                 <span class="hash-label">Pre-Hash:</span>
464:                 <code class="mono-code">${e.hash_pre || "N/A"}</code>
465:               </div>
466:               <div class="hash-line">
467:                 <span class="hash-label">Post-Hash:</span>
468:                 <code class="mono-code">${e.hash_post || "N/A"}</code>
469:               </div>
470:             </div>
471:           </div>
472:         </div>
473:       </div>
474: 
475:       <!-- Block 5: Policy Verdict & Recommendation -->
476:       <div class="chat-block bot-block">
477:         <div class="chat-avatar verdict-av ${level.toLowerCase()}">🛡️</div>
478:         <div class="chat-body">
479:           <div class="chat-meta">
480:             <span class="chat-sender">SOC Policy Advisor</span>
481:             <span class="chat-tag">Blue Team Brief</span>
482:           </div>
483:           <div class="chat-bubble policy-bubble ${level.toLowerCase()}">
484:             <div class="policy-section">
485:               <div class="sec-title">Security Policy Evaluation</div>
486:               <div class="sec-body">${policyText}</div>
487:             </div>
488:             <div class="policy-section mt-8">
489:               <div class="sec-title">Recommended Action</div>
490:               <div class="sec-body font-medium">${recText}</div>
491:             </div>
492:           </div>
493:         </div>
494:       </div>
495: 
496:       <!-- Block 6: Interactive Quick Actions -->
497:       <div class="action-footer">
498:         <button class="btn-action" onclick="copyLogJson(${encodeURIComponent(JSON.stringify(e))})">📋 Copy JSON</button>
499:         <button class="btn-action" onclick="copyText('${escapeQuotes(e.source || "")}')">📁 Copy Source</button>
500:         <button class="btn-action secondary" onclick="closeDrawer()">✕ Close</button>
501:       </div>
502:     `;
503: 
504:     stream.innerHTML = html;
505:     stream.scrollTop = 0;
506:   }
507: 
508:   function renderPagination(page, totalPages, total) {
509:     currentPage = page;
510:     const el = document.getElementById("pagination");
511:     if (totalPages <= 1) { el.innerHTML = ""; return; }
512: 
513:     let html = "";
514:     if (page > 1) html += `<button onclick="fetchLogs(${page-1})">‹ Prev</button>`;
515:     html += `<span class="page-info">Page ${page} / ${totalPages}</span>`;
516:     if (page < totalPages) html += `<button onclick="fetchLogs(${page+1})">Next ›</button>`;
517:     el.innerHTML = html;
518:   }
519: 
520:   // ── Alerts & Live Alert Inspection ───────────────────────────────────────
521:   async function fetchAlerts() {
522:     try {
523:       const res    = await fetch("/api/alerts?limit=30");
524:       const alerts = await res.json();
525:       currentAlerts = alerts || [];
526:       const feed   = document.getElementById("alertFeed");
527:       document.getElementById("alertCount").textContent = currentAlerts.length;
528: 
529:       if (currentAlerts.length === 0) {
530:         feed.innerHTML = `<div class="alert-empty">No alerts yet.</div>`;
531:         return;
532:       }
533:       feed.innerHTML = currentAlerts.map((a, idx) => `
534:         <div class="alert-item ${(a.level||"INFO").toLowerCase()}" onclick="inspectAlert(${idx})" title="Click to view live alert report">
535:           <div class="alert-item-top">
536:             <span class="alert-ts">${(a.timestamp||"").slice(0,19).replace("T"," ")}</span>
537:             <span class="badge-level ${(a.level||"INFO").toLowerCase()}">${a.level||""}</span>
538:           </div>
539:           <div class="alert-msg">${escapeHtml(a.message||"")}</div>
540:           ${a.event_data && a.event_data.source ? `<div class="alert-src mono">${truncate(a.event_data.source,36)}</div>` : ""}
541:           <div class="alert-action-row">
542:             <a href="javascript:void(0)" class="alert-link" onclick="event.stopPropagation(); inspectAlert(${idx})">
543:               🔍 View Live Report →
544:             </a>
545:           </div>
546:         </div>
547:       `).join("");
548:     } catch (e) { /* sidebar alert failure is non-critical */ }
549:   }
550: 
551:   function inspectAlert(alertIndex) {
552:     const alertObj = currentAlerts[alertIndex];
553:     if (!alertObj) return;
554: 
555:     let matchingIndex = -1;
556:     const alertSrc = (alertObj.event_data && alertObj.event_data.source) || "";
557:     const alertTs = (alertObj.timestamp || "").slice(0, 19);
558: 
559:     for (let i = 0; i < currentLogs.length; i++) {
560:       const log = currentLogs[i];
561:       if (log.source === alertSrc && (log.timestamp || "").slice(0, 19) === alertTs) {
562:         matchingIndex = i;
563:         break;
564:       }
565:     }
566: 
567:     if (matchingIndex === -1 && alertSrc) {
568:       for (let i = 0; i < currentLogs.length; i++) {
569:         if (currentLogs[i].source === alertSrc) {
570:           matchingIndex = i;
571:           break;
572:         }
573:       }
574:     }
575: 
576:     if (matchingIndex !== -1) {
577:       const tableRows = document.querySelectorAll("#logTable tbody tr");
578:       const targetRow = tableRows[matchingIndex];
579:       selectLogEvent(matchingIndex, targetRow);
580:       if (targetRow) {
581:         targetRow.scrollIntoView({ behavior: "smooth", block: "center" });
582:       }
583:     } else {
584:       const synthEvent = {
585:         timestamp: alertObj.timestamp,
586:         alert_level: alertObj.level,
587:         event_type: (alertObj.event_data && alertObj.event_data.event_type) || "ALERT",
588:         source: alertSrc || "Unknown Source",
589:         destination: (alertObj.event_data && alertObj.event_data.destination) || "",
590:         user: (alertObj.event_data && alertObj.event_data.user) || "N/A",
591:         process: (alertObj.event_data && alertObj.event_data.process) || "N/A",
592:         hash_pre: (alertObj.event_data && alertObj.event_data.hash_pre) || "N/A",
593:         hash_post: (alertObj.event_data && alertObj.event_data.hash_post) || "N/A",
594:         integrity_status: (alertObj.event_data && alertObj.event_data.integrity_status) || "TAMPERED",
595:         hash_algorithm: "SHA256",
596:         diff: alertObj.event_data && alertObj.event_data.diff,
597:       };
598:       selectedEventId = synthEvent.timestamp + synthEvent.source;
599:       document.getElementById("mainLayout").classList.add("drawer-open");
600:       const fileName = getBasename(synthEvent.source);
601:       document.getElementById("drawerSub").textContent = `LIVE ALERT • ${fileName}`;
602:       renderChatReport(synthEvent);
603:     }
604:   }
605: 
606:   // ── Utilities ────────────────────────────────────────────────────────────
607:   function truncate(str, n) {
608:     if (!str) return "—";
609:     return str.length > n ? "…" + str.slice(-(n-1)) : str;
610:   }
611: 
612:   function shortHash(h) {
613:     if (!h || h === "N/A") return "N/A";
614:     return h.length > 12 ? h.slice(0, 8) + "…" + h.slice(-4) : h;
615:   }
616: 
617:   function getBasename(path) {
618:     if (!path) return "Unknown File";
619:     const parts = path.split(/[\/\\]/);
620:     return parts[parts.length - 1] || path;
621:   }
622: 
623:   function escapeQuotes(str) {
624:     return str.replace(/\\/g, "\\\\").replace(/'/g, "\\'");
625:   }
626: 
627:   function escapeHtml(str) {
628:     if (str === null || str === undefined) return "";
629:     return String(str)
630:       .replace(/&/g, "&amp;")
631:       .replace(/</g, "&lt;")
632:       .replace(/>/g, "&gt;")
633:       .replace(/"/g, "&quot;")
634:       .replace(/'/g, "&#039;");
635:   }
636: 
637:   function copyLogJson(jsonStr) {
638:     try {
639:       const parsed = JSON.parse(decodeURIComponent(jsonStr));
640:       navigator.clipboard.writeText(JSON.stringify(parsed, null, 2));
641:       alert("✓ Log JSON copied to clipboard!");
642:     } catch (e) {
643:       console.error(e);
644:     }
645:   }
646: 
647:   function copyText(txt) {
648:     navigator.clipboard.writeText(txt);
649:     alert("✓ Copied to clipboard:\n" + txt);
650:   }
651: 
652:   function setConnected(ok) {
653:     isConnected = ok;
654:     document.getElementById("statusDot").className   = "status-dot " + (ok ? "online" : "offline");
655:     document.getElementById("statusLabel").textContent = ok ? "Monitoring Active" : "Disconnected";
656:   }
657: 
658:   // ── Search / filter listeners ─────────────────────────────────────────────
659:   let searchDebounce;
660:   document.getElementById("searchInput").addEventListener("input", () => {
661:     clearTimeout(searchDebounce);
662:     searchDebounce = setTimeout(() => fetchLogs(1), 400);
663:   });
664:   document.getElementById("levelFilter").addEventListener("change", () => fetchLogs(1));
665:   document.getElementById("fileTypeFilter").addEventListener("change", () => fetchLogs(1));
666: 
667:   // ── Auto-refresh every 5 seconds ──────────────────────────────────────────
668:   function startRefresh() {
669:     fetchAll();
670:     refreshTimer = setInterval(fetchAll, 5000);
671:   }
672: 
673:   startRefresh();
674: </script>
675: </body>
676: </html>
