191: 
192:                 # 3. File Type / Category Filter
193:                 if file_type:
194:                     ft_lower = file_type.lower()
195:                     src_path = entry.get("source", "")
196:                     dest_path = entry.get("destination", "")
197:                     target = dest_path if (entry.get("event_type") == "MOVED" and dest_path) else src_path
198:                     _, ext = os.path.splitext(target.lower())
199:                     if ft_lower in _FILE_TYPE_MAP:
200:                         if ext not in _FILE_TYPE_MAP[ft_lower]:
201:                             continue
202:                     else:
203:                         norm_ft = ft_lower if ft_lower.startswith(".") else f".{ft_lower}"
204:                         if ext != norm_ft:
205:                             continue
206: 
207:                 # 4. Directory Filter
208:                 if directory:
209:                     dir_lower = directory.lower()
210:                     src_lower = entry.get("source", "").lower()
211:                     dest_lower = entry.get("destination", "").lower()
212:                     if dir_lower not in src_lower and dir_lower not in dest_lower:
213:                         continue
214: 
215:                 # 5. Smart Token & Keyword Filters
216:                 if token_filters:
217:                     # user: token
218:                     if "user" in token_filters:
219:                         if token_filters["user"] not in entry.get("user", "").lower():
220:                             continue
221:                     # ext: token
222:                     if "ext" in token_filters:
223:                         t_ext = token_filters["ext"]
224:                         target_ext = os.path.splitext(entry.get("source", "").lower())[1].lstrip(".")
225:                         if t_ext.lstrip(".") != target_ext:
226:                             continue
227:                     # level: token
228:                     if "level" in token_filters:
229:                         if token_filters["level"] not in entry.get("alert_level", "").lower():
230:                             continue
231:                     # event: token
232:                     if "event" in token_filters:
233:                         if token_filters["event"] not in entry.get("event_type", "").lower():
234:                             continue
235:                     # dir: token
236:                     if "dir" in token_filters:
237:                         d_val = token_filters["dir"]
238:                         if d_val not in entry.get("source", "").lower() and d_val not in entry.get("destination", "").lower():
239:                             continue
240:                     # risk:>N or risk:N
241:                     if "risk" in token_filters:
242:                         r_val = token_filters["risk"]
243:                         e_risk = entry.get("risk_score", 0)
244:                         if r_val.startswith(">="):
245:                             if e_risk < int(r_val[2:]):
246:                                 continue
247:                         elif r_val.startswith(">"):
248:                             if e_risk <= int(r_val[1:]):
249:                                 continue
250:                         elif r_val.startswith("<="):
251:                             if e_risk > int(r_val[2:]):
252:                                 continue
253:                         elif r_val.startswith("<"):
254:                             if e_risk >= int(r_val[1:]):
