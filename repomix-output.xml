<file path="hasher.py">
  1: """
  2: hasher.py - File Integrity Hashing Module
  3: Uses Python's built-in hashlib — no installation required.
  4: Supports SHA256, SHA512, MD5, and Sparse Tri-Point Hashing for large files (>50MB),
  5: with Windows file-lock retry backoff and persistent SQLite baseline database.
  6: """
  7: 
  8: from __future__ import annotations
  9: 
 10: import hashlib
 11: import os
 12: import time
 13: from config import HASH_ALGORITHM, HASH_CHUNK_SIZE
 14: import db
 15: 
 16: # Sparse hashing threshold: 50 MB
 17: SPARSE_HASH_THRESHOLD = 50 * 1024 * 1024
 18: SPARSE_CHUNK_SIZE = 1024 * 1024  # 1 MB
 19: 
 20: # In-memory snapshot: {filepath: hash_digest}
 21: _hash_snapshot: dict[str, str] = {}
 22: 
 23: # In-memory baseline cache: {norm_path: hash_digest}
 24: _baseline_hashes: dict[str, str] = {}
 25: 
 26: 
 27: def compute_hash(
 28:     filepath: str,
 29:     algorithm: str = HASH_ALGORITHM,
 30:     retries: int = 3,
 31:     retry_delay: float = 0.05,
 32:     force_full: bool = False,
 33: ) -> str | None:
 34:     """
 35:     Compute cryptographic hash of a file.
 36:     Uses sparse tri-point hashing for files > 50MB to prevent I/O lockups,
 37:     and includes automated retry backoff to handle transient Windows write locks.
 38: 
 39:     Args:
 40:         filepath:    Absolute path to the file.
 41:         algorithm:   Hash algorithm name ('sha256', 'sha512', 'md5').
 42:         retries:     Number of retry attempts if file is temporarily locked.
 43:         retry_delay: Initial delay in seconds between retries.
 44:         force_full:  If True, forces full byte hashing even for large files.
 45: 
 46:     Returns:
 47:         Hex digest string, or None if the file cannot be read.
 48:     """
 49:     if not filepath:
 50:         return None
 51: 
 52:     for attempt in range(max(1, retries)):
 53:         try:
 54:             if not os.path.exists(filepath):
 55:                 return None
 56: 
 57:             file_size = os.path.getsize(filepath)
 58: 
 59:             # Sparse Hashing Optimization for Large Files (>50 MB)
 60:             if not force_full and file_size > SPARSE_HASH_THRESHOLD:
 61:                 return _compute_sparse_hash(filepath, file_size, algorithm)
 62: 
 63:             # Standard Full Hash for normal files
 64:             h = hashlib.new(algorithm)
 65:             with open(filepath, "rb") as f:
 66:                 while chunk := f.read(HASH_CHUNK_SIZE):
 67:                     h.update(chunk)
 68:             return h.hexdigest()
 69: 
 70:         except PermissionError:
 71:             # Windows file locking (WinError 32) during active application flush
 72:             if attempt < retries - 1:
 73:                 time.sleep(retry_delay * (attempt + 1))
 74:             else:
 75:                 return None
 76:         except (FileNotFoundError, OSError, ValueError):
 77:             return None
 78:     return None
 79: 
 80: 
 81: def _compute_sparse_hash(filepath: str, file_size: int, algorithm: str) -> str:
 82:     """
 83:     Compute a fast sparse tri-point hash:
 84:     Samples 1 MB from header, 1 MB from midpoint, and 1 MB from footer,
 85:     combined with file size and modification time.
 86:     """
 87:     h = hashlib.new(algorithm)
 88:     mtime = os.path.getmtime(filepath)
 89:     h.update(f"SPARSE_V1:{file_size}:{mtime}:".encode("utf-8"))
 90: 
 91:     with open(filepath, "rb") as f:
 92:         # 1. Header chunk (1 MB)
 93:         h.update(f.read(SPARSE_CHUNK_SIZE))
 94: 
 95:         # 2. Middle chunk (1 MB)
 96:         mid_offset = max(0, (file_size // 2) - (SPARSE_CHUNK_SIZE // 2))
 97:         f.seek(mid_offset)
 98:         h.update(f.read(SPARSE_CHUNK_SIZE))
 99: 
100:         # 3. Footer chunk (1 MB)
101:         tail_offset = max(0, file_size - SPARSE_CHUNK_SIZE)
102:         f.seek(tail_offset)
103:         h.update(f.read(SPARSE_CHUNK_SIZE))
104: 
105:     return h.hexdigest()
106: 
107: 
108: def verify_integrity(pre_hash: str | None, post_hash: str | None) -> tuple[bool, str]:
109:     """
110:     Compare pre- and post-transfer hashes.
111: 
112:     Returns:
113:         (True, "INTACT")       if hashes match
114:         (False, "TAMPERED")    if hashes differ
115:         (False, "UNAVAILABLE") if either hash is None
116:     """
117:     if pre_hash is None or post_hash is None:
118:         return False, "UNAVAILABLE"
119:     if pre_hash == post_hash:
120:         return True, "INTACT"
121:     return False, "TAMPERED"
122: 
123: 
124: def snapshot_file(filepath: str) -> str | None:
125:     """Compute and store hash of a file in memory snapshot and persistent database."""
126:     digest = compute_hash(filepath)
127:     if digest:
128:         _hash_snapshot[filepath] = digest
129:         set_baseline_hash(filepath, digest)
130:     return digest
131: 
132: 
133: def check_against_snapshot(filepath: str) -> tuple[bool, str, str | None, str | None]:
134:     pre_hash = _hash_snapshot.get(filepath) or get_baseline_hash(filepath)
135:     post_hash = compute_hash(filepath)
136:     ok, status = verify_integrity(pre_hash, post_hash)
137:     return ok, status, pre_hash, post_hash
138: 
139: 
140: def clear_snapshot(filepath: str = None):
141:     if filepath:
142:         _hash_snapshot.pop(filepath, None)
143:     else:
144:         _hash_snapshot.clear()
145: 
146: 
147: def get_snapshot() -> dict:
148:     return dict(_hash_snapshot)
149: 
150: 
151: # ── Baseline Registry Functions (Dual Memory & SQLite Persistence) ───────────
152: 
153: def set_baseline_hash(filepath: str, digest: str | None = None) -> str | None:
154:     """Store or update the baseline hash in memory and persistent SQLite."""
155:     if not filepath:
156:         return None
157:     norm = os.path.normcase(os.path.normpath(os.path.abspath(filepath)))
158:     if digest is None:
159:         digest = compute_hash(filepath)
160:     if digest:
161:         _baseline_hashes[norm] = digest
162:         size = 0
163:         mtime = 0.0
164:         try:
165:             if os.path.exists(filepath):
166:                 size = os.path.getsize(filepath)
167:                 mtime = os.path.getmtime(filepath)
168:         except OSError:
169:             pass
170:         db.set_baseline(filepath, digest, size, mtime)
171:     return digest
172: 
173: 
174: def get_baseline_hash(filepath: str) -> str | None:
175:     """Retrieve the last recorded baseline hash (memory cache with SQLite fallback)."""
176:     if not filepath:
177:         return None
178:     norm = os.path.normcase(os.path.normpath(os.path.abspath(filepath)))
179:     cached = _baseline_hashes.get(norm)
180:     if cached:
181:         return cached
182: 
183:     # Persistent SQLite lookup
184:     row = db.get_baseline(filepath)
185:     if row and row.get("hash"):
186:         _baseline_hashes[norm] = row["hash"]
187:         return row["hash"]
188:     return None
189: 
190: 
191: def remove_baseline_hash(filepath: str) -> str | None:
192:     """Remove a file from baseline memory cache and persistent SQLite."""
193:     if not filepath:
194:         return None
195:     norm = os.path.normcase(os.path.normpath(os.path.abspath(filepath)))
196:     db.remove_baseline(filepath)
197:     return _baseline_hashes.pop(norm, None)
