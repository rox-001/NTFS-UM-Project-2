311: }
312: .table-title { font-weight: 600; font-size: 14px; margin-right: 10px; }
313: .table-tip   { font-size: 11px; color: var(--accent); opacity: 0.9; }
314: .table-meta  { font-size: 12px; color: var(--text-muted); }
315: 
316: .table-wrapper { overflow-x: auto; flex: 1; }
317: .table-wrapper::-webkit-scrollbar { height: 4px; }
