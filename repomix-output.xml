 18: class TestComputeHash(unittest.TestCase):
 19:     """Tests for hasher.compute_hash()"""
 20: 
 21:     def setUp(self):
 22:         """Create a temporary file with known content for testing."""
 23:         self.tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".txt", mode="wb")
 24:         self.tmp.write(b"SecureMonitor Test File - 12345")
 25:         self.tmp.close()
 26:         self.filepath = self.tmp.name
 27: 
 28:     def tearDown(self):
 29:         os.unlink(self.filepath)
 30:         hasher.clear_snapshot()
 31: 
 32:     def test_sha256_returns_hex_string(self):
 33:         result = hasher.compute_hash(self.filepath, "sha256")
 34:         self.assertIsInstance(result, str)
 35:         self.assertEqual(len(result), 64)   # SHA256 produces 64-char hex
 36: 
 37:     def test_md5_returns_hex_string(self):
 38:         result = hasher.compute_hash(self.filepath, "md5")
 39:         self.assertIsInstance(result, str)
 40:         self.assertEqual(len(result), 32)   # MD5 produces 32-char hex
 41: 
 42:     def test_sha512_returns_hex_string(self):
 43:         result = hasher.compute_hash(self.filepath, "sha512")
 44:         self.assertIsInstance(result, str)
 45:         self.assertEqual(len(result), 128)  # SHA512 produces 128-char hex
 46: 
 47:     def test_hash_matches_manual_calculation(self):
 48:         """Verify compute_hash matches a direct hashlib calculation."""
 49:         expected = hashlib.sha256(b"SecureMonitor Test File - 12345").hexdigest()
 50:         result   = hasher.compute_hash(self.filepath, "sha256")
 51:         self.assertEqual(result, expected)
 52: 
 53:     def test_nonexistent_file_returns_none(self):
 54:         result = hasher.compute_hash("C:\\nonexistent\\path\\file.txt")
 55:         self.assertIsNone(result)
 56: 
 57:     def test_same_file_same_hash(self):
 58:         h1 = hasher.compute_hash(self.filepath)
 59:         h2 = hasher.compute_hash(self.filepath)
 60:         self.assertEqual(h1, h2)
 61: 
 62:     def test_different_content_different_hash(self):
 63:         # Modify file content
 64:         with open(self.filepath, "wb") as f:
 65:             f.write(b"MODIFIED CONTENT")
 66:         h_modified = hasher.compute_hash(self.filepath)
 67: 
 68:         tmp2 = tempfile.NamedTemporaryFile(delete=False, suffix=".txt", mode="wb")
 69:         tmp2.write(b"ORIGINAL CONTENT")
 70:         tmp2.close()
 71:         h_original = hasher.compute_hash(tmp2.name)
 72:         os.unlink(tmp2.name)
 73: 
 74:         self.assertNotEqual(h_modified, h_original)
