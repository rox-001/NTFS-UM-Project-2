  75: .status-dot.offline { background: var(--crit-color); }
  76: .status-label { font-size: 13px; font-weight: 500; color: var(--text-secondary); }
  77: .refresh-label { font-size: 11px; color: var(--text-muted); background: var(--bg-card);
