<file path="build_all.ps1">
  1: <#
  2: .SYNOPSIS
  3:     Builds the FileSentinel Standalone Executable (.exe) and Windows Installer (.msi).
  4: 
  5: .DESCRIPTION
  6:     1. Verifies/downloads portable WiX Toolset binaries into tools\wix
  7:     2. Runs PyInstaller to compile FileSentinel.exe with embedded templates, static files, icons, and PE version resource
  8:     3. Runs WiX candle and light to generate FileSentinel-Setup.msi
  9:     4. Applies Authenticode code-signing to both binaries
 10:     5. Outputs all distribution packages into the dist\ directory
 11: #>
 12: 
 13: $ErrorActionPreference = "Stop"
 14: $ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
 15: Set-Location $ScriptDir
 16: 
 17: Write-Host "`n========================================================" -ForegroundColor Cyan
 18: Write-Host "   FileSentinel DLP - Automated Build Pipeline (.exe & .msi)" -ForegroundColor Cyan
 19: Write-Host "========================================================`n" -ForegroundColor Cyan
 20: 
 21: # 1. Check Python & PyInstaller
 22: Write-Host "[1/5] Checking Python environment and dependencies..." -ForegroundColor Yellow
 23: $py = Get-Command python -ErrorAction SilentlyContinue
 24: if (!$py) {
 25:     Write-Error "Python was not found in PATH. Please install Python 3.10+."
 26: }
 27: 
 28: $hasPyInstaller = python -c "import PyInstaller" 2>$null
 29: if ($LASTEXITCODE -ne 0) {
 30:     Write-Host "  Installing PyInstaller..." -ForegroundColor DarkGray
 31:     python -m pip install pyinstaller
 32: }
 33: 
 34: # 2. Check/Download WiX Toolset (portable binaries)
 35: Write-Host "[2/5] Ensuring WiX Toolset binaries..." -ForegroundColor Yellow
 36: $WixDir = Join-Path $ScriptDir "tools\wix"
 37: $CandleExe = Join-Path $WixDir "candle.exe"
 38: $LightExe = Join-Path $WixDir "light.exe"
 39: 
 40: if (!(Test-Path $CandleExe) -or !(Test-Path $LightExe)) {
 41:     Write-Host "  Downloading portable WiX 3.11 binaries..." -ForegroundColor DarkGray
 42:     if (!(Test-Path $WixDir)) { New-Item -ItemType Directory -Path $WixDir -Force | Out-Null }
 43:     $ZipPath = Join-Path $WixDir "wix.zip"
 44:     Invoke-WebRequest -Uri "https://github.com/wixtoolset/wix3/releases/download/wix3112rtm/wix311-binaries.zip" -OutFile $ZipPath
 45:     Expand-Archive -Path $ZipPath -DestinationPath $WixDir -Force
 46:     Remove-Item $ZipPath -Force
 47: }
 48: Write-Host "  WiX Toolset ready." -ForegroundColor Green
 49: 
 50: # 3. Build Standalone Executable (.exe)
 51: Write-Host "[3/5] Building FileSentinel.exe with PyInstaller & PE Version Info..." -ForegroundColor Yellow
 52: $VersionFile = Join-Path $ScriptDir "installer\version_info.txt"
 53: 
 54: python -m PyInstaller `
 55:     --noconsole `
 56:     --onefile `
 57:     --name "FileSentinel" `
 58:     --icon "assets/icon.ico" `
 59:     --version-file "$VersionFile" `
 60:     --collect-all "webview" `
 61:     --collect-all "pystray" `
 62:     --add-data "dashboard/templates;dashboard/templates" `
 63:     --add-data "dashboard/static;dashboard/static" `
 64:     --add-data "assets;assets" `
 65:     main.py
 66: 
 67: if ($LASTEXITCODE -ne 0) {
 68:     Write-Error "PyInstaller build failed."
 69: }
 70: Write-Host "  FileSentinel.exe generated successfully." -ForegroundColor Green
 71: 
 72: # 4. Compile Windows MSI Installer (.msi)
 73: Write-Host "[4/5] Compiling Windows Installer (.msi) with WiX..." -ForegroundColor Yellow
 74: $InstallerDir = Join-Path $ScriptDir "installer"
 75: $WixObj = Join-Path $InstallerDir "FileSentinel.wixobj"
 76: $WxsFile = Join-Path $InstallerDir "FileSentinel.wxs"
 77: $MsiOutput = Join-Path $ScriptDir "dist\FileSentinel-Setup.msi"
 78: 
 79: & $CandleExe -nologo -arch x64 -ext WixUIExtension $WxsFile -out $WixObj
 80: if ($LASTEXITCODE -ne 0) { Write-Error "WiX candle compilation failed." }
 81: 
 82: & $LightExe -nologo -ext WixUIExtension -sice:ICE69 -out $MsiOutput $WixObj
 83: if ($LASTEXITCODE -ne 0) { Write-Error "WiX light linking failed." }
 84: 
 85: # Cleanup intermediate obj file
 86: if (Test-Path $WixObj) { Remove-Item $WixObj -Force }
 87: 
 88: # 5. Apply Authenticode Digital Signatures
 89: Write-Host "[5/5] Applying Authenticode Code Signing..." -ForegroundColor Yellow
 90: $cert = Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert -ErrorAction SilentlyContinue | Select-Object -First 1
 91: if (!$cert) {
 92:     $cert = New-SelfSignedCertificate -Type CodeSigningCert -Subject "CN=FileSentinel Security, O=FileSentinel, C=US" -CertStoreLocation "Cert:\CurrentUser\My" -NotAfter (Get-Date).AddYears(5)
 93: }
 94: 
 95: if ($cert) {
 96:     Set-AuthenticodeSignature -FilePath "dist\FileSentinel.exe" -Certificate $cert | Out-Null
 97:     Set-AuthenticodeSignature -FilePath "dist\FileSentinel-Setup.msi" -Certificate $cert | Out-Null
 98:     Write-Host "  Digital signatures applied to FileSentinel.exe and FileSentinel-Setup.msi." -ForegroundColor Green
 99: }
100: 
101: Write-Host "`n========================================================" -ForegroundColor Green
102: Write-Host "   BUILD SUCCESSFUL!" -ForegroundColor Green
103: Write-Host "========================================================" -ForegroundColor Green
104: $ExeItem = Get-Item "dist\FileSentinel.exe"
105: $MsiItem = Get-Item "dist\FileSentinel-Setup.msi"
106: 
107: Write-Host ("  Standalone Executable : {0} ({1:N2} MB)" -f $ExeItem.FullName, ($ExeItem.Length / 1MB)) -ForegroundColor Cyan
108: Write-Host ("  Windows Installer MSI : {0} ({1:N2} MB)" -f $MsiItem.FullName, ($MsiItem.Length / 1MB)) -ForegroundColor Cyan
109: Write-Host "========================================================`n" -ForegroundColor Green
</file>

<file path="detector.py">
  1: r"""
  2: detector.py - Event Classification & Unauthorized Movement Detection
  3: Classifies each filesystem event as INFO, WARNING, or CRITICAL.
  4: Includes path-component matching, dynamic drive-type detection, and multi-extension parsing.
  5: """
  6: 
  7: from __future__ import annotations
  8: 
  9: import os
 10: import sys
 11: import tempfile
 12: from config import (
 13:     SENSITIVE_EXTENSIONS,
 14:     SENSITIVE_DIRECTORIES,
 15:     SUSPICIOUS_DRIVE_LETTERS,
 16:     SUSPICIOUS_NETWORK_PREFIXES,
 17: )
 18: 
 19: # Precompute sensitive extension set (O(1) lookup)
 20: _SENSITIVE_EXT_SET = frozenset(e.lower() for e in SENSITIVE_EXTENSIONS)
 21: 
 22: # Recognized cloud storage folder names (matched against directory path components only)
 23: _CLOUD_KEYWORDS = frozenset({"onedrive", "dropbox", "google drive", "iclouddrive", "icloud", "box", "nextcloud"})
 24: 
 25: # Recognized recycle bin folder names
 26: _RECYCLER_KEYWORDS = frozenset({"recycler", "$recycle.bin", "$recycles.bin"})
 27: 
 28: # System temp directories (normalized lowercase)
 29: _SYSTEM_TEMP_DIRS: set[str] = set()
 30: for _t_env in ("TEMP", "TMP", "TMPDIR"):
 31:     _t_val = os.environ.get(_t_env)
 32:     if _t_val:
 33:         _SYSTEM_TEMP_DIRS.add(os.path.normcase(os.path.normpath(os.path.abspath(_t_val))))
 34: 
 35: try:
 36:     _SYSTEM_TEMP_DIRS.add(os.path.normcase(os.path.normpath(os.path.abspath(tempfile.gettempdir()))))
 37: except Exception:
 38:     pass
 39: 
 40: if sys.platform == "win32":
 41:     _SYSTEM_TEMP_DIRS.add(os.path.normcase("c:\\windows\\temp"))
 42: else:
 43:     _SYSTEM_TEMP_DIRS.add("/tmp")
 44:     _SYSTEM_TEMP_DIRS.add("/var/tmp")
 45: 
 46: 
 47: def _get_drive_type_windows(drive_root: str) -> int:
 48:     """
 49:     Query Windows GetDriveTypeW:
 50:       2 = DRIVE_REMOVABLE (USB flash drive, memory card)
 51:       3 = DRIVE_FIXED     (internal hard drive / SSD)
 52:       4 = DRIVE_REMOTE    (network share mapped drive)
 53:       5 = DRIVE_CDROM     (optical drive)
 54:       6 = DRIVE_RAMDISK
 55:     """
 56:     if sys.platform != "win32":
 57:         return 0
 58:     try:
 59:         import ctypes
 60:         if not drive_root.endswith("\\"):
 61:             drive_root += "\\"
 62:         return ctypes.windll.kernel32.GetDriveTypeW(drive_root)
 63:     except Exception:
 64:         return 0
 65: 
 66: 
 67: def is_sensitive_file(path: str) -> bool:
 68:     """
 69:     Return True if the file path has a sensitive extension
 70:     or resides inside a configured sensitive directory.
 71:     Supports dotfiles (.env), sub-extensions (secret.pem.tmp), and full paths.
 72:     """
 73:     if not path:
 74:         return False
 75: 
 76:     norm = os.path.normpath(path)
 77:     basename = os.path.basename(norm).lower()
 78: 
 79:     # 1. Primary extension check
 80:     _, ext = os.path.splitext(norm)
 81:     if ext.lower() in _SENSITIVE_EXT_SET:
 82:         return True
 83: 
 84:     # 2. Dotfiles like ".env", ".cfg" where os.path.splitext treats the whole filename as stem
 85:     if basename in _SENSITIVE_EXT_SET:
 86:         return True
 87: 
 88:     # 3. Double-extension check (e.g. secret.pem.tmp -> check if stem 'secret.pem' is sensitive)
 89:     stem, sub_ext = os.path.splitext(basename)
 90:     if sub_ext in {".tmp", ".part", ".crdownload", ".bak", ".swp", ".lock"}:
 91:         _, inner_ext = os.path.splitext(stem)
 92:         if inner_ext in _SENSITIVE_EXT_SET or stem in _SENSITIVE_EXT_SET:
 93:             return True
 94: 
 95:     # 4. Check if path resides inside a sensitive directory
 96:     norm_path = os.path.normcase(norm)
 97:     for sensitive_dir in SENSITIVE_DIRECTORIES:
 98:         if sensitive_dir:
 99:             norm_sens = os.path.normcase(os.path.normpath(os.path.abspath(sensitive_dir)))
100:             if norm_path == norm_sens or norm_path.startswith(norm_sens.rstrip(os.sep) + os.sep):
101:                 return True
102: 
103:     return False
104: 
105: 
106: def is_cloud_or_removable_location(path: str) -> bool:
107:     """
108:     Return True if the path is located on removable media (USB), network shares,
109:     or cloud-sync folders (OneDrive, Dropbox, Google Drive, iCloud, Box).
110:     """
111:     if not path:
112:         return False
113: 
114:     raw_path = path.strip()
115:     norm = os.path.normpath(raw_path)
116: 
117:     # 1. UNC network paths: \\server\share or //server/share
118:     if raw_path.startswith("\\\\") or raw_path.startswith("//") or norm.startswith(r"\\"):
119:         return True
120: 
121:     # 2. Windows drive type check (Removable media / Network drives)
122:     if sys.platform == "win32" and len(norm) >= 2 and norm[1] == ":":
123:         drive_letter = norm[:2].upper() + "\\"
124:         dtype = _get_drive_type_windows(drive_letter)
125:         # 2 = DRIVE_REMOVABLE, 4 = DRIVE_REMOTE, 5 = DRIVE_CDROM
126:         if dtype in (2, 4, 5):
127:             return True
128:         elif dtype == 3:
129:             # Internal disk
130:             pass
131:         else:
132:             if drive_letter in [d.upper() for d in SUSPICIOUS_DRIVE_LETTERS]:
133:                 return True
134:     elif sys.platform != "win32":
135:         norm_lower = norm.lower()
136:         if any(norm_lower.startswith(p) for p in ("/media/", "/mnt/", "/volumes/")):
137:             return True
138:         drive_letter = norm[:3].upper() if len(norm) >= 3 and norm[1:3] == ":\\" else ""
139:         if drive_letter and drive_letter in [d.upper() for d in SUSPICIOUS_DRIVE_LETTERS]:
140:             return True
141: 
142:     # 3. Path component analysis for directory path (excluding filename)
143:     dir_path = os.path.dirname(norm)
144:     if dir_path:
145:         parts = [p.lower() for p in dir_path.replace("/", "\\").split("\\") if p]
146:         for part in parts:
147:             if any(part == ck or part.startswith(ck + " ") or part.startswith(ck + "-") for ck in _CLOUD_KEYWORDS):
148:                 return True
149: 
150:     return False
151: 
152: 
153: def is_suspicious_destination(path: str) -> bool:
154:     """
155:     Return True if the destination path represents an exfiltration vector:
156:       - Removable media (USB drives)
157:       - Network shares (UNC paths \\\\server\\share or //server/share)
158:       - Cloud synchronization folders (OneDrive, Dropbox, Google Drive, iCloud)
159:       - Recycle bin staging
160:       - System or user Temp staging locations
161: 
162:     Uses whole-path-component matching to avoid false positives (e.g. 'Templates' or 'attempt2.txt').
163:     """
164:     if not path:
165:         return False
166: 
167:     # Check cloud, network, and removable media
168:     if is_cloud_or_removable_location(path):
169:         return True
170: 
171:     norm = os.path.normpath(path.strip())
172:     dir_path = os.path.dirname(norm)
173:     if dir_path:
174:         parts = [p.lower() for p in dir_path.replace("/", "\\").split("\\") if p]
175: 
176:         # Check recycle bin components
177:         if any(part in _RECYCLER_KEYWORDS for part in parts):
178:             return True
179: 
180:         # Check temp directory components:
181:         # Must match actual system temp directory path OR be an exact folder named 'temp' or 'tmp'
182:         norm_case_dir = os.path.normcase(os.path.abspath(dir_path))
183:         for sys_temp in _SYSTEM_TEMP_DIRS:
184:             if norm_case_dir == sys_temp or norm_case_dir.startswith(sys_temp.rstrip(os.sep) + os.sep):
185:                 return True
186: 
187:         if any(part in {"temp", "tmp"} for part in parts):
188:             return True
189: 
190:     return False
191: 
192: 
193: def classify_event(event_type: str, src_path: str, dest_path: str = "") -> str:
194:     """
195:     Classify a filesystem event and return an alert level string ('INFO', 'WARNING', or 'CRITICAL').
196: 
197:     Classification logic:
198:     - CRITICAL: File transferred TO a suspicious destination (USB, Cloud, Network, Temp)
199:     - CRITICAL: Sensitive file CREATED or MODIFIED directly inside an exfiltration location (USB / Cloud Sync)
200:     - CRITICAL: Sensitive file MOVED or DELETED
201:     - WARNING:  Sensitive file CREATED or MODIFIED in normal monitored locations
202:     - INFO:     Normal files in normal locations
203:     """
204:     src_sensitive   = is_sensitive_file(src_path)
205:     dest_sensitive  = is_sensitive_file(dest_path) if dest_path else False
206:     is_sensitive    = src_sensitive or dest_sensitive
207: 
208:     dest_suspicious = is_suspicious_destination(dest_path) if dest_path else False
209: 
210:     # 1. Any file transferred TO a suspicious destination (USB, Cloud, Network, Temp staging)
211:     if dest_suspicious:
212:         return "CRITICAL"
213: 
214:     # 2. Sensitive file created/modified directly in a cloud-sync or removable media location (F-06)
215:     if is_sensitive and is_cloud_or_removable_location(src_path):
216:         return "CRITICAL"
217: 
218:     # 3. Sensitive file moved or deleted locally
219:     if is_sensitive:
220:         if event_type in ("MOVED", "DELETED"):
221:             return "CRITICAL"
222:         return "WARNING"
223: 
224:     # 4. Default
225:     return "INFO"
226: 
227: 
228: def describe_event(event_type: str, src_path: str, dest_path: str = "") -> str:
229:     """
230:     Generate a human-readable description of the event for logs and alerts.
231:     """
232:     basename = os.path.basename(src_path)
233:     descriptions = {
234:         "CREATED":     f"File created: '{basename}'",
235:         "MODIFIED":    f"File modified: '{basename}'",
236:         "DELETED":     f"File deleted: '{basename}'",
237:         "MOVED":       f"File moved: '{basename}' \u2192 '{dest_path}'",
238:         "CREATED_DIR": f"Directory created: '{basename}'",
239:         "DELETED_DIR": f"Directory deleted: '{basename}'",
240:         "MOVED_DIR":   f"Directory moved: '{basename}' \u2192 '{dest_path}'",
241:     }
242:     return descriptions.get(event_type, f"Event {event_type} on '{basename}'")
</file>

