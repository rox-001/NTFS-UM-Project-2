266:                         # ZoneId 3 = Internet, ZoneId 4 = Restricted
267:                         if val in ("3", "4"):
268:                             is_internet = True
269:                     elif line.startswith("HostUrl="):
270:                         host_url = line.split("=", 1)[1].strip()
271:                     elif line.startswith("ReferrerUrl="):
272:                         referrer_url = line.split("=", 1)[1].strip()
273:             if is_internet:
