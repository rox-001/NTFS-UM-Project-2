  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>SecureMonitor — File Transfer Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css"/>
</head>
<body>

<!-- ═══════════════════════════════ TOP NAV ═══════════════════════════════ -->
<header class="top-bar">
  <div class="top-bar-inner">
    <div class="logo-area">
      <span class="logo-icon">🛡</span>
      <span class="logo-text">SecureMonitor</span>
      <span class="logo-sub">File Transfer DLP</span>
    </div>
    <div class="status-area">
      <span class="status-dot" id="statusDot"></span>
      <span class="status-label" id="statusLabel">Connecting…</span>
      <span class="refresh-label">Auto-refresh: 5s</span>
    </div>
  </div>
</header>

<!-- ═══════════════════════════════ MAIN LAYOUT ═══════════════════════════ -->
<div class="layout">

  <!-- ─── LEFT SIDEBAR: Alerts ─── -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <span>🚨 Live Alerts</span>
      <span class="badge" id="alertCount">0</span>
    </div>
    <div class="alert-feed" id="alertFeed">
      <div class="alert-empty">No alerts yet.</div>
    </div>
  </aside>

  <!-- ─── MAIN CONTENT ─── -->
  <main class="main-content">

    <!-- Stats Cards -->
    <section class="stats-row">
      <div class="stat-card total">
        <div class="stat-icon">📋</div>
        <div class="stat-body">
          <div class="stat-value" id="statTotal">0</div>
          <div class="stat-label">Total Events</div>
        </div>
      </div>
      <div class="stat-card info">
        <div class="stat-icon">ℹ</div>
        <div class="stat-body">
          <div class="stat-value" id="statInfo">0</div>
          <div class="stat-label">INFO</div>
        </div>
      </div>
      <div class="stat-card warning">
        <div class="stat-icon">⚠</div>
        <div class="stat-body">
          <div class="stat-value" id="statWarning">0</div>
          <div class="stat-label">WARNINGS</div>
        </div>
      </div>
      <div class="stat-card critical">
        <div class="stat-icon">🔴</div>
        <div class="stat-body">
          <div class="stat-value" id="statCritical">0</div>
          <div class="stat-label">CRITICAL</div>
        </div>
      </div>
      <div class="stat-card tampered">
        <div class="stat-icon">🔐</div>
        <div class="stat-body">
          <div class="stat-value" id="statTampered">0</div>
          <div class="stat-label">Tampered</div>
        </div>
      </div>
    </section>

    <!-- Filter Bar -->
    <section class="filter-bar">
      <input type="text"  id="searchInput"  class="filter-input" placeholder="🔍  Search source, destination, event type…" />
      <select id="levelFilter" class="filter-select">
        <option value="">All Levels</option>
        <option value="INFO">INFO</option>
        <option value="WARNING">WARNING</option>
        <option value="CRITICAL">CRITICAL</option>
      </select>
      <button class="btn-refresh" id="btnRefresh" onclick="fetchAll()">↺ Refresh</button>
    </section>

    <!-- Log Table -->
    <section class="table-section">
      <div class="table-header-row">
        <span class="table-title">Event Log</span>
        <span class="table-meta" id="tableMeta">Loading…</span>
      </div>
      <div class="table-wrapper">
        <table id="logTable">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Level</th>
              <th>Event</th>
              <th>Source</th>
              <th>Destination</th>
              <th>User</th>
              <th>Hash Pre</th>
              <th>Hash Post</th>
              <th>Integrity</th>
            </tr>
          </thead>
          <tbody id="logBody">
            <tr><td colspan="9" class="empty-row">No events yet. Start monitoring to see data.</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="pagination" id="pagination"></div>
    </section>

  </main>
</div>

<!-- ═════════════════════════════ JAVASCRIPT ══════════════════════════════ -->
<script>
  let currentPage   = 1;
  let refreshTimer  = null;
  let isConnected   = false;

  // ── Fetch everything ────────────────────────────────────────────────────
  async function fetchAll() {
    await Promise.all([fetchStats(), fetchLogs(), fetchAlerts()]);
  }

  // ── Stats ────────────────────────────────────────────────────────────────
  async function fetchStats() {
    try {
      const res  = await fetch("/api/stats");
      const data = await res.json();
      document.getElementById("statTotal").textContent    = data.total    ?? 0;
      document.getElementById("statInfo").textContent     = data.info     ?? 0;
      document.getElementById("statWarning").textContent  = data.warning  ?? 0;
      document.getElementById("statCritical").textContent = data.critical  ?? 0;
      document.getElementById("statTampered").textContent = data.integrity_tampered ?? 0;
      setConnected(true);
    } catch (e) {
      setConnected(false);
    }
  }

  // ── Logs ─────────────────────────────────────────────────────────────────
  async function fetchLogs(page = currentPage) {
    const level   = document.getElementById("levelFilter").value;
    const keyword = document.getElementById("searchInput").value.trim();
    let url = `/api/logs?page=${page}`;
    if (level)   url += `&level=${encodeURIComponent(level)}`;
    if (keyword) url += `&keyword=${encodeURIComponent(keyword)}`;

    try {
      const res  = await fetch(url);
      const data = await res.json();
      renderLogs(data.logs);
      renderPagination(data.page, data.total_pages, data.total);
      document.getElementById("tableMeta").textContent =
        `Showing ${data.logs.length} of ${data.total} events`;
    } catch (e) {
      document.getElementById("tableMeta").textContent = "Could not load logs.";
    }
  }

  function renderLogs(logs) {
    const tbody = document.getElementById("logBody");
    if (!logs || logs.length === 0) {
      tbody.innerHTML = `<tr><td colspan="9" class="empty-row">No matching events.</td></tr>`;
      return;
    }
    tbody.innerHTML = logs.map(e => `
      <tr class="row-${(e.alert_level||"INFO").toLowerCase()}">
        <td class="mono ts">${(e.timestamp||"").slice(0,19).replace("T"," ")}</td>
        <td><span class="badge-level ${(e.alert_level||"INFO").toLowerCase()}">${e.alert_level||"—"}</span></td>
        <td><span class="event-type">${e.event_type||"—"}</span></td>
        <td class="mono path" title="${e.source||""}">${truncate(e.source||"", 45)}</td>
        <td class="mono path" title="${e.destination||""}">${truncate(e.destination||"—", 35)}</td>
        <td>${e.user||"—"}</td>
        <td class="mono hash" title="${e.hash_pre||""}">${shortHash(e.hash_pre)}</td>
        <td class="mono hash" title="${e.hash_post||""}">${shortHash(e.hash_post)}</td>
        <td><span class="integrity-badge ${(e.integrity_status||"").toLowerCase()}">${e.integrity_status||"—"}</span></td>
      </tr>
    `).join("");
  }

  function renderPagination(page, totalPages, total) {
    currentPage = page;
    const el = document.getElementById("pagination");
    if (totalPages <= 1) { el.innerHTML = ""; return; }

    let html = "";
    if (page > 1) html += `<button onclick="fetchLogs(${page-1})">‹ Prev</button>`;
    html += `<span class="page-info">Page ${page} / ${totalPages}</span>`;
    if (page < totalPages) html += `<button onclick="fetchLogs(${page+1})">Next ›</button>`;
    el.innerHTML = html;
  }

  // ── Alerts ───────────────────────────────────────────────────────────────
  async function fetchAlerts() {
    try {
      const res    = await fetch("/api/alerts?limit=30");
      const alerts = await res.json();
      const feed   = document.getElementById("alertFeed");
      document.getElementById("alertCount").textContent = alerts.length;

      if (alerts.length === 0) {
        feed.innerHTML = `<div class="alert-empty">No alerts yet.</div>`;
        return;
      }
      feed.innerHTML = alerts.map(a => `
        <div class="alert-item ${(a.level||"INFO").toLowerCase()}">
          <div class="alert-ts">${(a.timestamp||"").slice(0,19).replace("T"," ")}</div>
          <div class="alert-level">${a.level||""}</div>
          <div class="alert-msg">${a.message||""}</div>
          ${a.event_data && a.event_data.source ? `<div class="alert-src">${truncate(a.event_data.source,40)}</div>` : ""}
        </div>
      `).join("");
    } catch (e) { /* sidebar alert failure is non-critical */ }
  }

  // ── Helpers ──────────────────────────────────────────────────────────────
  function truncate(str, n) {
    if (!str) return "—";
    return str.length > n ? "…" + str.slice(-(n-1)) : str;
  }

  function shortHash(h) {
    if (!h || h === "N/A") return "N/A";
    return h.length > 12 ? h.slice(0, 8) + "…" + h.slice(-4) : h;
  }

  function setConnected(ok) {
    isConnected = ok;
    document.getElementById("statusDot").className   = "status-dot " + (ok ? "online" : "offline");
    document.getElementById("statusLabel").textContent = ok ? "Monitoring Active" : "Disconnected";
  }

  // ── Search / filter listeners ─────────────────────────────────────────────
  let searchDebounce;
  document.getElementById("searchInput").addEventListener("input", () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => fetchLogs(1), 400);
  });
  document.getElementById("levelFilter").addEventListener("change", () => fetchLogs(1));

  // ── Auto-refresh every 5 seconds ──────────────────────────────────────────
  function startRefresh() {
    fetchAll();
    refreshTimer = setInterval(fetchAll, 5000);
  }

  startRefresh();
</script>
</body>
</html>

</file>

<file path="dashboard/static/style.css">
/* ═══════════════════════════════════════════════════════════════════════
   SecureMonitor Dashboard — SPLUNK-inspired Dark Theme
   Pure CSS, zero external dependencies
   ═══════════════════════════════════════════════════════════════════════ */

/* ── Reset & Variables ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg-base:       #0d1117;
  --bg-elevated:   #161b22;
  --bg-card:       #1c2128;
  --bg-table-row:  #1a1f26;
  --bg-hover:      #22272e;
  --border:        #30363d;
  --border-subtle: #21262d;

  --text-primary:  #e6edf3;
  --text-secondary:#8b949e;
  --text-muted:    #6e7681;

  /* Level Colors */
  --info-color:    #58a6ff;
  --info-bg:       #0d2847;
  --warn-color:    #d29922;
  --warn-bg:       #2d1f0a;
  --crit-color:    #f85149;
  --crit-bg:       #3b0d0c;
  --ok-color:      #3fb950;
  --ok-bg:         #0a2f16;
  --accent:        #58a6ff;

  --font-main:  'Inter', system-ui, sans-serif;
  --font-mono:  'JetBrains Mono', 'Cascadia Code', monospace;
  --radius:     6px;
  --radius-lg:  10px;
  --shadow:     0 4px 20px rgba(0,0,0,0.5);
}

html, body {
  height: 100%;
  background: var(--bg-base);
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 14px;
  line-height: 1.5;
}

/* ── Top Navigation Bar ─────────────────────────────────────────────────── */
.top-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(8px);
}
.top-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  height: 56px;
}
.logo-area { display: flex; align-items: center; gap: 10px; }
.logo-icon  { font-size: 22px; }
.logo-text  { font-size: 16px; font-weight: 700; color: var(--accent); letter-spacing: -0.3px; }
.logo-sub   { font-size: 11px; color: var(--text-muted); background: var(--bg-card);
               padding: 2px 8px; border-radius: 20px; border: 1px solid var(--border); }

.status-area { display: flex; align-items: center; gap: 10px; }
.status-dot  { width: 9px; height: 9px; border-radius: 50%; background: var(--text-muted);
                transition: background 0.3s; box-shadow: 0 0 0 0 transparent; }
.status-dot.online  { background: var(--ok-color); box-shadow: 0 0 8px var(--ok-color); animation: pulse 2s infinite; }
.status-dot.offline { background: var(--crit-color); }
.status-label { font-size: 13px; font-weight: 500; color: var(--text-secondary); }
.refresh-label { font-size: 11px; color: var(--text-muted); background: var(--bg-card);
                  padding: 2px 8px; border-radius: 20px; border: 1px solid var(--border); }

@keyframes pulse {
  0%   { box-shadow: 0 0 0 0 rgba(63,185,80,0.5); }
  70%  { box-shadow: 0 0 0 8px rgba(63,185,80,0); }
  100% { box-shadow: 0 0 0 0 rgba(63,185,80,0); }
}

/* ── Layout ──────────────────────────────────────────────────────────────── */
.layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  height: calc(100vh - 56px);
  overflow: hidden;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
.sidebar {
  background: var(--bg-elevated);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  font-weight: 600;
  font-size: 13px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-card);
  color: var(--text-primary);
}
.badge {
  background: var(--crit-bg);
  color: var(--crit-color);
  border: 1px solid var(--crit-color);
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  padding: 1px 7px;
  min-width: 22px;
  text-align: center;
}

.alert-feed {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.alert-feed::-webkit-scrollbar { width: 4px; }
.alert-feed::-webkit-scrollbar-track { background: transparent; }
.alert-feed::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

.alert-empty { color: var(--text-muted); font-size: 12px; text-align: center; padding: 24px 0; }

.alert-item {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius);
  padding: 10px 12px;
  transition: border-color 0.2s;
}
.alert-item:hover { border-color: var(--border); }
.alert-item.info     { border-left: 3px solid var(--info-color); }
.alert-item.warning  { border-left: 3px solid var(--warn-color); }
.alert-item.critical { border-left: 3px solid var(--crit-color); background: #1c0f0f; }

.alert-ts    { font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); }
.alert-level { font-size: 10px; font-weight: 700; letter-spacing: 0.5px; margin: 2px 0; }
.alert-item.info     .alert-level { color: var(--info-color); }
.alert-item.warning  .alert-level { color: var(--warn-color); }
.alert-item.critical .alert-level { color: var(--crit-color); }
.alert-msg  { font-size: 12px; color: var(--text-primary); word-break: break-word; }
.alert-src  { font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); margin-top: 4px;
               word-break: break-all; }

/* ── Main Content ────────────────────────────────────────────────────────── */
.main-content {
  overflow-y: auto;
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.main-content::-webkit-scrollbar { width: 6px; }
.main-content::-webkit-scrollbar-track { background: transparent; }
.main-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

/* ── Stats Cards ─────────────────────────────────────────────────────────── */
.stats-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
}
.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 16px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: transform 0.15s, border-color 0.2s;
}
.stat-card:hover { transform: translateY(-2px); border-color: var(--border); }
.stat-icon  { font-size: 24px; filter: grayscale(0.2); }
.stat-value { font-size: 26px; font-weight: 700; line-height: 1; }
.stat-label { font-size: 11px; color: var(--text-muted); font-weight: 500; margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px; }

.stat-card.total    { border-top: 2px solid var(--accent); }
.stat-card.info     { border-top: 2px solid var(--info-color); }
.stat-card.info     .stat-value { color: var(--info-color); }
.stat-card.warning  { border-top: 2px solid var(--warn-color); }
.stat-card.warning  .stat-value { color: var(--warn-color); }
.stat-card.critical { border-top: 2px solid var(--crit-color); }
.stat-card.critical .stat-value { color: var(--crit-color); }
.stat-card.tampered { border-top: 2px solid #a371f7; }
.stat-card.tampered .stat-value { color: #a371f7; }

/* ── Filter Bar ──────────────────────────────────────────────────────────── */
.filter-bar {
  display: flex;
  gap: 10px;
  align-items: center;
}
.filter-input {
  flex: 1;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-primary);
  padding: 8px 14px;
  font-family: var(--font-main);
  font-size: 13px;
  outline: none;
  transition: border-color 0.2s;
}
.filter-input:focus { border-color: var(--accent); }
.filter-input::placeholder { color: var(--text-muted); }

.filter-select {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-primary);
  padding: 8px 12px;
  font-size: 13px;
  outline: none;
  cursor: pointer;
  min-width: 140px;
  transition: border-color 0.2s;
}
.filter-select:focus { border-color: var(--accent); }

.btn-refresh {
  background: var(--accent);
  color: #000;
  border: none;
  border-radius: var(--radius);
  padding: 8px 18px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
}
.btn-refresh:hover  { opacity: 0.85; transform: scale(1.02); }
.btn-refresh:active { transform: scale(0.98); }

/* ── Log Table Section ───────────────────────────────────────────────────── */
.table-section {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 300px;
}
.table-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--border);
}
.table-title { font-weight: 600; font-size: 14px; }
.table-meta  { font-size: 12px; color: var(--text-muted); }

.table-wrapper { overflow-x: auto; flex: 1; }
.table-wrapper::-webkit-scrollbar { height: 4px; }
.table-wrapper::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}
thead tr { background: var(--bg-base); }
th {
  text-align: left;
  padding: 10px 14px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
td {
  padding: 9px 14px;
  border-bottom: 1px solid var(--border-subtle);
  vertical-align: middle;
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
tbody tr { transition: background 0.1s; }
tbody tr:hover { background: var(--bg-hover); }
tbody tr:last-child td { border-bottom: none; }

/* Row tinting by level */
.row-info     { }
.row-warning  { background: rgba(210,153,34,0.04); }
.row-critical { background: rgba(248,81,73,0.06); }

.empty-row { text-align: center; color: var(--text-muted); padding: 40px; }

/* ── Inline Badges ───────────────────────────────────────────────────────── */
.badge-level {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 2px 8px;
  border-radius: 20px;
  text-transform: uppercase;
}
.badge-level.info     { background: var(--info-bg);  color: var(--info-color);  border: 1px solid var(--info-color);  }
.badge-level.warning  { background: var(--warn-bg);  color: var(--warn-color);  border: 1px solid var(--warn-color);  }
.badge-level.critical { background: var(--crit-bg);  color: var(--crit-color);  border: 1px solid var(--crit-color);  }

.integrity-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 20px;
}
.integrity-badge.intact      { background: var(--ok-bg);   color: var(--ok-color);   border: 1px solid var(--ok-color);   }
.integrity-badge.tampered    { background: var(--crit-bg); color: var(--crit-color); border: 1px solid var(--crit-color); }
.integrity-badge.unavailable { background: var(--bg-base); color: var(--text-muted); border: 1px solid var(--border);     }

.event-type { font-family: var(--font-mono); font-size: 11px; color: var(--text-secondary); }
.mono  { font-family: var(--font-mono); }
.hash  { font-size: 11px; color: var(--text-muted); cursor: default; }
.ts    { font-size: 11px; color: var(--text-muted); }
.path  { color: var(--text-primary); }

/* ── Pagination ──────────────────────────────────────────────────────────── */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  padding: 12px;
  border-top: 1px solid var(--border-subtle);
}
.pagination button {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  color: var(--text-primary);
  padding: 5px 14px;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 12px;
