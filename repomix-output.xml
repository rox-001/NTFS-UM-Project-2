 87:     # Check internal build/dist folders only if inside application base
 88:     if norm == _BASE_DIR_NORM or norm.startswith(_BASE_DIR_NORM + os.sep):
 89:         rel = os.path.relpath(norm, _BASE_DIR_NORM).replace("/", "\\")
 90:         top_segment = rel.split("\\")[0].lower()
 91:         if top_segment in {"build", "dist", "tools", "__pycache__", ".pytest_cache"}:
 92:             return True
