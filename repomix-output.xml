 198: <!-- ═════════════════════════════ JAVASCRIPT ══════════════════════════════ -->
 199: <script>
 200:   let currentPage     = 1;
 201:   let refreshTimer    = null;
 202:   let isConnected     = false;
 203:   let currentLogs     = [];
 204:   let currentAlerts   = [];
 205:   let selectedEventId = null;
 206:   let currentSortBy   = "timestamp";
 207:   let currentOrder    = "desc";
 208: 
 209:   // ── Fetch everything ────────────────────────────────────────────────────
 210:   async function fetchAll() {
 211:     await Promise.all([fetchStats(), fetchLogs(), fetchAlerts()]);
 212:   }
 213: 
 214:   // ── Stats ────────────────────────────────────────────────────────────────
 215:   async function fetchStats() {
 216:     try {
 217:       let url = `/api/stats?timeframe=${encodeURIComponent(activeTimePreset)}`;
 218:       if (activeStartTime) url += `&start_time=${encodeURIComponent(activeStartTime)}`;
 219:       if (activeEndTime)   url += `&end_time=${encodeURIComponent(activeEndTime)}`;
 220:       const res  = await fetch(url);
 221:       const data = await res.json();
 222:       document.getElementById("statTotal").textContent    = data.total    ?? 0;
 223:       document.getElementById("statInfo").textContent     = data.info     ?? 0;
 224:       document.getElementById("statWarning").textContent  = data.warning  ?? 0;
 225:       document.getElementById("statCritical").textContent = data.critical  ?? 0;
 226:       document.getElementById("statTampered").textContent = data.integrity_tampered ?? 0;
 227:       setConnected(true);
 228:     } catch (e) {
 229:       setConnected(false);
 230:     }
 231:   }
 232: 
 233:   // ── Sorting Handlers ─────────────────────────────────────────────────────
 234:   function toggleSort(col) {
