 40: def _console_print(level: str, message: str):
 41:     """Print a color-coded line to the console safely across all Windows code pages."""
 42:     color  = _LEVEL_COLORS.get(level, Fore.WHITE)
 43:     prefix = _LEVEL_PREFIX.get(level, "[?]       ")
