280: def calculate_risk_score(
281:     event_type: str,
282:     src_path: str,
283:     dest_path: str = "",
284:     process_name: str = "",
285:     dlp_bonus: int = 0,
286: ) -> tuple[int, str]:
287:     """
288:     Calculate a normalized 0-100 risk score and mapped severity level:
289:       Score = FileSensitivity (0-35) + DestinationRisk (0-30) + ProcessRisk (0-20) + DLPBonus (0-15) + OffHours (0-10)
290:     """
291:     score = 0
292:     src_sens = is_sensitive_file(src_path)
293:     dest_sens = is_sensitive_file(dest_path) if dest_path else False
294:     is_sens = src_sens or dest_sens
295: 
296:     # 1. File Sensitivity (0 to 35)
297:     if is_sens:
298:         basename = os.path.basename(src_path).lower()
299:         _, ext = os.path.splitext(basename)
300:         if ext in {".pem", ".key", ".env", ".pfx", ".p12", ".kdbx"} or basename in {".env"}:
301:             score += 35
302:         else:
303:             score += 25
304:     else:
305:         score += 5
306: 
307:     # 2. Destination / Location Risk (0 to 30)
308:     if dest_path:
309:         if is_suspicious_destination(dest_path) or is_cloud_or_removable_location(dest_path):
310:             score += 30
311:         elif event_type in ("MOVED", "MOVED_DIR"):
312:             score += 10
313:     else:
314:         if is_cloud_or_removable_location(src_path):
315:             score += 20
316: 
317:     # 3. Process Risk (0 to 20)
318:     proc_lower = (process_name or "").lower()
319:     suspicious_procs = {"powershell.exe", "pwsh.exe", "cmd.exe", "curl.exe", "wget.exe", "python.exe", "wscript.exe", "cscript.exe", "certutil.exe", "bitsadmin.exe"}
320:     if proc_lower in suspicious_procs:
321:         score += 20
322:     elif proc_lower in {"explorer.exe", "devenv.exe", "code.exe"}:
323:         score += 0
324:     elif proc_lower and proc_lower != "system / background":
325:         score += 10
326:     else:
327:         score += 5
328: 
329:     # 4. DLP Content Regex Hits (0 to 15)
330:     score += min(15, max(0, dlp_bonus))
331: 
332:     # 5. Off-Hours Anomaly (0 to 10) - (23:00 to 06:00 local time)
333:     import datetime
334:     current_hour = datetime.datetime.now().hour
335:     if current_hour >= 23 or current_hour < 6:
336:         score += 10
337: 
338:     # Cap score at 100
339:     score = min(100, max(0, score))
340: 
341:     if score >= 70:
342:         level = "CRITICAL"
343:     elif score >= 40:
344:         level = "WARNING"
345:     else:
346:         level = "INFO"
347: 
348:     # Align with classic classify_event for safety
349:     classic_level = classify_event(event_type, src_path, dest_path)
350:     if classic_level == "CRITICAL":
351:         level = "CRITICAL"
352:         score = max(score, 75)
353:     elif classic_level == "WARNING" and level == "INFO":
354:         level = "WARNING"
355:         score = max(score, 45)
356:     elif classic_level == "INFO" and not is_sens and not dest_path and not dlp_bonus:
357:         level = "INFO"
358:         score = min(score, 35)
359: 
360:     return score, level
