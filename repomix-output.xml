213:                 old_timer.cancel()
214: 
215:             timer = threading.Timer(0.35, self._flush_deletion, args=[src_path, pre_hash])
216:             _pending_delete_timers[basename] = timer
217:             _pending_deletions[basename] = (time.monotonic(), src_path, pre_hash)
218:             timer.start()
219: 
220:     def _flush_deletion(self, src_path: str, pre_hash: str | None):
221:         """Callback when deletion timer expires without a matching creation (true delete)."""
222:         basename = os.path.basename(os.path.normcase(src_path)).lower()
223:         with _debounce_lock:
224:             _pending_deletions.pop(basename, None)
225:             _pending_delete_timers.pop(basename, None)
226:         self._process_event("DELETED", src_path, pre_hash_override=pre_hash)
227: 
228:     def _process_event(self, event_type: str, src_path: str, dest_path: str = "", pre_hash_override: str | None = None):
229:         if _should_ignore_path(src_path):
230:             return
231:         if dest_path and _should_ignore_path(dest_path):
232:             return
233: 
234:         target_path = dest_path if (event_type == "MOVED" and dest_path) else src_path
235:         if _is_burst_duplicate(event_type, target_path):
236:             return
237: 
238:         user    = _get_current_user()
239:         process = _get_process_name()
240: 
241:         # Step 3: Classify severity
242:         level = detector.classify_event(event_type, src_path, dest_path)
243: 
244:         # Step 4: Integrity hashing with baseline registry
245:         if pre_hash_override is not None:
246:             pre_hash = pre_hash_override
247:         else:
248:             pre_hash = hasher.get_baseline_hash(src_path)
249: 
250:         if event_type in ("CREATED", "CREATED_DIR"):
251:             post_hash = hasher.compute_hash(src_path) if os.path.exists(src_path) else None
252:             if not pre_hash and post_hash:
253:                 pre_hash = post_hash
254:             if post_hash:
255:                 hasher.set_baseline_hash(src_path, post_hash)
256:                 diff_tracker.record_initial_state(src_path)
257:             integrity_status = "INTACT" if post_hash else "UNAVAILABLE"
258: 
259:         elif event_type == "MODIFIED":
260:             post_hash = hasher.compute_hash(src_path) if os.path.exists(src_path) else None
261:             if pre_hash and post_hash:
262:                 _, integrity_status = hasher.verify_integrity(pre_hash, post_hash)
263:             elif post_hash:
264:                 integrity_status = "INTACT"
265:             else:
266:                 integrity_status = "UNAVAILABLE"
267:             if post_hash:
268:                 hasher.set_baseline_hash(src_path, post_hash)
269: 
270:         elif event_type in ("MOVED", "MOVED_DIR"):
271:             post_hash = hasher.compute_hash(dest_path) if (dest_path and os.path.exists(dest_path)) else None
272:             hasher.remove_baseline_hash(src_path)
273:             if dest_path and post_hash:
274:                 hasher.set_baseline_hash(dest_path, post_hash)
275:             if pre_hash and post_hash:
276:                 _, integrity_status = hasher.verify_integrity(pre_hash, post_hash)
277:             elif post_hash:
278:                 integrity_status = "INTACT"
279:             else:
280:                 integrity_status = "UNAVAILABLE"
281: 
282:         elif event_type in ("DELETED", "DELETED_DIR"):
283:             post_hash = None
284:             hasher.remove_baseline_hash(src_path)
285:             integrity_status = "INTACT" if pre_hash else "UNAVAILABLE"
286: 
287:         else:
288:             post_hash = hasher.compute_hash(src_path) if os.path.exists(src_path) else None
289:             _, integrity_status = hasher.verify_integrity(pre_hash, post_hash)
290: 
291:         # Step 5: Diff & Content change calculation
292:         diff_data = diff_tracker.compute_file_diff(event_type, src_path, dest_path)
293: 
294:         # Step 6: Exfiltration correlation (F-01)
295:         basename = os.path.basename(src_path)
296:         now = time.monotonic()
297: 
298:         # Track sensitive deletions
299:         if event_type == "DELETED" and detector.is_sensitive_file(src_path):
300:             with _debounce_lock:
301:                 _recent_deletions[basename.lower()] = (now, src_path, pre_hash)
302: 
303:         # Correlate creation on removable / cloud destination
304:         correlation_note = ""
305:         if event_type in ("CREATED", "MOVED"):
306:             dest_check = dest_path if dest_path else src_path
307:             if detector.is_suspicious_destination(dest_check):
308:                 with _debounce_lock:
309:                     match = _recent_deletions.get(basename.lower())
310:                     if match and (now - match[0]) < 10.0:
311:                         del_src = match[1]
312:                         level = "CRITICAL"
313:                         correlation_note = f" [Cross-Volume Exfiltration: moved/copied from '{del_src}']"
314: 
315:         # Step 7: Log event (with exact diff)
316:         logger.log_event(
317:             event_type       = event_type,
318:             source           = src_path,
319:             destination      = dest_path,
320:             user             = user,
321:             process          = process,
322:             hash_pre         = pre_hash,
323:             hash_post        = post_hash,
324:             integrity_status = integrity_status,
325:             alert_level      = level,
326:             extra            = {"diff": diff_data},
327:         )
328: 
329:         # Step 8: Trigger alert
330:         if level in ("WARNING", "CRITICAL"):
331:             description = detector.describe_event(event_type, src_path, dest_path) + correlation_note
332:             alerter.trigger_alert(
333:                 level      = level,
334:                 message    = description,
335:                 event_data = {
336:                     "event_type":       event_type,
337:                     "source":           src_path,
338:                     "destination":      dest_path,
339:                     "user":             user,
340:                     "process":          process,
341:                     "hash_pre":         pre_hash or "N/A",
342:                     "hash_post":        post_hash or "N/A",
343:                     "integrity_status": integrity_status,
344:                     "diff":             diff_data,
345:                 },
346:             )
347: 
348:     # ── Watchdog Callbacks (with Directory Expansion F-08 & Move Correlation) ─
349: 
350:     def on_created(self, event):
351:         if event.is_directory:
352:             self._process_event("CREATED_DIR", event.src_path)
353:             if os.path.isdir(event.src_path):
354:                 try:
355:                     for root, _, files in os.walk(event.src_path):
356:                         for f in files:
357:                             self._process_event("CREATED", os.path.join(root, f))
358:                 except OSError:
359:                     pass
360:         else:
361:             basename = os.path.basename(os.path.normcase(event.src_path)).lower()
362:             with _debounce_lock:
363:                 pending = _pending_deletions.pop(basename, None)
364:                 timer = _pending_delete_timers.pop(basename, None)
365:                 if timer:
366:                     timer.cancel()
367: 
368:             if pending and pending[1] != event.src_path:
369:                 # Correlated cross-directory move!
370:                 orig_src = pending[1]
371:                 orig_pre_hash = pending[2]
372:                 self._process_event("MOVED", orig_src, event.src_path, pre_hash_override=orig_pre_hash)
373:             else:
374:                 self._process_event("CREATED", event.src_path)
375: 
376:     def on_modified(self, event):
377:         if not event.is_directory:
378:             self._process_event("MODIFIED", event.src_path)
379: 
380:     def on_deleted(self, event):
381:         if event.is_directory:
382:             self._process_event("DELETED_DIR", event.src_path)
383:         else:
384:             self._buffer_or_process_deletion(event.src_path)
385: 
386:     def on_moved(self, event):
387:         basename = os.path.basename(os.path.normcase(event.src_path)).lower()
388:         with _debounce_lock:
389:             timer = _pending_delete_timers.pop(basename, None)
390:             if timer:
391:                 timer.cancel()
392:             _pending_deletions.pop(basename, None)
393: 
394:         if event.is_directory:
395:             self._process_event("MOVED_DIR", event.src_path, event.dest_path)
396:             if os.path.isdir(event.dest_path):
397:                 try:
398:                     for root, _, files in os.walk(event.dest_path):
399:                         for f in files:
400:                             dest_f = os.path.join(root, f)
401:                             rel = os.path.relpath(dest_f, event.dest_path)
402:                             src_f = os.path.join(event.src_path, rel)
403:                             self._process_event("MOVED", src_f, dest_f)
404:                 except OSError:
405:                     pass
406:         else:
407:             self._process_event("MOVED", event.src_path, event.dest_path)
408: 
409: 
410: class FileMonitor:
411:     """
412:     Manages watchdog Observer instances with auto-discovered directories,
413:     baseline seeding, and background USB/removable media polling.
414:     """
415: 
416:     def __init__(self, directories: list[str] | None = None):
417:         self.observer = Observer()
418:         self._running = False
419:         self._stop_event = threading.Event()
420:         self.event_handler = SecureTransferEventHandler()
421:         self.directories = directories if directories is not None else get_auto_discovered_targets()
422:         self._scheduled_paths: set[str] = set()
423: 
424:     def _seed_baseline(self):
425:         """Index existing files in monitored folders to populate baseline hashes and diff caches."""
426:         try:
427:             for d in self.directories:
428:                 expanded = os.path.expandvars(d)
429:                 if not os.path.isdir(expanded):
430:                     continue
431:                 for root, _, files in os.walk(expanded):
432:                     if _should_ignore_path(root):
433:                         continue
434:                     for f in files:
435:                         fp = os.path.join(root, f)
436:                         if not _should_ignore_path(fp):
437:                             try:
438:                                 hasher.set_baseline_hash(fp)
439:                                 diff_tracker.record_initial_state(fp)
440:                             except Exception:
441:                                 pass
442:         except Exception:
443:             pass
444: 
445:     def start(self):
446:         """Schedule watchers for all discovered directories and start observer."""
447:         scheduled = 0
448:         for directory in self.directories:
449:             directory = os.path.expandvars(directory)
450:             if os.path.isdir(directory):
451:                 norm = os.path.normcase(os.path.normpath(directory))
452:                 if norm not in self._scheduled_paths:
453:                     try:
454:                         self.observer.schedule(
455:                             self.event_handler,
456:                             path      = directory,
457:                             recursive = True,
458:                         )
459:                         self._scheduled_paths.add(norm)
460:                         print(f"  [+] Watching: {directory}")
461:                         scheduled += 1
462:                     except Exception as e:
463:                         print(f"  [-] Could not watch {directory}: {e}")
464:             else:
465:                 print(f"  [-] Skipped (not found): {directory}")
466: 
467:         if scheduled == 0:
468:             print("[WARNING] No valid directories to monitor. Edit config.py to add paths.")
469:             return
470: 
471:         self.observer.start()
472:         self._running = True
473:         print(f"\n  Monitoring {scheduled} director(ies) & cloud/removable drives. Press Ctrl+C to stop.\n")
474: 
475:         # Start dynamic USB/removable drive attachment watcher
476:         poll_thread = threading.Thread(target=self._poll_new_drives, daemon=True)
477:         poll_thread.start()
478: 
479:         # Seed baseline hashes and diff caches in background
480:         seed_thread = threading.Thread(target=self._seed_baseline, daemon=True)
481:         seed_thread.start()
482: 
483:     def _poll_new_drives(self):
484:         """Polls periodically for newly plugged-in USB or network drives."""
485:         while not self._stop_event.is_set():
486:             time.sleep(5.0)
487:             if not self._running:
488:                 break
489:             discovered = get_auto_discovered_targets()
490:             for d in discovered:
491:                 norm = os.path.normcase(os.path.normpath(d))
492:                 if norm not in self._scheduled_paths and os.path.isdir(d):
493:                     try:
494:                         self.observer.schedule(self.event_handler, path=d, recursive=True)
495:                         self._scheduled_paths.add(norm)
496:                         print(f"  [+] Auto-detected & watching new target: {d}")
497:                     except Exception:
498:                         pass
499: 
500:     def stop(self):
501:         """Gracefully stop observer, timers, and polling threads."""
502:         if self._running:
503:             self._stop_event.set()
504:             with _debounce_lock:
505:                 for timer in _pending_delete_timers.values():
506:                     timer.cancel()
507:                 _pending_delete_timers.clear()
508:                 _pending_deletions.clear()
509:             self.observer.stop()
510:             self.observer.join(timeout=1.0)
511:             self._running = False
512:             print("\n  Monitor stopped. Goodbye.")
513: 
514:     def is_running(self) -> bool:
515:         return self._running
