262:                         entry.get("destination", ""),
263:                         entry.get("event_type", ""),
264:                         entry.get("user", ""),
265:                         entry.get("process", ""),
266:                         str(entry.get("cmdline", "")),
267:                         str(entry.get("dlp_summary", ""))
268:                     ]).lower()
269:                     if not all(term in combined_text for term in free_text_terms):
270:                         continue
271: 
272:                 entries.append(entry)
273:             except json.JSONDecodeError:
274:                 continue
275: 
276:     # Apply sorting if requested
277:     if sort_by:
278:         s = sort_by.lower()
279:         if s in ("timestamp", "date"):
280:             key_fn = lambda e: e.get("timestamp", "")
281:         elif s in ("level", "alert_level", "severity"):
282:             key_fn = lambda e: _ALERT_LEVEL_WEIGHT.get(e.get("alert_level", "").upper(), 0)
283:         elif s in ("risk", "risk_score"):
284:             key_fn = lambda e: e.get("risk_score", 0)
285:         elif s in ("source", "directory", "dir", "path"):
286:             key_fn = lambda e: e.get("source", "").lower()
287:         elif s in ("destination", "dest"):
288:             key_fn = lambda e: e.get("destination", "").lower()
289:         elif s in ("event", "event_type"):
290:             key_fn = lambda e: e.get("event_type", "").lower()
291:         elif s in ("ext", "extension", "file_type"):
292:             key_fn = lambda e: os.path.splitext(e.get("source", ""))[1].lower()
293:         elif s in ("integrity", "integrity_status"):
294:             key_fn = lambda e: e.get("integrity_status", "").lower()
295:         else:
296:             key_fn = lambda e: e.get("timestamp", "")
