 67: def is_sensitive_file(path: str) -> bool:
 68:     """
 69:     Return True if the file path has a sensitive extension
 70:     or resides inside a configured sensitive directory.
 71:     Supports dotfiles (.env), sub-extensions (secret.pem.tmp), and full paths.
 72:     """
 73:     if not path:
 74:         return False
 75: 
 76:     norm = os.path.normpath(path)
 77:     basename = os.path.basename(norm).lower()
 78: 
 79:     # 1. Primary extension check
 80:     _, ext = os.path.splitext(norm)
 81:     if ext.lower() in _SENSITIVE_EXT_SET:
 82:         return True
 83: 
 84:     # 2. Dotfiles like ".env", ".cfg" where os.path.splitext treats the whole filename as stem
 85:     if basename in _SENSITIVE_EXT_SET:
 86:         return True
 87: 
 88:     # 3. Double-extension check (e.g. secret.pem.tmp -> check if stem 'secret.pem' is sensitive)
 89:     stem, sub_ext = os.path.splitext(basename)
 90:     if sub_ext in {".tmp", ".part", ".crdownload", ".bak", ".swp", ".lock"}:
 91:         _, inner_ext = os.path.splitext(stem)
 92:         if inner_ext in _SENSITIVE_EXT_SET or stem in _SENSITIVE_EXT_SET:
 93:             return True
 94: 
 95:     # 4. Check if path resides inside a sensitive directory
 96:     norm_path = os.path.normcase(norm)
 97:     for sensitive_dir in SENSITIVE_DIRECTORIES:
 98:         if sensitive_dir:
 99:             norm_sens = os.path.normcase(os.path.normpath(os.path.abspath(sensitive_dir)))
100:             if norm_path == norm_sens or norm_path.startswith(norm_sens.rstrip(os.sep) + os.sep):
101:                 return True
102: 
103:     return False
