  1: """
  2: monitor.py - Filesystem Event Monitor (Watchdog-based)
  3: Detects file create/modify/move/delete events across configured directories.
  4: Orchestrates the full pipeline: detect → hash → log → alert.
  5: Includes noise-filtering, write-burst debouncing, directory recursion, and exfiltration correlation.
  6: """
  7: 
  8: from __future__ import annotations
  9: 
 10: import os
 11: import sys
 12: import time
 13: import getpass
 14: import threading
 15: 
 16: from watchdog.observers import Observer
 17: from watchdog.events import FileSystemEventHandler
 18: 
 19: try:
 20:     import psutil
 21:     PSUTIL_AVAILABLE = True
 22: except ImportError:
 23:     PSUTIL_AVAILABLE = False
 24: 
 25: from config import (
 26:     MONITORED_DIRECTORIES,
 27:     ENABLE_PROCESS_TRACKING,
 28:     BASE_DIR,
 29:     LOG_DIR,
 30:     REPORT_DIR,
 31:     IGNORED_EXTENSIONS,
 32:     IGNORED_FILENAMES,
 33:     get_auto_discovered_targets,
 34: )
 35: import hasher
 36: import detector
 37: import logger
 38: import alerter
 39: import diff_tracker
 40: import db
 41: import process_tracker
 42: import dlp_scanner
 43: 
 44: 
 45: # Pre-calculate normalized directory paths
 46: _LOG_DIR_NORM = os.path.normcase(os.path.normpath(os.path.abspath(LOG_DIR)))
 47: _REPORT_DIR_NORM = os.path.normcase(os.path.normpath(os.path.abspath(REPORT_DIR)))
 48: _BASE_DIR_NORM = os.path.normcase(os.path.normpath(os.path.abspath(BASE_DIR)))
 49: 
 50: _IGNORED_EXTS_SET = frozenset(ext.lower() for ext in IGNORED_EXTENSIONS)
 51: _IGNORED_NAMES_SET = frozenset(name.lower() for name in IGNORED_FILENAMES)
 52: 
 53: # Debounce & Burst Filtering
 54: _DEBOUNCE_WINDOW = 0.8         # Seconds to absorb OS chunked write-buffer flushes
 55: _RECENT_CREATION_WINDOW = 1.0  # Seconds to absorb immediate post-create writes
 56: 
 57: _recent_events: dict[str, float] = {}       # key: "EVENT_TYPE:norm_path" -> timestamp
 58: _recent_creations: dict[str, float] = {}    # key: "norm_path" -> timestamp
 59: _recent_file_sizes: dict[str, int] = {}     # key: "norm_path" -> last known size
 60: _recent_deletions: dict[str, tuple[float, str, str | None]] = {}  # basename -> (time, src_path, hash)
 61: _pending_deletions: dict[str, tuple[float, str, str | None]] = {} # basename -> (time, src_path, pre_hash)
 62: _pending_delete_timers: dict[str, threading.Timer] = {}           # basename -> Timer
 63: 
 64: _debounce_lock = threading.Lock()
 65: 
 66: 
 67: def _should_ignore_path(path: str) -> bool:
 68:     """
 69:     Return True if the file should be ignored:
 70:       - Internal application folders (logs/, reports/, build/, dist/, .git/)
 71:       - Zero-length system/lock files (desktop.ini, thumbs.db)
 72:       - Temporary non-sensitive download fragments
 73:     Does NOT drop files with sensitive double extensions (secret.pem.tmp).
 74:     Does NOT ignore sibling folders (Downloads2) or .github folders.
 75:     """
 76:     if not path:
 77:         return True
 78: 
 79:     norm = os.path.normcase(os.path.normpath(os.path.abspath(path)))
 80: 
 81:     # 1. Ignore application runtime folders with trailing separator
 82:     if norm == _LOG_DIR_NORM or norm.startswith(_LOG_DIR_NORM + os.sep):
 83:         return True
 84:     if norm == _REPORT_DIR_NORM or norm.startswith(_REPORT_DIR_NORM + os.sep):
 85:         return True
