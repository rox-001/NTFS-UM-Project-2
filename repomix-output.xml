 802:   function formatVaultTime(ts) {
 803:     if (!ts) return "—";
 804:     if (typeof ts === "number") {
 805:       return new Date(ts * 1000).toLocaleString();
 806:     }
 807:     const d = new Date(ts);
 808:     if (!isNaN(d.getTime())) {
 809:       return d.toLocaleString();
 810:     }
 811:     return String(ts).replace("T", " ").slice(0, 19);
