 402:   function renderFormattedDiff(snippet) {
 403:     if (!snippet) return "";
 404:     const lines = snippet.split("\n");
 405:     return lines.map(line => {
 406:       const escaped = escapeHtml(line);
 407:       if (line.startsWith("+++") || line.startsWith("---") || line.startsWith("@@")) {
 408:         return `<span class="diff-line-meta">${escaped}</span>`;
 409:       } else if (line.startsWith("+")) {
 410:         return `<span class="diff-line-add">${escaped}</span>`;
 411:       } else if (line.startsWith("-")) {
 412:         return `<span class="diff-line-del">${escaped}</span>`;
 413:       }
 414:       return `<span class="diff-line-ctx">${escaped}</span>`;
 415:     }).join("\n");
 416:   }
