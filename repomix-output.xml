474: class FileMonitor:
475:     """
476:     Manages watchdog Observer instances with persistent SQLite directory tracking,
477:     dynamic on-the-fly folder addition/removal, baseline seeding, and USB polling.
478:     """
479: 
480:     def __init__(self, directories: list[str] | None = None):
481:         global _active_monitor
482:         _active_monitor = self
483: 
484:         self.observer = Observer()
485:         self._running = False
486:         self._stop_event = threading.Event()
487:         self.event_handler = SecureTransferEventHandler()
488: 
489:         # Combine user-defined database directories with system auto-discovery
490:         db_dirs = db.get_monitored_directories()
491:         discovered = get_auto_discovered_targets()
492:         initial_set = set(directories) if directories is not None else (set(db_dirs) | set(discovered))
493:         self.directories = sorted(list(initial_set))
494: 
495:         self._scheduled_paths: set[str] = set()
496:         self._watches: dict[str, object] = {}
497: 
498:     def _seed_baseline(self, target_dirs: list[str] = None):
499:         """Index existing files in monitored folders to populate baseline hashes and diff caches."""
500:         dirs_to_seed = target_dirs if target_dirs else self.directories
501:         try:
502:             for d in dirs_to_seed:
503:                 expanded = os.path.expandvars(d)
504:                 if not os.path.isdir(expanded):
505:                     continue
506:                 for root, _, files in os.walk(expanded):
507:                     if _should_ignore_path(root):
508:                         continue
509:                     for f in files:
510:                         fp = os.path.join(root, f)
511:                         if not _should_ignore_path(fp):
512:                             try:
513:                                 hasher.set_baseline_hash(fp)
514:                                 diff_tracker.record_initial_state(fp)
515:                             except Exception:
516:                                 pass
517:         except Exception:
518:             pass
519: 
520:     def add_directory(self, directory: str) -> bool:
521:         """
522:         Dynamically schedule a new directory watch on the fly
523:         and persist it to the SQLite database.
524:         """
525:         if not directory or not os.path.isdir(directory):
526:             return False
527: 
528:         norm = os.path.normcase(os.path.normpath(os.path.abspath(directory)))
529:         db.add_monitored_directory(norm)
530: 
531:         if norm not in self.directories:
532:             self.directories.append(norm)
533: 
534:         if self._running and norm not in self._scheduled_paths:
535:             try:
536:                 watch = self.observer.schedule(
537:                     self.event_handler,
538:                     path=norm,
539:                     recursive=True,
540:                 )
541:                 self._scheduled_paths.add(norm)
542:                 self._watches[norm] = watch
543:                 print(f"  [+] Dynamically watching new directory: {norm}")
544: 
545:                 # Index newly added folder in background
546:                 threading.Thread(target=self._seed_baseline, args=[[norm]], daemon=True).start()
547:                 return True
548:             except Exception as e:
549:                 print(f"  [-] Failed to watch {norm}: {e}")
550:                 return False
551:         return True
552: 
553:     def remove_directory(self, directory: str) -> bool:
554:         """
555:         Dynamically unschedule a monitored directory and remove it from SQLite.
556:         """
557:         if not directory:
558:             return False
559: 
560:         norm = os.path.normcase(os.path.normpath(os.path.abspath(directory)))
561:         db.remove_monitored_directory(norm)
562: 
563:         if norm in self.directories:
564:             self.directories.remove(norm)
565: 
566:         if self._running and norm in self._watches:
567:             try:
568:                 watch = self._watches.pop(norm)
569:                 self.observer.unschedule(watch)
570:                 self._scheduled_paths.discard(norm)
571:                 print(f"  [-] Unscheduled directory: {norm}")
572:                 return True
573:             except Exception as e:
574:                 print(f"  [-] Error unscheduling {norm}: {e}")
575:                 return False
576:         return True
577: 
578:     def get_monitored_directories(self) -> list[dict]:
579:         """Return the list of active monitored directories and their source classification."""
580:         custom_db = set(db.get_monitored_directories())
581:         results = []
582:         for d in self.directories:
583:             norm = os.path.normcase(os.path.normpath(os.path.abspath(d)))
584:             is_active = norm in self._scheduled_paths if self._running else os.path.isdir(d)
585:             results.append({
586:                 "path": d,
587:                 "is_active": is_active,
588:                 "is_custom": norm in custom_db,
589:             })
590:         return results
