 20: def get_auto_discovered_targets() -> list[str]:
 21:     """
 22:     Dynamically discover all relevant monitoring targets:
 23:       1. Default user folders (Desktop, Documents, Downloads).
 24:       2. OneDrive redirected folders (e.g. %OneDrive%\\Desktop).
 25:       3. Active Cloud-sync roots (Dropbox, Google Drive, iCloud, Nextcloud).
 26:       4. Active Removable Media (USB flash drives, external drives).
 27:     """
 28:     targets: set[str] = set()
 29: 
 30:     # 1. Base user profile paths
 31:     for p in DEFAULT_MONITORED_DIRECTORIES:
 32:         expanded = os.path.normpath(os.path.abspath(os.path.expanduser(p)))
 33:         if os.path.isdir(expanded):
 34:             targets.add(expanded)
 35: 
 36:     user_home = os.path.expanduser("~")
 37: 
 38:     # 2. Known cloud sync directories
 39:     cloud_candidates = [
 40:         os.environ.get("OneDrive"),
 41:         os.environ.get("OneDriveConsumer"),
 42:         os.environ.get("OneDriveCommercial"),
 43:         os.path.join(user_home, "Dropbox"),
 44:         os.path.join(user_home, "Google Drive"),
 45:         os.path.join(user_home, "iCloudDrive"),
 46:         os.path.join(user_home, "Box"),
 47:         os.path.join(user_home, "Nextcloud"),
 48:     ]
 49: 
 50:     for candidate in cloud_candidates:
 51:         if candidate and os.path.isdir(candidate):
 52:             targets.add(os.path.normpath(os.path.abspath(candidate)))
 53: 
 54:     # 3. Dynamic Windows Removable Drive Discovery (USB drives, network drives)
 55:     if sys.platform == "win32":
 56:         try:
 57:             import ctypes
 58:             # GetLogicalDrives returns a bitmask of available drives (bit 0 = A, bit 1 = B, etc.)
 59:             bitmask = ctypes.windll.kernel32.GetLogicalDrives()
 60:             for i in range(26):
 61:                 if bitmask & (1 << i):
 62:                     drive_letter = f"{chr(65 + i)}:\\"
 63:                     dtype = ctypes.windll.kernel32.GetDriveTypeW(drive_letter)
 64:                     # 2 = DRIVE_REMOVABLE (USB flash drives, SD cards)
 65:                     # 4 = DRIVE_REMOTE    (Mapped network drives)
 66:                     if dtype in (2, 4) and os.path.isdir(drive_letter):
 67:                         targets.add(os.path.normpath(drive_letter))
 68:         except Exception:
 69:             pass
