 94:     # 2. Version control and package directories (exact path segment matching)
 95:     parts = [p.lower() for p in norm.replace("/", "\\").split("\\") if p]
 96:     if any(p in {".git", "__pycache__", "node_modules", ".vscode"} for p in parts):
 97:         return True
