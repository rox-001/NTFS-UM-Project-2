  1: """
  2: alerter.py - Alert Generation & Policy Violation Notification
  3: Writes alerts to logs/alerts.log and prints to console (colorama).
  4: Supports desktop toast notification callbacks when running in Desktop App mode.
  5: Entirely local — no network dependency. Safe on Windows cp1252.
  6: """
  7: 
  8: import json
  9: import os
 10: import sys
 11: from datetime import datetime
 12: 
 13: from colorama import Fore, Back, Style, init as colorama_init
 14: 
 15: from config import ALERT_LOG_PATH, LOG_DIR
 16: 
 17: colorama_init(autoreset=True)
 18: os.makedirs(LOG_DIR, exist_ok=True)
 19: 
 20: # Console display prefix per level (pure ASCII safe)
 21: _LEVEL_STYLE = {
 22:     "INFO":     (Fore.CYAN,   "[INFO] "),
 23:     "WARNING":  (Fore.YELLOW, "[WARN] "),
 24:     "CRITICAL": (Fore.RED,    "[CRIT] "),
 25: }
 26: 
 27: # Optional desktop notification callback (registered by desktop app)
 28: _desktop_notifier = None
 29: 
 30: 
 31: def register_desktop_notifier(callback):
 32:     """Register a callback function to display native OS notifications."""
 33:     global _desktop_notifier
 34:     _desktop_notifier = callback
 35: 
 36: 
 37: def trigger_alert(level: str, message: str, event_data: dict = None, risk_score: int = 0):
 38:     """
 39:     Generate an alert at the specified severity level.
 40: 
 41:     - Writes to logs/alerts.log (JSON-line format)
 42:     - Prints a formatted, color-coded message to the console
 43:     - Prints a full banner for CRITICAL alerts
 44:     - Dispatches native OS notification if desktop mode is active
 45: 
 46:     Args:
 47:         level:      'INFO', 'WARNING', or 'CRITICAL'
 48:         message:    Human-readable alert summary
 49:         event_data: Optional dict of event context (source, destination, etc.)
 50:         risk_score: Numerical risk score (0-100)
 51:     """
 52:     ts = datetime.now().isoformat()
 53:     alert_entry = {
 54:         "timestamp":  ts,
 55:         "level":      level,
 56:         "risk_score": risk_score,
 57:         "message":    message,
 58:         "event_data": event_data or {},
 59:     }
 60: 
 61:     # Write to alerts log
 62:     with open(ALERT_LOG_PATH, "a", encoding="utf-8") as f:
 63:         f.write(json.dumps(alert_entry) + "\n")
 64: 
 65:     # Console output
 66:     color, icon = _LEVEL_STYLE.get(level, (Fore.WHITE, "[ALERT]"))
 67:     ts_short = datetime.now().strftime("%H:%M:%S")
 68: 
 69:     if level == "CRITICAL":
 70:         _print_critical_banner(message, event_data, ts_short, risk_score)
 71:     else:
 72:         out = f"{color}{ts_short} {icon} [{level} | Risk {risk_score:02d}] {message}{Style.RESET_ALL}"
 73:         try:
 74:             print(out)
 75:         except UnicodeEncodeError:
 76:             print(out.encode("ascii", errors="replace").decode("ascii"))
 77: 
 78:     # Native desktop toast notification for policy violations
 79:     if level in ("WARNING", "CRITICAL") and _desktop_notifier:
 80:         try:
 81:             _desktop_notifier(level, message, event_data or {})
 82:         except Exception:
 83:             pass
 84: 
 85: 
 86: def _print_critical_banner(message: str, event_data: dict, ts: str, risk_score: int = 0):
 87:     """Print a loud CRITICAL alert banner to the console."""
 88:     src  = event_data.get("source", "N/A")      if event_data else "N/A"
 89:     dest = event_data.get("destination", "N/A") if event_data else "N/A"
 90:     user = event_data.get("user", "N/A")        if event_data else "N/A"
 91: 
 92:     line = "=" * 62
 93:     banner = f"""
 94: {Fore.RED}{Back.BLACK}
 95: +{line}+
 96: |  [!]  CRITICAL SECURITY ALERT (RISK {risk_score:02d}/100)  {ts:>17}  |
 97: +{line}+
 98: |  {message[:60]:<60}  |
 99: |  User   : {user[:52]:<52}  |
100: |  Source : {src[:52]:<52}  |
101: |  Dest   : {dest[:52]:<52}  |
102: +{line}+
103: {Style.RESET_ALL}"""
104:     try:
105:         print(banner)
106:     except UnicodeEncodeError:
107:         print(banner.encode("ascii", errors="replace").decode("ascii"))
108: 
109: 
110: def load_alerts(limit: int = 50) -> list[dict]:
111:     """
112:     Read the most recent alert entries from alerts.log.
113: 
114:     Args:
115:         limit: Maximum number of alerts to return.
116: 
117:     Returns:
118:         List of alert dicts, most recent last.
119:     """
120:     if not os.path.exists(ALERT_LOG_PATH):
121:         return []
122: 
123:     alerts = []
124:     with open(ALERT_LOG_PATH, "r", encoding="utf-8") as f:
125:         for line in f:
126:             line = line.strip()
127:             if not line:
128:                 continue
129:             try:
130:                 alerts.append(json.loads(line))
131:             except json.JSONDecodeError:
132:                 continue
133: 
134:     return alerts[-limit:]
