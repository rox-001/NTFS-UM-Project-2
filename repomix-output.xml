 730:   function inspectAlert(alertIndex) {
 731:     const alertObj = currentAlerts[alertIndex];
 732:     if (!alertObj) return;
 733: 
 734:     let matchingIndex = -1;
 735:     const alertSrc = (alertObj.event_data && alertObj.event_data.source) || "";
 736:     const alertTs = (alertObj.timestamp || "").slice(0, 19);
 737: 
 738:     for (let i = 0; i < currentLogs.length; i++) {
 739:       const log = currentLogs[i];
 740:       if (log.source === alertSrc && (log.timestamp || "").slice(0, 19) === alertTs) {
 741:         matchingIndex = i;
 742:         break;
 743:       }
 744:     }
 745: 
 746:     if (matchingIndex === -1 && alertSrc) {
 747:       for (let i = 0; i < currentLogs.length; i++) {
 748:         if (currentLogs[i].source === alertSrc) {
 749:           matchingIndex = i;
 750:           break;
 751:         }
 752:       }
 753:     }
 754: 
 755:     if (matchingIndex !== -1) {
 756:       const tableRows = document.querySelectorAll("#logTable tbody tr");
 757:       const targetRow = tableRows[matchingIndex];
 758:       selectLogEvent(matchingIndex, targetRow);
 759:       if (targetRow) {
 760:         targetRow.scrollIntoView({ behavior: "smooth", block: "center" });
 761:       }
 762:     } else {
 763:       const synthEvent = {
 764:         timestamp: alertObj.timestamp,
 765:         alert_level: alertObj.level,
 766:         event_type: (alertObj.event_data && alertObj.event_data.event_type) || "ALERT",
 767:         source: alertSrc || "Unknown Source",
 768:         destination: (alertObj.event_data && alertObj.event_data.destination) || "",
 769:         user: (alertObj.event_data && alertObj.event_data.user) || "N/A",
 770:         process: (alertObj.event_data && alertObj.event_data.process) || "N/A",
 771:         hash_pre: (alertObj.event_data && alertObj.event_data.hash_pre) || "N/A",
 772:         hash_post: (alertObj.event_data && alertObj.event_data.hash_post) || "N/A",
 773:         integrity_status: (alertObj.event_data && alertObj.event_data.integrity_status) || "TAMPERED",
 774:         hash_algorithm: "SHA256",
 775:         diff: alertObj.event_data && alertObj.event_data.diff,
