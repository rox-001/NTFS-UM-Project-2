404: 
405:     def on_created(self, event):
406:         if event.is_directory:
407:             self._process_event("CREATED_DIR", event.src_path)
408:             if os.path.isdir(event.src_path):
409:                 try:
410:                     for root, _, files in os.walk(event.src_path):
411:                         for f in files:
412:                             self._process_event("CREATED", os.path.join(root, f))
413:                 except OSError:
414:                     pass
415:         else:
416:             basename = os.path.basename(os.path.normcase(event.src_path)).lower()
417:             with _debounce_lock:
418:                 pending = _pending_deletions.pop(basename, None)
419:                 timer = _pending_delete_timers.pop(basename, None)
420:                 if timer:
421:                     timer.cancel()
422: 
423:             if pending and pending[1] != event.src_path:
424:                 # Correlated cross-directory move!
425:                 orig_src = pending[1]
426:                 orig_pre_hash = pending[2]
427:                 self._process_event("MOVED", orig_src, event.src_path, pre_hash_override=orig_pre_hash)
428:             else:
429:                 self._process_event("CREATED", event.src_path)
430: 
431:     def on_modified(self, event):
432:         if not event.is_directory:
433:             self._process_event("MODIFIED", event.src_path)
434: 
435:     def on_deleted(self, event):
436:         if event.is_directory:
437:             self._process_event("DELETED_DIR", event.src_path)
438:         else:
439:             self._buffer_or_process_deletion(event.src_path)
440: 
441:     def on_moved(self, event):
442:         basename = os.path.basename(os.path.normcase(event.src_path)).lower()
443:         with _debounce_lock:
444:             timer = _pending_delete_timers.pop(basename, None)
445:             if timer:
446:                 timer.cancel()
447:             _pending_deletions.pop(basename, None)
448: 
449:         if event.is_directory:
450:             self._process_event("MOVED_DIR", event.src_path, event.dest_path)
451:             if os.path.isdir(event.dest_path):
452:                 try:
453:                     for root, _, files in os.walk(event.dest_path):
454:                         for f in files:
455:                             dest_f = os.path.join(root, f)
456:                             rel = os.path.relpath(dest_f, event.dest_path)
457:                             src_f = os.path.join(event.src_path, rel)
458:                             self._process_event("MOVED", src_f, dest_f)
459:                 except OSError:
460:                     pass
461:         else:
462:             self._process_event("MOVED", event.src_path, event.dest_path)
