120: def _is_burst_duplicate(event_type: str, path: str) -> bool:
121:     """
122:     Filter out duplicate OS buffer-flush events while allowing legitimate edits.
123:     """
124:     norm_path = os.path.normcase(os.path.normpath(os.path.abspath(path)))
125:     now = time.monotonic()
126: 
127:     with _debounce_lock:
128:         # If this is a MODIFIED event within 1.0s of CREATED, suppress it (initial buffer write)
129:         if event_type == "MODIFIED":
130:             last_created = _recent_creations.get(norm_path)
131:             if last_created is not None and (now - last_created) < _RECENT_CREATION_WINDOW:
132:                 return True
133: 
134:         event_key = f"{event_type}:{norm_path}"
135:         last_seen = _recent_events.get(event_key)
136:         if last_seen is not None and (now - last_seen) < _DEBOUNCE_WINDOW:
137:             return True
138: 
139:         # Record this event
140:         _recent_events[event_key] = now
141:         if event_type == "CREATED":
142:             _recent_creations[norm_path] = now
143: 
144:         # Periodic cache cleanup
145:         if len(_recent_events) > 800:
146:             cutoff = now - 10.0
147:             stale_keys = [k for k, t in _recent_events.items() if t < cutoff]
148:             for k in stale_keys:
149:                 del _recent_events[k]
150: 
151:             stale_creations = [p for p, t in _recent_creations.items() if t < cutoff]
152:             for p in stale_creations:
