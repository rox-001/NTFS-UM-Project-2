126: def _is_burst_duplicate(event_type: str, path: str) -> bool:
127:     """
128:     Filter out duplicate OS buffer-flush events while allowing legitimate edits.
129:     """
130:     norm_path = os.path.normcase(os.path.normpath(os.path.abspath(path)))
131:     now = time.monotonic()
132: 
133:     with _debounce_lock:
134:         # If this is a MODIFIED event within 1.0s of CREATED, suppress it (initial buffer write)
135:         if event_type == "MODIFIED":
136:             last_created = _recent_creations.get(norm_path)
137:             if last_created is not None and (now - last_created) < _RECENT_CREATION_WINDOW:
138:                 return True
139: 
140:         event_key = f"{event_type}:{norm_path}"
141:         last_seen = _recent_events.get(event_key)
142:         if last_seen is not None and (now - last_seen) < _DEBOUNCE_WINDOW:
143:             return True
144: 
145:         # Record this event
146:         _recent_events[event_key] = now
147:         if event_type == "CREATED":
148:             _recent_creations[norm_path] = now
149: 
150:         # Periodic cache cleanup
151:         if len(_recent_events) > 800:
152:             cutoff = now - 10.0
153:             stale_keys = [k for k, t in _recent_events.items() if t < cutoff]
154:             for k in stale_keys:
155:                 del _recent_events[k]
156: 
157:             stale_creations = [p for p, t in _recent_creations.items() if t < cutoff]
158:             for p in stale_creations:
159:                 del _recent_creations[p]
160: 
161:     return False
