193: def classify_event(event_type: str, src_path: str, dest_path: str = "") -> str:
194:     """
195:     Classify a filesystem event and return an alert level string ('INFO', 'WARNING', or 'CRITICAL').
196: 
197:     Classification logic:
198:     - CRITICAL: File transferred TO a suspicious destination (USB, Cloud, Network, Temp)
199:     - CRITICAL: Sensitive file CREATED or MODIFIED directly inside an exfiltration location (USB / Cloud Sync)
200:     - CRITICAL: Sensitive file MOVED or DELETED
201:     - WARNING:  Sensitive file CREATED or MODIFIED in normal monitored locations
202:     - INFO:     Normal files in normal locations
203:     """
204:     src_sensitive   = is_sensitive_file(src_path)
205:     dest_sensitive  = is_sensitive_file(dest_path) if dest_path else False
206:     is_sensitive    = src_sensitive or dest_sensitive
207: 
208:     dest_suspicious = is_suspicious_destination(dest_path) if dest_path else False
209: 
210:     # 1. Any file transferred TO a suspicious destination (USB, Cloud, Network, Temp staging)
211:     if dest_suspicious:
212:         return "CRITICAL"
213: 
214:     # 2. Sensitive file created/modified directly in a cloud-sync or removable media location (F-06)
215:     if is_sensitive and is_cloud_or_removable_location(src_path):
216:         return "CRITICAL"
217: 
218:     # 3. Sensitive file moved or deleted locally
219:     if is_sensitive:
220:         if event_type in ("MOVED", "DELETED"):
221:             return "CRITICAL"
222:         return "WARNING"
223: 
224:     # 4. Default
225:     return "INFO"
226: 
227: 
228: def describe_event(event_type: str, src_path: str, dest_path: str = "") -> str:
229:     """
230:     Generate a human-readable description of the event for logs and alerts.
231:     """
232:     basename = os.path.basename(src_path)
233:     descriptions = {
234:         "CREATED":     f"File created: '{basename}'",
235:         "MODIFIED":    f"File modified: '{basename}'",
236:         "DELETED":     f"File deleted: '{basename}'",
237:         "MOVED":       f"File moved: '{basename}' \u2192 '{dest_path}'",
238:         "DOWNLOADED":  f"File downloaded from internet: '{basename}'",
239:         "CREATED_DIR": f"Directory created: '{basename}'",
240:         "DELETED_DIR": f"Directory deleted: '{basename}'",
241:         "MOVED_DIR":   f"Directory moved: '{basename}' \u2192 '{dest_path}'",
242:     }
243:     return descriptions.get(event_type, f"Event {event_type} on '{basename}'")
