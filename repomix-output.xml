 49: # Debounce & Burst Filtering
 50: _DEBOUNCE_WINDOW = 0.8         # Seconds to absorb OS chunked write-buffer flushes
 51: _RECENT_CREATION_WINDOW = 1.0  # Seconds to absorb immediate post-create writes
 52: 
 53: _recent_events: dict[str, float] = {}       # key: "EVENT_TYPE:norm_path" -> timestamp
 54: _recent_creations: dict[str, float] = {}    # key: "norm_path" -> timestamp
 55: _recent_file_sizes: dict[str, int] = {}     # key: "norm_path" -> last known size
 56: _recent_deletions: dict[str, tuple[float, str, str | None]] = {}  # basename -> (time, src_path, hash)
