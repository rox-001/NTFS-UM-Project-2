 44: 
 45:     def test_f02_folder_named_templates_not_suspicious(self):
 46:         """Folder named 'Templates' should not be flagged as a temp folder."""
 47:         self.assertFalse(detector.is_suspicious_destination("C:\\Users\\User\\Templates\\doc.docx"))
 48: 
 49:     def test_f02_tmpuser_profile_not_suspicious(self):
 50:         """User profile C:\\Users\\tmpuser\\Documents should not trigger temp destination."""
 51:         self.assertFalse(detector.is_suspicious_destination("C:\\Users\\tmpuser\\Documents\\file.txt"))
 52: 
 53:     def test_f02_real_temp_folder_is_suspicious(self):
 54:         """Actual temp directory (e.g. C:\\Windows\\Temp\\file.docx) IS suspicious."""
 55:         self.assertTrue(detector.is_suspicious_destination("C:\\Windows\\Temp\\file.docx"))
 56: 
 57:     # ── F-06: Creating in Suspicious Folder is CRITICAL ────────────────────────
 58:     def test_f06_creating_sensitive_in_cloud_is_critical(self):
 59:         """Creating secret.pem in Dropbox should return CRITICAL, not just WARNING."""
 60:         level = detector.classify_event("CREATED", "C:\\Users\\User\\Dropbox\\secret.pem")
 61:         self.assertEqual(level, "CRITICAL")
 62: 
 63:     # ── F-10: Destination File Type on Rename ─────────────────────────────────
 64:     def test_f10_renaming_txt_to_pem_is_sensitive(self):
