<file path="diff_tracker.py">
  1: """
  2: diff_tracker.py - Exact File Content Diff & Change Tracking Engine
  3: Tracks before-and-after content modifications for files in real time.
  4: Computes unified diffs for text/code/config files and byte deltas for binary documents.
  5: """
  6: 
  7: from __future__ import annotations
  8: 
  9: import difflib
 10: import os
 11: import time
 12: 
 13: # In-memory baseline content & size caches: {norm_path: text_content}
 14: _content_cache: dict[str, str] = {}
 15: _size_cache: dict[str, int] = {}
 16: 
 17: # Max file size to cache text content for diffing (1 MB)
 18: _MAX_DIFF_TEXT_SIZE = 1024 * 1024
 19: 
 20: 
 21: def _is_binary_file(filepath: str) -> bool:
 22:     """Return True if file is binary (contains null bytes or non-text extension)."""
 23:     _, ext = os.path.splitext(filepath.lower())
 24:     if ext in {
 25:         ".docx", ".xlsx", ".pptx", ".pdf", ".zip", ".rar", ".tar", ".gz",
 26:         ".7z", ".db", ".sqlite", ".png", ".jpg", ".jpeg", ".ico", ".exe",
 27:         ".dll", ".bin", ".dat", ".pfx", ".p12"
 28:     }:
 29:         return True
 30: 
 31:     try:
 32:         with open(filepath, "rb") as f:
 33:             chunk = f.read(1024)
 34:             if b"\x00" in chunk:
 35:                 return True
 36:     except Exception:
 37:         return True
 38:     return False
 39: 
 40: 
 41: def _read_text_safely(filepath: str, retries: int = 3) -> str | None:
 42:     """Read file as text with encoding fallbacks and Windows file-lock retry backoff."""
 43:     for attempt in range(max(1, retries)):
 44:         try:
 45:             with open(filepath, "r", encoding="utf-8", errors="replace") as f:
 46:                 return f.read()
 47:         except PermissionError:
 48:             if attempt < retries - 1:
 49:                 time.sleep(0.05 * (attempt + 1))
 50:             else:
 51:                 return None
 52:         except Exception:
 53:             return None
 54:     return None
 55: 
 56: 
 57: def record_initial_state(filepath: str):
 58:     """Snapshot a file's initial content/size when first observed."""
 59:     if not filepath or not os.path.isfile(filepath):
 60:         return
 61:     norm = os.path.normcase(os.path.normpath(os.path.abspath(filepath)))
 62:     try:
 63:         size = os.path.getsize(filepath)
 64:         _size_cache[norm] = size
 65:         if size <= _MAX_DIFF_TEXT_SIZE and not _is_binary_file(filepath):
 66:             content = _read_text_safely(filepath)
 67:             if content is not None:
 68:                 _content_cache[norm] = content
 69:     except Exception:
 70:         pass
 71: 
 72: 
 73: def compute_file_diff(event_type: str, src_path: str, dest_path: str = "") -> dict:
 74:     """
 75:     Compute what actually changed in the file during an event.
 76: 
 77:     Returns a structured dictionary:
 78:       - type: 'text' | 'binary' | 'lifecycle'
 79:       - summary: Brief human-readable delta (e.g. '+3 lines, -1 line (+48 bytes)')
 80:       - added_count: Number of added lines (for text)
 81:       - removed_count: Number of deleted lines (for text)
 82:       - snippet: Formatted unified diff or binary status string
 83:       - size_delta: Byte difference (positive or negative)
 84:     """
 85:     target_path = dest_path if (event_type == "MOVED" and dest_path) else src_path
 86:     if not target_path:
 87:         return {"type": "none", "summary": "No target path", "snippet": ""}
 88: 
 89:     norm = os.path.normcase(os.path.normpath(os.path.abspath(target_path)))
 90:     src_norm = os.path.normcase(os.path.normpath(os.path.abspath(src_path)))
 91: 
 92:     # 1. CREATED
 93:     if event_type in ("CREATED", "CREATED_DIR"):
 94:         size = 0
 95:         try:
 96:             if os.path.exists(target_path):
 97:                 size = os.path.getsize(target_path)
 98:         except OSError:
 99:             pass
100: 
101:         _size_cache[norm] = size
102:         if not _is_binary_file(target_path) and size <= _MAX_DIFF_TEXT_SIZE:
103:             content = _read_text_safely(target_path) or ""
104:             _content_cache[norm] = content
105:             line_count = len(content.splitlines())
106:             return {
107:                 "type": "text",
108:                 "summary": f"Initial file created ({line_count} lines, {size:,} bytes)",
109:                 "added_count": line_count,
110:                 "removed_count": 0,
111:                 "size_delta": size,
112:                 "snippet": f"+++ Initial File Content ({line_count} lines, {size:,} bytes) +++",
113:             }
114:         return {
115:             "type": "binary",
116:             "summary": f"New file created ({size:,} bytes)",
117:             "added_count": 0,
118:             "removed_count": 0,
119:             "size_delta": size,
120:             "snippet": f"[Binary payload established: {size:,} bytes]",
121:         }
122: 
123:     # 2. DELETED
124:     if event_type in ("DELETED", "DELETED_DIR"):
125:         old_size = _size_cache.pop(src_norm, 0)
126:         _content_cache.pop(src_norm, None)
127:         return {
128:             "type": "lifecycle",
129:             "summary": f"File deleted from disk ({old_size:,} bytes removed)",
130:             "added_count": 0,
131:             "removed_count": 0,
132:             "size_delta": -old_size,
133:             "snippet": f"--- File Removed ({old_size:,} bytes) ---",
134:         }
135: 
136:     # 3. MOVED
137:     if event_type in ("MOVED", "MOVED_DIR"):
138:         old_size = _size_cache.pop(src_norm, 0)
139:         old_content = _content_cache.pop(src_norm, None)
140: 
141:         new_size = old_size
142:         try:
143:             if os.path.exists(target_path):
144:                 new_size = os.path.getsize(target_path)
145:         except OSError:
146:             pass
147: 
148:         _size_cache[norm] = new_size
149:         if old_content is not None:
150:             _content_cache[norm] = old_content
151: 
152:         dest_name = os.path.basename(dest_path) if dest_path else "new destination"
153:         return {
154:             "type": "lifecycle",
155:             "summary": f"Relocated to: {dest_path or target_path} ({new_size:,} bytes)",
156:             "added_count": 0,
157:             "removed_count": 0,
158:             "size_delta": 0,
159:             "snippet": f"→ Transferred to {dest_name}",
160:         }
161: 
162:     # 4. MODIFIED
163:     old_size = _size_cache.get(norm, 0)
164:     new_size = old_size
165:     try:
166:         if os.path.exists(target_path):
167:             new_size = os.path.getsize(target_path)
168:     except OSError:
169:         pass
170:     size_delta = new_size - old_size
171:     _size_cache[norm] = new_size
172: 
173:     # Check if text file for unified diff
174:     if not _is_binary_file(target_path) and new_size <= _MAX_DIFF_TEXT_SIZE:
175:         new_content = _read_text_safely(target_path)
176:         old_content = _content_cache.get(norm)
177: 
178:         if new_content is not None and old_content is not None:
179:             old_lines = old_content.splitlines(keepends=True)
180:             new_lines = new_content.splitlines(keepends=True)
181: 
182:             diff_generator = difflib.unified_diff(
183:                 old_lines,
184:                 new_lines,
185:                 fromfile="previous",
186:                 tofile="current",
187:                 n=2,
188:             )
189:             diff_lines = list(diff_generator)
190: 
191:             added = [l.rstrip("\r\n") for l in diff_lines if l.startswith("+") and not l.startswith("+++")]
192:             removed = [l.rstrip("\r\n") for l in diff_lines if l.startswith("-") and not l.startswith("---")]
193: 
194:             _content_cache[norm] = new_content
195: 
196:             if added or removed:
197:                 delta_sign = "+" if size_delta >= 0 else ""
198:                 summary = f"+{len(added)} added, -{len(removed)} removed ({delta_sign}{size_delta:,} bytes)"
199:                 snippet_text = "".join(diff_lines[:40])  # Cap at 40 lines
200:                 if len(diff_lines) > 40:
201:                     snippet_text += f"\n... [{len(diff_lines) - 40} additional lines truncated]"
202:                 return {
203:                     "type": "text",
204:                     "summary": summary,
205:                     "added_count": len(added),
206:                     "removed_count": len(removed),
207:                     "added_samples": added[:5],
208:                     "removed_samples": removed[:5],
209:                     "size_delta": size_delta,
210:                     "snippet": snippet_text,
211:                 }
212: 
213:         if new_content is not None:
214:             _content_cache[norm] = new_content
215: 
216:     # Binary or non-diffable file
217:     delta_sign = "+" if size_delta >= 0 else ""
218:     summary = f"Binary content modified: {old_size:,} bytes → {new_size:,} bytes ({delta_sign}{size_delta:,} bytes)"
219:     return {
220:         "type": "binary",
221:         "summary": summary,
222:         "added_count": 0,
223:         "removed_count": 0,
224:         "size_delta": size_delta,
225:         "snippet": f"[Binary Payload: {delta_sign}{size_delta:,} bytes change]",
226:     }
</file>

<file path="dlp_scanner.py">
  1: """
  2: dlp_scanner.py - Content Inspection & True DLP Regex Engine
  3: Inspects file content for sensitive data leaks:
  4: - Cryptographic Private Keys
  5: - Cloud Access Tokens & API Credentials (AWS, GCP, GitHub)
  6: - Payment Card Numbers with Luhn Checksum Algorithm Validation
  7: - PII (Social Security Numbers, Aadhaar Numbers)
  8: """
  9: 
 10: from __future__ import annotations
 11: 
 12: import os
 13: import re
 14: 
 15: # Max bytes to inspect for DLP regex to ensure zero latency overhead
 16: _MAX_DLP_INSPECT_BYTES = 512 * 1024  # 512 KB
 17: 
 18: # ── Compiled Regular Expressions ─────────────────────────────────────────────
 19: _RE_PRIVATE_KEY = re.compile(
 20:     r"-----BEGIN\s+(?:RSA\s+|EC\s+|DSA\s+|OPENSSH\s+)?PRIVATE\s+KEY-----",
 21:     re.IGNORECASE
 22: )
 23: _RE_AWS_KEY = re.compile(r"\bAKIA[0-9A-Z]{16}\b")
 24: _RE_GCP_KEY = re.compile(r"\bAIza[0-9A-Za-z\-_]{35}\b")
 25: _RE_GITHUB_TOKEN = re.compile(r"\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,255}\b")
 26: 
 27: # Credit Card Candidate Pattern (13 to 19 digits with optional spaces or dashes)
 28: _RE_CREDIT_CARD = re.compile(r"\b(?:\d[ -]*?){13,19}\b")
 29: 
 30: # PII Patterns
 31: _RE_US_SSN = re.compile(r"\b(?!000|666|9\d{2})\d{3}-(?!00)\d{2}-(?!0000)\d{4}\b")
 32: _RE_AADHAAR = re.compile(r"\b[2-9]\d{3}\s?\d{4}\s?\d{4}\b")
 33: 
 34: 
 35: def _luhn_checksum_valid(number_str: str) -> bool:
 36:     """Verify Luhn (Mod 10) algorithm to filter out random 16-digit non-card numbers."""
 37:     digits = [int(c) for c in number_str if c.isdigit()]
 38:     if len(digits) < 13 or len(digits) > 19:
 39:         return False
 40:     # Check leading digit for standard card issuers: 3 (Amex), 4 (Visa), 5 (MasterCard), 6 (Discover)
 41:     if digits[0] not in (3, 4, 5, 6):
 42:         return False
 43: 
 44:     checksum = 0
 45:     reverse_digits = digits[::-1]
 46:     for i, d in enumerate(reverse_digits):
 47:         if i % 2 == 1:
 48:             d *= 2
 49:             if d > 9:
 50:                 d -= 9
 51:         checksum += d
 52:     return (checksum % 10) == 0
 53: 
 54: 
 55: def _mask_secret(val: str) -> str:
 56:     """Mask secret for safe security report display."""
 57:     if len(val) <= 8:
 58:         return "********"
 59:     return val[:4] + "*" * (len(val) - 8) + val[-4:]
 60: 
 61: 
 62: def scan_file_content(filepath: str) -> dict:
 63:     """
 64:     Scan the file content for sensitive DLP patterns.
 65: 
 66:     Returns:
 67:         {
 68:             "is_violation": bool,
 69:             "matches": list[dict],      # [{"type": str, "count": int, "sample": str}]
 70:             "risk_bonus": int,          # 0 to 20
 71:             "summary": str,
 72:         }
 73:     """
 74:     if not filepath or not os.path.isfile(filepath):
 75:         return {"is_violation": False, "matches": [], "risk_bonus": 0, "summary": ""}
 76: 
 77:     # Check file size before reading
 78:     try:
 79:         size = os.path.getsize(filepath)
 80:         if size == 0:
 81:             return {"is_violation": False, "matches": [], "risk_bonus": 0, "summary": ""}
 82:     except OSError:
 83:         return {"is_violation": False, "matches": [], "risk_bonus": 0, "summary": ""}
 84: 
 85:     # Read up to 512 KB
 86:     content = ""
 87:     try:
 88:         with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
 89:             content = f.read(_MAX_DLP_INSPECT_BYTES)
 90:     except Exception:
 91:         return {"is_violation": False, "matches": [], "risk_bonus": 0, "summary": ""}
 92: 
 93:     if not content:
 94:         return {"is_violation": False, "matches": [], "risk_bonus": 0, "summary": ""}
 95: 
 96:     matches = []
 97:     risk_bonus = 0
 98: 
 99:     # 1. Cryptographic Private Keys
100:     pk_hits = _RE_PRIVATE_KEY.findall(content)
101:     if pk_hits:
102:         matches.append({"type": "Private Key", "count": len(pk_hits), "sample": "-----BEGIN PRIVATE KEY-----"})
103:         risk_bonus += 20
104: 
105:     # 2. Cloud Credentials
106:     aws_hits = _RE_AWS_KEY.findall(content)
107:     if aws_hits:
108:         matches.append({"type": "AWS Access Key", "count": len(aws_hits), "sample": _mask_secret(aws_hits[0])})
109:         risk_bonus += 20
110: 
111:     gcp_hits = _RE_GCP_KEY.findall(content)
112:     if gcp_hits:
113:         matches.append({"type": "Google Cloud API Key", "count": len(gcp_hits), "sample": _mask_secret(gcp_hits[0])})
114:         risk_bonus += 15
115: 
116:     gh_hits = _RE_GITHUB_TOKEN.findall(content)
117:     if gh_hits:
118:         matches.append({"type": "GitHub Token", "count": len(gh_hits), "sample": "ghp_****************"})
119:         risk_bonus += 15
120: 
121:     # 3. Payment Card Data (with Luhn validation)
122:     card_candidates = _RE_CREDIT_CARD.findall(content)
123:     valid_cards = []
124:     for cand in card_candidates:
125:         clean_num = re.sub(r"\D", "", cand)
126:         if _luhn_checksum_valid(clean_num):
127:             valid_cards.append(_mask_secret(clean_num))
128:             if len(valid_cards) >= 3:
129:                 break
130: 
131:     if valid_cards:
132:         matches.append({"type": "Payment Card Number", "count": len(valid_cards), "sample": valid_cards[0]})
133:         risk_bonus += 20
134: 
135:     # 4. PII Data
136:     ssn_hits = _RE_US_SSN.findall(content)
137:     if ssn_hits:
138:         matches.append({"type": "Social Security Number (SSN)", "count": len(ssn_hits), "sample": "***-**-" + ssn_hits[0][-4:]})
139:         risk_bonus += 15
140: 
141:     aadhaar_hits = _RE_AADHAAR.findall(content)
142:     if aadhaar_hits:
143:         matches.append({"type": "Aadhaar Identity Number", "count": len(aadhaar_hits), "sample": "**** **** " + aadhaar_hits[0].strip()[-4:]})
144:         risk_bonus += 15
145: 
146:     # Cap risk bonus at 20
147:     risk_bonus = min(20, risk_bonus)
148:     is_violation = len(matches) > 0
149: 
150:     summary = ", ".join([f"{m['count']}x {m['type']}" for m in matches]) if matches else ""
151: 
152:     return {
153:         "is_violation": is_violation,
154:         "matches": matches,
155:         "risk_bonus": risk_bonus,
156:         "summary": summary,
157:     }
</file>

<file path="process_tracker.py">
  1: """
  2: process_tracker.py - Windows Restart Manager & Process Lineage Telemetry
  3: Discovers the exact process holding active file handles using Windows Restart Manager (rstrtmgr.dll),
  4: extracts parent process lineage and command-line execution arguments, and provides safe termination.
  5: """
  6: 
  7: from __future__ import annotations
  8: 
  9: import os
 10: import sys
 11: import ctypes
 12: from ctypes import wintypes
 13: import psutil
 14: 
 15: # Protected system processes that can never be terminated
 16: _PROTECTED_PROCESSES = frozenset({
 17:     "csrss.exe", "lsass.exe", "services.exe", "winlogon.exe",
 18:     "explorer.exe", "svchost.exe", "smss.exe", "dwm.exe",
 19:     "system", "system idle process"
 20: })
 21: 
 22: 
 23: # ── Windows Restart Manager Structures & Ctypes ──────────────────────────────
 24: if sys.platform == "win32":
 25:     CCH_RM_SESSION_KEY = 32
 26:     CCH_RM_MAX_APP_NAME = 255
 27:     CCH_RM_MAX_SVC_NAME = 63
 28: 
 29:     class RM_UNIQUE_PROCESS(ctypes.Structure):
 30:         _fields_ = [
 31:             ("dwProcessId", wintypes.DWORD),
 32:             ("ProcessStartTime", wintypes.FILETIME),
 33:         ]
 34: 
 35:     class RM_PROCESS_INFO(ctypes.Structure):
 36:         _fields_ = [
 37:             ("Process", RM_UNIQUE_PROCESS),
 38:             ("strAppName", wintypes.WCHAR * (CCH_RM_MAX_APP_NAME + 1)),
 39:             ("strServiceShortName", wintypes.WCHAR * (CCH_RM_MAX_SVC_NAME + 1)),
 40:             ("ApplicationType", wintypes.UINT),
 41:             ("AppStatus", wintypes.ULONG),
 42:             ("TSSessionId", wintypes.DWORD),
 43:             ("bRestartable", wintypes.BOOL),
 44:         ]
 45: 
 46:     try:
 47:         rstrtmgr = ctypes.windll.rstrtmgr
 48:     except Exception:
 49:         rstrtmgr = None
 50: else:
 51:     rstrtmgr = None
 52: 
 53: 
 54: def get_file_locking_pids(filepath: str) -> list[int]:
 55:     """
 56:     Query the Windows Restart Manager for PIDs currently holding an open handle to filepath.
 57:     Returns list of PIDs.
 58:     """
 59:     if not rstrtmgr or not filepath or not os.path.exists(filepath):
 60:         return []
 61: 
 62:     pids: list[int] = []
 63:     session_handle = wintypes.DWORD()
 64:     session_key = (wintypes.WCHAR * (CCH_RM_SESSION_KEY + 1))()
 65: 
 66:     res = rstrtmgr.RmStartSession(ctypes.byref(session_handle), 0, session_key)
 67:     if res != 0:
 68:         return []
 69: 
 70:     try:
 71:         file_arr = (wintypes.LPCWSTR * 1)(filepath)
 72:         res = rstrtmgr.RmRegisterResources(session_handle, 1, file_arr, 0, None, 0, None)
 73:         if res != 0:
 74:             return []
 75: 
 76:         n_proc_info_needed = wintypes.UINT(0)
 77:         n_proc_info = wintypes.UINT(0)
 78:         reboot_reasons = wintypes.DWORD()
 79: 
 80:         # First call to get required buffer size
 81:         res = rstrtmgr.RmGetList(
 82:             session_handle,
 83:             ctypes.byref(n_proc_info_needed),
 84:             ctypes.byref(n_proc_info),
 85:             None,
 86:             ctypes.byref(reboot_reasons)
 87:         )
 88: 
 89:         if n_proc_info_needed.value > 0:
 90:             proc_info_arr = (RM_PROCESS_INFO * n_proc_info_needed.value)()
 91:             n_proc_info.value = n_proc_info_needed.value
 92: 
 93:             res = rstrtmgr.RmGetList(
 94:                 session_handle,
 95:                 ctypes.byref(n_proc_info_needed),
 96:                 ctypes.byref(n_proc_info),
 97:                 proc_info_arr,
 98:                 ctypes.byref(reboot_reasons)
 99:             )
100: 
101:             if res == 0:
102:                 for i in range(n_proc_info.value):
103:                     pid = proc_info_arr[i].Process.dwProcessId
104:                     if pid and pid != os.getpid():
105:                         pids.append(pid)
106:     except Exception:
107:         pass
108:     finally:
109:         rstrtmgr.RmEndSession(session_handle)
110: 
111:     return pids
112: 
113: 
114: def get_process_telemetry(filepath: str = "", pid: int | None = None) -> dict:
115:     """
116:     Resolve true process attribution, parent lineage, and command-line execution arguments.
117: 
118:     Returns:
119:         {
120:             "pid": int | None,
121:             "name": str,
122:             "cmdline": str,
123:             "ppid": int | None,
124:             "parent_name": str,
125:             "lineage": str,
126:         }
127:     """
128:     target_pid = pid
129:     if isinstance(filepath, int) and target_pid is None:
130:         target_pid = filepath
131:         filepath = ""
132: 
133:     # 1. Try Windows Restart Manager on the target file
134:     if not target_pid and filepath and os.path.exists(filepath):
135:         pids = get_file_locking_pids(filepath)
136:         if pids:
137:             target_pid = pids[0]
138: 
139:     # 2. Fallback: Query Foreground Window if available
140:     if not target_pid and sys.platform == "win32":
141:         try:
142:             hwnd = ctypes.windll.user32.GetForegroundWindow()
143:             if hwnd:
144:                 win_pid = ctypes.c_ulong()
145:                 ctypes.windll.user32.GetWindowThreadProcessId(hwnd, ctypes.byref(win_pid))
146:                 if win_pid.value and win_pid.value != os.getpid():
147:                     target_pid = win_pid.value
148:         except Exception:
149:             pass
150: 
151:     if not target_pid:
152:         return {
153:             "pid": None,
154:             "name": "System / Background",
155:             "cmdline": "N/A",
156:             "ppid": None,
157:             "parent_name": "N/A",
158:             "lineage": "System / Background",
159:         }
160: 
161:     try:
162:         proc = psutil.Process(target_pid)
163:         proc_name = proc.name()
164:         try:
165:             cmdline_list = proc.cmdline()
166:             cmdline = " ".join(cmdline_list) if cmdline_list else proc_name
167:         except (psutil.AccessDenied, psutil.ZombieProcess):
168:             cmdline = proc_name
169: 
170:         ppid = proc.ppid()
171:         parent_name = "N/A"
172:         try:
173:             parent = proc.parent()
174:             if parent:
175:                 parent_name = parent.name()
176:         except (psutil.AccessDenied, psutil.NoSuchProcess):
177:             pass
178: 
179:         lineage = f"{parent_name} (PID {ppid}) → {proc_name} (PID {target_pid})" if ppid else f"{proc_name} (PID {target_pid})"
180: 
181:         return {
182:             "pid": target_pid,
183:             "name": proc_name,
184:             "cmdline": cmdline[:300],  # cap at 300 chars
185:             "ppid": ppid,
186:             "parent_name": parent_name,
187:             "lineage": lineage,
188:         }
189:     except (psutil.NoSuchProcess, psutil.AccessDenied):
190:         return {
191:             "pid": target_pid,
192:             "name": "System / Background",
193:             "cmdline": "N/A",
194:             "ppid": None,
195:             "parent_name": "N/A",
196:             "lineage": "System / Background",
197:         }
198: 
199: 
200: def terminate_process(pid: int) -> dict:
201:     """
202:     Safely terminate an unapproved exfiltration or suspicious utility process.
203:     Enforces strict guardrails to prevent terminating core Windows system processes.
204:     """
205:     if not pid or pid <= 4 or pid == os.getpid():
206:         return {"success": False, "error": "Cannot terminate current or root system process."}
207: 
208:     try:
209:         proc = psutil.Process(pid)
210:         proc_name = proc.name().lower()
211: 
212:         if proc_name in _PROTECTED_PROCESSES:
213:             return {
214:                 "success": False,
215:                 "error": f"Protection Policy: Termination of core process '{proc_name}' is forbidden."
216:             }
217: 
218:         proc.kill()
219:         return {
220:             "success": True,
221:             "message": f"Successfully terminated suspicious process '{proc_name}' (PID {pid})."
222:         }
223:     except psutil.NoSuchProcess:
224:         return {"success": False, "error": f"Process PID {pid} is no longer running."}
225:     except psutil.AccessDenied:
226:         return {"success": False, "error": f"Access Denied: Insufficient privilege to terminate PID {pid}."}
227:     except Exception as e:
228:         return {"success": False, "error": str(e)}
