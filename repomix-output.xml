<file path="hasher.py">
  1: """
  2: hasher.py - File Integrity Hashing Module
  3: Uses Python's built-in hashlib — no installation required.
  4: Supports SHA256, SHA512, and MD5 algorithms with Windows file-lock retry backoff
  5: and baseline hash registry for continuous file integrity tracking.
  6: """
  7: 
  8: from __future__ import annotations
  9: 
 10: import hashlib
 11: import os
 12: import time
 13: from config import HASH_ALGORITHM, HASH_CHUNK_SIZE
 14: 
 15: # In-memory snapshot: {filepath: hash_digest}
 16: _hash_snapshot: dict[str, str] = {}
 17: 
 18: # Continuous baseline hash registry: {norm_path: hash_digest}
 19: _baseline_hashes: dict[str, str] = {}
 20: 
 21: 
 22: def compute_hash(
 23:     filepath: str,
 24:     algorithm: str = HASH_ALGORITHM,
 25:     retries: int = 3,
 26:     retry_delay: float = 0.05,
 27: ) -> str | None:
 28:     """
 29:     Compute the hash of a file using the specified algorithm.
 30:     Includes automated retry backoff to handle transient Windows file locks during writes.
 31: 
 32:     Args:
 33:         filepath:    Absolute path to the file.
 34:         algorithm:   Hash algorithm name ('sha256', 'sha512', 'md5').
 35:         retries:     Number of retry attempts if file is temporarily locked.
 36:         retry_delay: Initial delay in seconds between retries.
 37: 
 38:     Returns:
 39:         Hex digest string, or None if the file cannot be read.
 40:     """
 41:     if not filepath:
 42:         return None
 43: 
 44:     for attempt in range(max(1, retries)):
 45:         try:
 46:             h = hashlib.new(algorithm)
 47:             with open(filepath, "rb") as f:
 48:                 while chunk := f.read(HASH_CHUNK_SIZE):
 49:                     h.update(chunk)
 50:             return h.hexdigest()
 51:         except PermissionError:
 52:             # Windows file locking (WinError 32) during active application flush
 53:             if attempt < retries - 1:
 54:                 time.sleep(retry_delay * (attempt + 1))
 55:             else:
 56:                 return None
 57:         except (FileNotFoundError, OSError, ValueError):
 58:             return None
 59:     return None
 60: 
 61: 
 62: def verify_integrity(pre_hash: str | None, post_hash: str | None) -> tuple[bool, str]:
 63:     """
 64:     Compare pre- and post-transfer hashes.
 65: 
 66:     Returns:
 67:         (True, "INTACT")       if hashes match
 68:         (False, "TAMPERED")    if hashes differ
 69:         (False, "UNAVAILABLE") if either hash is None
 70:     """
 71:     if pre_hash is None or post_hash is None:
 72:         return False, "UNAVAILABLE"
 73:     if pre_hash == post_hash:
 74:         return True, "INTACT"
 75:     return False, "TAMPERED"
 76: 
 77: 
 78: def snapshot_file(filepath: str) -> str | None:
 79:     """
 80:     Compute and store the hash of a file in the snapshot dict.
 81:     Call this BEFORE a transfer occurs.
 82: 
 83:     Returns:
 84:         The computed hash, or None on failure.
 85:     """
 86:     digest = compute_hash(filepath)
 87:     if digest:
 88:         _hash_snapshot[filepath] = digest
 89:         set_baseline_hash(filepath, digest)
 90:     return digest
 91: 
 92: 
 93: def check_against_snapshot(filepath: str) -> tuple[bool, str, str | None, str | None]:
 94:     """
 95:     Compare a file's current hash against its stored snapshot.
 96:     Call this AFTER a transfer/modification occurs.
 97: 
 98:     Returns:
 99:         (integrity_ok, status, pre_hash, post_hash)
100:     """
101:     pre_hash  = _hash_snapshot.get(filepath)
102:     post_hash = compute_hash(filepath)
103:     ok, status = verify_integrity(pre_hash, post_hash)
104:     return ok, status, pre_hash, post_hash
105: 
106: 
107: def clear_snapshot(filepath: str = None):
108:     """Remove a specific file from the snapshot, or clear all."""
109:     if filepath:
110:         _hash_snapshot.pop(filepath, None)
111:     else:
112:         _hash_snapshot.clear()
113: 
114: 
115: def get_snapshot() -> dict:
116:     """Return a copy of the current hash snapshot."""
117:     return dict(_hash_snapshot)
118: 
119: 
120: # ── Baseline Registry Functions ──────────────────────────────────────────────
121: 
122: def set_baseline_hash(filepath: str, digest: str | None = None) -> str | None:
123:     """Store or update the known baseline hash for a normalized path."""
124:     if not filepath:
125:         return None
126:     norm = os.path.normcase(os.path.normpath(os.path.abspath(filepath)))
127:     if digest is None:
128:         digest = compute_hash(filepath)
129:     if digest:
