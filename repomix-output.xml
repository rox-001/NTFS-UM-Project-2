 316:   async function fetchLogs(page = currentPage) {
 317:     const level    = document.getElementById("levelFilter").value;
 318:     const fileType = document.getElementById("fileTypeFilter").value;
 319:     const keyword  = document.getElementById("searchInput").value.trim();
 320:     let url = `/api/logs?page=${page}&sort_by=${encodeURIComponent(currentSortBy)}&order=${encodeURIComponent(currentOrder)}&timeframe=${encodeURIComponent(activeTimePreset)}`;
 321:     if (level)    url += `&level=${encodeURIComponent(level)}`;
 322:     if (fileType) url += `&file_type=${encodeURIComponent(fileType)}`;
 323:     if (keyword)  url += `&keyword=${encodeURIComponent(keyword)}`;
 324:     if (activeStartTime) url += `&start_time=${encodeURIComponent(activeStartTime)}`;
 325:     if (activeEndTime)   url += `&end_time=${encodeURIComponent(activeEndTime)}`;
 326: 
 327:     try {
 328:       const res  = await fetch(url);
 329:       const data = await res.json();
 330:       currentLogs = data.logs || [];
 331:       renderLogs(currentLogs);
 332:       renderPagination(data.page, data.total_pages, data.total);
 333:       const tfLabel = activeTimePreset === '1h' ? 'Last 1 Hour' :
 334:                       activeTimePreset === '24h' ? 'Last 24 Hours' :
 335:                       activeTimePreset === '7d' ? 'Last 7 Days' :
 336:                       activeTimePreset === 'custom' ? 'Custom Range' : 'All Time';
 337:       document.getElementById("tableMeta").textContent =
 338:         `Showing ${currentLogs.length} of ${data.total} events (${tfLabel})`;
