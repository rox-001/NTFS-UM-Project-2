<file path="logger.py">
  1: """
  2: logger.py - Structured Audit Logging Module
  3: Writes JSON-line entries to logs/audit.log.
  4: Also provides colored console output via colorama (always available, no network needed).
  5: """
  6: 
  7: from __future__ import annotations   # PEP 563: compatible with Python 3.7+
  8: 
  9: import json
 10: import os
 11: import sys
 12: from datetime import datetime
 13: 
 14: from colorama import Fore, Style, init as colorama_init
 15: 
 16: from config import AUDIT_LOG_PATH, LOG_DIR, HASH_ALGORITHM
 17: 
 18: # Initialize colorama (autoreset=True resets color after each print)
 19: colorama_init(autoreset=True)
 20: 
 21: # Ensure log directory exists
 22: os.makedirs(LOG_DIR, exist_ok=True)
 23: 
 24: # Color map for alert levels
 25: _LEVEL_COLORS = {
 26:     "INFO":     Fore.CYAN,
 27:     "WARNING":  Fore.YELLOW,
 28:     "CRITICAL": Fore.RED,
 29:     "NORMAL":   Fore.GREEN,
 30: }
 31: 
 32: _LEVEL_PREFIX = {
 33:     "INFO":     "[INFO]    ",
 34:     "WARNING":  "[WARNING] ",
 35:     "CRITICAL": "[CRITICAL]",
 36:     "NORMAL":   "[NORMAL]  ",
 37: }
 38: 
 39: 
 40: def _console_print(level: str, message: str):
 41:     """Print a color-coded line to the console safely across all Windows code pages."""
 42:     color  = _LEVEL_COLORS.get(level, Fore.WHITE)
 43:     prefix = _LEVEL_PREFIX.get(level, "[?]       ")
 44:     ts     = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
 45:     out    = f"{color}{ts} {prefix} {message}{Style.RESET_ALL}"
 46:     try:
 47:         print(out)
 48:     except UnicodeEncodeError:
 49:         print(out.encode("ascii", errors="replace").decode("ascii"))
 50: 
 51: 
 52: def log_event(
 53:     event_type: str,
 54:     source: str,
 55:     destination: str,
 56:     user: str,
 57:     process: str,
 58:     hash_pre: str | None,
 59:     hash_post: str | None,
 60:     integrity_status: str,
 61:     alert_level: str,
 62:     extra: dict = None,
 63: ):
 64:     """
 65:     Write a structured JSON log entry to audit.log and print to console.
 66: 
 67:     Args:
 68:         event_type:        Type of FS event (CREATED, MODIFIED, MOVED, DELETED).
 69:         source:            Source file path.
 70:         destination:       Destination path (empty string if not applicable).
 71:         user:              OS username performing the action.
 72:         process:           Name of the triggering process (or 'N/A').
 73:         hash_pre:          Hash before event (or None).
 74:         hash_post:         Hash after event (or None).
 75:         integrity_status:  'INTACT', 'TAMPERED', or 'UNAVAILABLE'.
 76:         alert_level:       'INFO', 'WARNING', or 'CRITICAL'.
 77:         extra:             Optional dict of additional fields.
 78:     """
 79:     entry = {
 80:         "timestamp":        datetime.now().isoformat(),
 81:         "event_type":       event_type,
 82:         "source":           source,
 83:         "destination":      destination,
 84:         "user":             user,
 85:         "process":          process,
 86:         "hash_algorithm":   HASH_ALGORITHM,
 87:         "hash_pre":         hash_pre or "N/A",
 88:         "hash_post":        hash_post or "N/A",
 89:         "integrity_status": integrity_status,
 90:         "alert_level":      alert_level,
 91:     }
 92:     if extra:
 93:         entry.update(extra)
 94: 
 95:     # Write to audit log file (always utf-8)
 96:     with open(AUDIT_LOG_PATH, "a", encoding="utf-8") as f:
 97:         f.write(json.dumps(entry) + "\n")
 98: 
 99:     # Print to console with colors (using ASCII -> arrow)
100:     dest_str = f" -> {destination}" if destination else ""
101:     msg = f"{event_type:10} | {os.path.basename(source)}{dest_str} | {integrity_status}"
102:     _console_print(alert_level, msg)
103: 
104: 
105: # File type extension categories for advanced filtering
106: _FILE_TYPE_MAP = {
107:     "documents": {".docx", ".doc", ".xlsx", ".xls", ".pptx", ".ppt", ".pdf", ".txt", ".csv", ".rtf"},
108:     "secrets":   {".pem", ".key", ".env", ".pfx", ".p12", ".crt", ".cer", ".kdbx", ".id_rsa"},
109:     "databases": {".sql", ".db", ".sqlite", ".sqlite3", ".mdb", ".accdb"},
110:     "scripts":   {".py", ".ps1", ".bat", ".cmd", ".sh", ".vbs", ".js", ".ts"},
111:     "archives":  {".zip", ".rar", ".7z", ".tar", ".gz", ".bz2"},
112: }
113: 
114: _ALERT_LEVEL_WEIGHT = {
115:     "CRITICAL": 3,
116:     "WARNING":  2,
117:     "INFO":     1,
118:     "NORMAL":   0,
119: }
120: 
121: 
122: def load_logs(
123:     limit: int = None,
124:     level_filter: str = None,
125:     keyword: str = None,
126:     sort_by: str = None,
127:     order: str = "desc",
128:     file_type: str = None,
129:     directory: str = None,
130: ) -> list[dict]:
131:     """
132:     Read and parse audit.log entries with optional filtering and sorting.
133: 
134:     Args:
135:         limit:        Maximum number of entries to return. None = all.
136:         level_filter: Filter by alert level string ('INFO', 'WARNING', 'CRITICAL').
137:         keyword:      Filter entries where keyword appears in source, destination, or user.
138:         sort_by:      Sort key: 'timestamp', 'level', 'source', 'destination', 'event_type', 'ext', 'integrity'.
139:         order:        Sort order: 'asc' or 'desc'.
140:         file_type:    Category ('documents', 'secrets', 'databases', 'scripts', 'archives') or specific extension.
141:         directory:    Filter entries where directory path substring appears in source or destination.
142: 
143:     Returns:
144:         List of log entry dicts.
145:     """
146:     if not os.path.exists(AUDIT_LOG_PATH):
147:         return []
148: 
149:     entries = []
150:     with open(AUDIT_LOG_PATH, "r", encoding="utf-8") as f:
151:         for line in f:
152:             line = line.strip()
153:             if not line:
154:                 continue
155:             try:
156:                 entry = json.loads(line)
157:                 # Apply level filter
158:                 if level_filter and entry.get("alert_level") != level_filter:
159:                     continue
160: 
161:                 # Apply keyword filter
162:                 if keyword:
163:                     kw = keyword.lower()
164:                     src_kw = entry.get("source", "").lower()
165:                     dest_kw = entry.get("destination", "").lower()
166:                     evt_kw = entry.get("event_type", "").lower()
167:                     user_kw = entry.get("user", "").lower()
168:                     if kw not in src_kw and kw not in dest_kw and kw not in evt_kw and kw not in user_kw:
169:                         continue
170: 
171:                 # Apply file type / extension filter
172:                 if file_type:
173:                     ft_lower = file_type.lower()
174:                     src_path = entry.get("source", "")
175:                     dest_path = entry.get("destination", "")
176:                     target = dest_path if (entry.get("event_type") == "MOVED" and dest_path) else src_path
177:                     _, ext = os.path.splitext(target.lower())
178:                     if ft_lower in _FILE_TYPE_MAP:
179:                         if ext not in _FILE_TYPE_MAP[ft_lower]:
180:                             continue
181:                     else:
182:                         norm_ft = ft_lower if ft_lower.startswith(".") else f".{ft_lower}"
183:                         if ext != norm_ft:
184:                             continue
185: 
186:                 # Apply directory filter
187:                 if directory:
188:                     dir_lower = directory.lower()
189:                     src_lower = entry.get("source", "").lower()
190:                     dest_lower = entry.get("destination", "").lower()
191:                     if dir_lower not in src_lower and dir_lower not in dest_lower:
192:                         continue
193: 
194:                 entries.append(entry)
195:             except json.JSONDecodeError:
196:                 continue
197: 
198:     # Apply sorting if requested
199:     if sort_by:
200:         s = sort_by.lower()
201:         if s in ("timestamp", "date"):
202:             key_fn = lambda e: e.get("timestamp", "")
203:         elif s in ("level", "alert_level", "severity"):
204:             key_fn = lambda e: _ALERT_LEVEL_WEIGHT.get(e.get("alert_level", "").upper(), 0)
205:         elif s in ("source", "directory", "dir", "path"):
206:             key_fn = lambda e: e.get("source", "").lower()
207:         elif s in ("destination", "dest"):
208:             key_fn = lambda e: e.get("destination", "").lower()
209:         elif s in ("event", "event_type"):
210:             key_fn = lambda e: e.get("event_type", "").lower()
211:         elif s in ("ext", "extension", "file_type"):
212:             key_fn = lambda e: os.path.splitext(e.get("source", ""))[1].lower()
213:         elif s in ("integrity", "integrity_status"):
214:             key_fn = lambda e: e.get("integrity_status", "").lower()
215:         else:
216:             key_fn = lambda e: e.get("timestamp", "")
217: 
218:         is_desc = (order.lower() == "desc")
219:         entries.sort(key=key_fn, reverse=is_desc)
220: 
221:     if limit:
222:         entries = entries[:limit] if sort_by else entries[-limit:]
223:     return entries
224: 
225: 
226: def get_stats() -> dict:
227:     """Return summary statistics from the audit log."""
228:     entries = load_logs()
229:     stats = {
230:         "total":              len(entries),
231:         "info":               sum(1 for e in entries if e.get("alert_level") == "INFO"),
232:         "warning":            sum(1 for e in entries if e.get("alert_level") == "WARNING"),
233:         "critical":           sum(1 for e in entries if e.get("alert_level") == "CRITICAL"),
234:         "integrity_tampered": sum(1 for e in entries if e.get("integrity_status") == "TAMPERED"),
235:         "integrity_ok":       sum(1 for e in entries if e.get("integrity_status") == "INTACT"),
236:     }
237:     return stats
238: 
239: 
240: def print_banner():
241:     """Print styled startup banner to the console safely across Windows terminals."""
242:     line = "=" * 62
243:     banner = f"""
244: {Fore.CYAN}+{line}+
245: |       SECURE FILE TRANSFER MONITORING SYSTEM                 |
246: |       Blue Team DLP & Integrity Checker  |  v1.0             |
247: +{line}+{Style.RESET_ALL}
248: """
249:     try:
250:         print(banner)
251:     except UnicodeEncodeError:
252:         print(banner.encode("ascii", errors="replace").decode("ascii"))
