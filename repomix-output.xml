196: class SecureTransferEventHandler(FileSystemEventHandler):
197:     """
198:     Custom watchdog event handler that processes filesystem events
199:     through the security pipeline with exfiltration correlation,
200:     line-by-line diff tracking, and cross-directory move resolution.
201:     """
202: 
203:     def _buffer_or_process_deletion(self, src_path: str):
204:         """
205:         Buffer deletion briefly (0.35s) so that if a corresponding creation
206:         arrives in another monitored root, it is resolved as a single MOVED event
207:         with both source and destination populated.
208:         """
209:         norm = os.path.normcase(os.path.normpath(os.path.abspath(src_path)))
210:         basename = os.path.basename(norm).lower()
211:         pre_hash = hasher.get_baseline_hash(src_path)
212: 
213:         with _debounce_lock:
214:             old_timer = _pending_delete_timers.pop(basename, None)
215:             if old_timer:
216:                 old_timer.cancel()
217: 
218:             timer = threading.Timer(0.35, self._flush_deletion, args=[src_path, pre_hash])
219:             _pending_delete_timers[basename] = timer
220:             _pending_deletions[basename] = (time.monotonic(), src_path, pre_hash)
221:             timer.start()
222: 
223:     def _flush_deletion(self, src_path: str, pre_hash: str | None):
224:         """Callback when deletion timer expires without a matching creation (true delete)."""
225:         basename = os.path.basename(os.path.normcase(src_path)).lower()
226:         with _debounce_lock:
227:             _pending_deletions.pop(basename, None)
228:             _pending_delete_timers.pop(basename, None)
229:         self._process_event("DELETED", src_path, pre_hash_override=pre_hash)
230: 
231:     def _process_event(self, event_type: str, src_path: str, dest_path: str = "", pre_hash_override: str | None = None):
232:         if _should_ignore_path(src_path):
233:             return
234:         if dest_path and _should_ignore_path(dest_path):
235:             return
236: 
237:         # Check SOC allowlist by path
238:         if db.is_allowlisted(src_path):
239:             return
240:         if dest_path and db.is_allowlisted(dest_path):
241:             return
242: 
243:         target_path = dest_path if (event_type == "MOVED" and dest_path) else src_path
244:         if _is_burst_duplicate(event_type, target_path):
245:             return
246: 
247:         user = _get_current_user()
248: 
249:         # Step 2: Accurate Handle-to-Process Attribution & Lineage (Restart Manager)
250:         telemetry = process_tracker.get_process_telemetry(target_path)
251:         process = telemetry["name"]
252: 
253:         # Step 3: Check Alternate Data Stream for Internet DOWNLOADED event
254:         download_info = {}
255:         if event_type == "CREATED" and os.path.isfile(src_path):
256:             is_dl, host_url, ref_url = detector.detect_download_metadata(src_path)
257:             if is_dl:
258:                 event_type = "DOWNLOADED"
259:                 download_info = {"host_url": host_url, "referrer_url": ref_url}
260: 
261:         # Step 4: Integrity hashing with baseline registry
262:         if pre_hash_override is not None:
263:             pre_hash = pre_hash_override
264:         else:
265:             pre_hash = hasher.get_baseline_hash(src_path)
266: 
267:         if event_type in ("CREATED", "CREATED_DIR", "DOWNLOADED"):
268:             post_hash = hasher.compute_hash(src_path) if os.path.exists(src_path) else None
269:             if not pre_hash and post_hash:
270:                 pre_hash = post_hash
271:             if post_hash:
272:                 hasher.set_baseline_hash(src_path, post_hash)
273:                 diff_tracker.record_initial_state(src_path)
274:             integrity_status = "INTACT" if post_hash else "UNAVAILABLE"
275: 
276:         elif event_type == "MODIFIED":
277:             post_hash = hasher.compute_hash(src_path) if os.path.exists(src_path) else None
278:             if pre_hash and post_hash:
279:                 _, integrity_status = hasher.verify_integrity(pre_hash, post_hash)
280:             elif post_hash:
281:                 integrity_status = "INTACT"
282:             else:
283:                 integrity_status = "UNAVAILABLE"
284:             if post_hash:
285:                 hasher.set_baseline_hash(src_path, post_hash)
286: 
287:         elif event_type in ("MOVED", "MOVED_DIR"):
288:             post_hash = hasher.compute_hash(dest_path) if (dest_path and os.path.exists(dest_path)) else None
289:             hasher.remove_baseline_hash(src_path)
290:             if dest_path and post_hash:
291:                 hasher.set_baseline_hash(dest_path, post_hash)
292:             if pre_hash and post_hash:
293:                 _, integrity_status = hasher.verify_integrity(pre_hash, post_hash)
294:             elif post_hash:
295:                 integrity_status = "INTACT"
296:             else:
297:                 integrity_status = "UNAVAILABLE"
298: 
299:         elif event_type in ("DELETED", "DELETED_DIR"):
300:             post_hash = None
301:             hasher.remove_baseline_hash(src_path)
302:             integrity_status = "INTACT" if pre_hash else "UNAVAILABLE"
303: 
304:         else:
305:             post_hash = hasher.compute_hash(src_path) if os.path.exists(src_path) else None
306:             _, integrity_status = hasher.verify_integrity(pre_hash, post_hash)
307: 
308:         # Check SOC allowlist by hash
309:         if post_hash and db.is_allowlisted(src_path, digest=post_hash):
310:             return
311: 
312:         # Step 5: True DLP Content Regex Inspection
313:         dlp_result = {"is_violation": False, "matches": [], "risk_bonus": 0, "summary": ""}
314:         if event_type in ("CREATED", "MODIFIED", "DOWNLOADED") and os.path.isfile(target_path):
315:             dlp_result = dlp_scanner.scan_file_content(target_path)
316: 
317:         # Step 6: Multi-Variable Risk Scoring (0-100) & Severity Level
318:         risk_score, level = detector.calculate_risk_score(
319:             event_type, src_path, dest_path,
320:             process_name=process,
321:             dlp_bonus=dlp_result["risk_bonus"]
322:         )
323: 
324:         # Step 7: Diff & Content change calculation
325:         diff_data = diff_tracker.compute_file_diff(event_type, src_path, dest_path)
326: 
327:         # Step 8: Exfiltration correlation (F-01)
328:         basename = os.path.basename(src_path)
329:         now = time.monotonic()
330: 
331:         # Track sensitive deletions
332:         if event_type == "DELETED" and detector.is_sensitive_file(src_path):
333:             with _debounce_lock:
334:                 _recent_deletions[basename.lower()] = (now, src_path, pre_hash)
335: 
336:         # Correlate creation on removable / cloud destination
337:         correlation_note = ""
338:         if event_type in ("CREATED", "MOVED", "DOWNLOADED"):
339:             dest_check = dest_path if dest_path else src_path
340:             if detector.is_suspicious_destination(dest_check):
341:                 with _debounce_lock:
342:                     match = _recent_deletions.get(basename.lower())
343:                     if match and (now - match[0]) < 10.0:
344:                         del_src = match[1]
345:                         level = "CRITICAL"
346:                         risk_score = max(risk_score, 90)
347:                         correlation_note = f" [Cross-Volume Exfiltration: moved/copied from '{del_src}']"
348: 
349:         # Step 9: Log event (with telemetry, risk score, and DLP inspection)
350:         extra_payload = {
351:             "diff": diff_data,
352:             "risk_score": risk_score,
353:             "dlp_matches": dlp_result["matches"],
354:             "dlp_summary": dlp_result["summary"],
355:             "process_telemetry": telemetry,
356:             "download_info": download_info,
357:         }
358: 
359:         logger.log_event(
360:             event_type       = event_type,
361:             source           = src_path,
362:             destination      = dest_path,
363:             user             = user,
364:             process          = process,
365:             hash_pre         = pre_hash,
366:             hash_post        = post_hash,
367:             integrity_status = integrity_status,
368:             alert_level      = level,
369:             risk_score       = risk_score,
370:             extra            = extra_payload,
371:         )
372: 
373:         # Step 10: Trigger alert
374:         if level in ("WARNING", "CRITICAL") or risk_score >= 40:
375:             description = detector.describe_event(event_type, src_path, dest_path) + correlation_note
376:             if dlp_result["summary"]:
377:                 description += f" [DLP Content Alert: {dlp_result['summary']}]"
378:             if download_info.get("host_url"):
379:                 description += f" [Web Source: {download_info['host_url']}]"
380: 
381:             alerter.trigger_alert(
382:                 level      = level,
383:                 message    = description,
384:                 risk_score = risk_score,
385:                 event_data = {
386:                     "event_type":       event_type,
387:                     "source":           src_path,
388:                     "destination":      dest_path,
389:                     "user":             user,
390:                     "process":          process,
391:                     "risk_score":       risk_score,
392:                     "hash_pre":         pre_hash or "N/A",
393:                     "hash_post":        post_hash or "N/A",
394:                     "integrity_status": integrity_status,
395:                     "diff":             diff_data,
396:                     "dlp_matches":      dlp_result["matches"],
397:                     "dlp_summary":      dlp_result["summary"],
398:                     "process_telemetry": telemetry,
399:                     "download_info":    download_info,
400:                 },
401:             )
