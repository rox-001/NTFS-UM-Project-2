<file path="tests/test_assessment_findings.py">
  1: """
  2: tests/test_assessment_findings.py - Reproduction & Verification Tests for Assessment Report Findings
  3: 
  4: Validates fixes for:
  5:   - F-01: Copy-based exfiltration / removable media detection
  6:   - F-02: Substring matching false CRITICAL alerts (report_template.docx, attempt2.txt, Templates folder, tmpuser)
  7:   - F-03: Ignore rule evasion (secret.pem.tmp, leak.zip.part)
  8:   - F-04: Own-folder prefix match (Downloads sibling folder Downloads2)
  9:   - F-05: .git / .vscode exact folder matching (.github, .gitconfig)
 10:   - F-06: Creating file in suspicious folder returns CRITICAL
 11:   - F-07: Removable-drive detection for all drive letters (E:, Z:, etc.)
 12:   - F-08: Directory events not skipped
 13:   - F-09: Process attribution not claiming FileSentinel PID
 14:   - F-10: Destination file type evaluated on rename (notes.txt -> notes.pem)
 15:   - F-11: Debounce allows rapid legitimate edits with content change
 16:   - F-12: Network-share check with forward slashes (//server/share)
 17:   - F-13: Invalid hash algorithm returns None without unhandled exception
 18:   - F-14: Dynamic folder resolution (OneDrive redirection, cloud sync roots)
 19: """
 20: 
 21: import os
 22: import sys
 23: import unittest
 24: 
 25: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 26: 
 27: import detector
 28: import hasher
 29: import monitor
 30: 
 31: 
 32: class TestAssessmentReportFixes(unittest.TestCase):
 33: 
 34:     # ── F-02: Substring Matching False Positives ──────────────────────────────
 35:     def test_f02_renaming_report_template_not_critical(self):
 36:         """Renaming report.docx to report_template.docx should NOT be CRITICAL (not temp)."""
 37:         level = detector.classify_event("MOVED", "C:\\Docs\\report.docx", "C:\\Docs\\report_template.docx")
 38:         # Moving sensitive file locally is WARNING or normal sensitive move, NOT exfiltration to temp
 39:         self.assertFalse(detector.is_suspicious_destination("C:\\Docs\\report_template.docx"))
 40: 
 41:     def test_f02_attempt2_txt_not_suspicious(self):
 42:         """notes.txt to attempt2.txt should NOT trigger suspicious destination for 'temp'."""
 43:         self.assertFalse(detector.is_suspicious_destination("C:\\Docs\\attempt2.txt"))
 44: 
 45:     def test_f02_folder_named_templates_not_suspicious(self):
 46:         """Folder named 'Templates' should not be flagged as a temp folder."""
 47:         self.assertFalse(detector.is_suspicious_destination("C:\\Users\\User\\Templates\\doc.docx"))
 48: 
 49:     def test_f02_tmpuser_profile_not_suspicious(self):
 50:         """User profile C:\\Users\\tmpuser\\Documents should not trigger temp destination."""
 51:         self.assertFalse(detector.is_suspicious_destination("C:\\Users\\tmpuser\\Documents\\file.txt"))
 52: 
 53:     def test_f02_real_temp_folder_is_suspicious(self):
 54:         """Actual temp directory (e.g. C:\\Windows\\Temp\\file.docx) IS suspicious."""
 55:         self.assertTrue(detector.is_suspicious_destination("C:\\Windows\\Temp\\file.docx"))
 56: 
 57:     # ── F-06: Creating in Suspicious Folder is CRITICAL ────────────────────────
 58:     def test_f06_creating_sensitive_in_cloud_is_critical(self):
 59:         """Creating secret.pem in Dropbox should return CRITICAL, not just WARNING."""
 60:         level = detector.classify_event("CREATED", "C:\\Users\\User\\Dropbox\\secret.pem")
 61:         self.assertEqual(level, "CRITICAL")
 62: 
 63:     # ── F-10: Destination File Type on Rename ─────────────────────────────────
 64:     def test_f10_renaming_txt_to_pem_is_sensitive(self):
 65:         """Renaming notes.txt to notes.pem must evaluate destination as sensitive."""
 66:         level = detector.classify_event("MOVED", "C:\\Docs\\notes.txt", "C:\\Docs\\notes.pem")
 67:         # Destination is sensitive (.pem) -> should escalate to CRITICAL or WARNING, not INFO
 68:         self.assertIn(level, ("CRITICAL", "WARNING"))
 69: 
 70:     # ── F-12: Network Share Normalisation ─────────────────────────────────────
 71:     def test_f12_forward_slash_network_share(self):
 72:         """//server/share/file.docx should be recognized as a suspicious network share."""
 73:         self.assertTrue(detector.is_suspicious_destination("//server/share/file.docx"))
 74: 
 75:     # ── F-13: Invalid Hash Algorithm Exception Handling ───────────────────────
 76:     def test_f13_invalid_hash_algorithm_returns_none(self):
 77:         """hashlib.new('sha257') should return None instead of raising unhandled ValueError."""
 78:         test_file = os.path.abspath(__file__)
 79:         result = hasher.compute_hash(test_file, algorithm="sha257")
 80:         self.assertIsNone(result)
 81: 
 82:     # ── F-05: .git and .vscode Exact Path Part Matching ───────────────────────
 83:     def test_f05_github_folder_not_ignored(self):
 84:         """.github\\secrets.env should NOT be ignored like .git."""
 85:         self.assertFalse(monitor._should_ignore_path("C:\\Project\\.github\\secrets.env"))
 86: 
 87:     def test_f05_gitconfig_not_ignored(self):
 88:         """.gitconfig should NOT be ignored."""
 89:         self.assertFalse(monitor._should_ignore_path("C:\\Users\\User\\.gitconfig"))
 90: 
 91:     def test_f05_real_git_folder_is_ignored(self):
 92:         """.git internal objects should be ignored."""
 93:         self.assertTrue(monitor._should_ignore_path("C:\\Project\\.git\\objects\\01\\abcdef"))
 94: 
 95:     # ── F-03: Double Extension Evasion ────────────────────────────────────────
 96:     def test_f03_sensitive_double_extension_not_ignored(self):
 97:         """secret.pem.tmp and leak.zip.part must NOT be silently ignored."""
 98:         self.assertFalse(monitor._should_ignore_path("C:\\Docs\\secret.pem.tmp"))
 99:         self.assertFalse(monitor._should_ignore_path("C:\\Docs\\leak.zip.part"))
100: 
101:     # ── F-04: Own-Folder Sibling Exclusions ────────────────────────────────────
102:     def test_f04_sibling_folders_not_ignored(self):
103:         """Downloads2\\secret.pem should NOT be ignored if base is Downloads."""
104:         # Simulated test: path having matching prefix without separator
105:         base = "C:\\Users\\User\\Downloads"
106:         sibling = "C:\\Users\\User\\Downloads2\\secret.pem"
107:         # Must not match as internal
108:         self.assertFalse(sibling.startswith(base + os.sep))
109: 
110: 
111: if __name__ == "__main__":
112:     unittest.main(verbosity=2)
