251:             process          = process,
252:             hash_pre         = pre_hash,
253:             hash_post        = post_hash,
254:             integrity_status = integrity_status,
255:             alert_level      = level,
256:         )
257: 
258:         # Step 7: Trigger alert
259:         if level in ("WARNING", "CRITICAL"):
260:             description = detector.describe_event(event_type, src_path, dest_path) + correlation_note
261:             alerter.trigger_alert(
262:                 level      = level,
263:                 message    = description,
264:                 event_data = {
265:                     "source":      src_path,
266:                     "destination": dest_path,
267:                     "user":        user,
268:                     "process":     process,
269:                 },
270:             )
271: 
272:     # ── Watchdog Callbacks (with Directory Expansion F-08) ───────────────────
273: 
274:     def on_created(self, event):
275:         if event.is_directory:
276:             self._process_event("CREATED_DIR", event.src_path)
277:             if os.path.isdir(event.src_path):
278:                 try:
279:                     for root, _, files in os.walk(event.src_path):
280:                         for f in files:
281:                             self._process_event("CREATED", os.path.join(root, f))
282:                 except OSError:
283:                     pass
284:         else:
285:             self._process_event("CREATED", event.src_path)
286: 
287:     def on_modified(self, event):
288:         if not event.is_directory:
289:             self._process_event("MODIFIED", event.src_path)
290: 
291:     def on_deleted(self, event):
292:         if event.is_directory:
293:             self._process_event("DELETED_DIR", event.src_path)
294:         else:
295:             self._process_event("DELETED", event.src_path)
296: 
297:     def on_moved(self, event):
298:         if event.is_directory:
299:             self._process_event("MOVED_DIR", event.src_path, event.dest_path)
300:             if os.path.isdir(event.dest_path):
301:                 try:
302:                     for root, _, files in os.walk(event.dest_path):
303:                         for f in files:
304:                             dest_f = os.path.join(root, f)
305:                             rel = os.path.relpath(dest_f, event.dest_path)
306:                             src_f = os.path.join(event.src_path, rel)
307:                             self._process_event("MOVED", src_f, dest_f)
308:                 except OSError:
309:                     pass
310:         else:
311:             self._process_event("MOVED", event.src_path, event.dest_path)
312: 
313: 
314: class FileMonitor:
315:     """
316:     Manages watchdog Observer instances with auto-discovered directories
317:     and background USB/removable media polling.
318:     """
319: 
320:     def __init__(self, directories: list[str] | None = None):
321:         self.observer = Observer()
322:         self._running = False
323:         self._stop_event = threading.Event()
324:         self.event_handler = SecureTransferEventHandler()
325:         self.directories = directories if directories is not None else get_auto_discovered_targets()
326:         self._scheduled_paths: set[str] = set()
327: 
328:     def start(self):
329:         """Schedule watchers for all discovered directories and start observer."""
330:         scheduled = 0
331:         for directory in self.directories:
332:             directory = os.path.expandvars(directory)
333:             if os.path.isdir(directory):
334:                 norm = os.path.normcase(os.path.normpath(directory))
335:                 if norm not in self._scheduled_paths:
336:                     try:
337:                         self.observer.schedule(
338:                             self.event_handler,
339:                             path      = directory,
340:                             recursive = True,
341:                         )
342:                         self._scheduled_paths.add(norm)
343:                         print(f"  [+] Watching: {directory}")
344:                         scheduled += 1
345:                     except Exception as e:
346:                         print(f"  [-] Could not watch {directory}: {e}")
347:             else:
348:                 print(f"  [-] Skipped (not found): {directory}")
349: 
350:         if scheduled == 0:
351:             print("[WARNING] No valid directories to monitor. Edit config.py to add paths.")
352:             return
353: 
354:         self.observer.start()
355:         self._running = True
356:         print(f"\n  Monitoring {scheduled} director(ies) & cloud/removable drives. Press Ctrl+C to stop.\n")
357: 
358:         # Start dynamic USB/removable drive attachment watcher
359:         poll_thread = threading.Thread(target=self._poll_new_drives, daemon=True)
360:         poll_thread.start()
361: 
362:     def _poll_new_drives(self):
363:         """Polls periodically for newly plugged-in USB or network drives."""
364:         while not self._stop_event.is_set():
365:             time.sleep(5.0)
366:             if not self._running:
367:                 break
368:             discovered = get_auto_discovered_targets()
369:             for d in discovered:
370:                 norm = os.path.normcase(os.path.normpath(d))
371:                 if norm not in self._scheduled_paths and os.path.isdir(d):
372:                     try:
373:                         self.observer.schedule(self.event_handler, path=d, recursive=True)
374:                         self._scheduled_paths.add(norm)
375:                         print(f"  [+] Auto-detected & watching new target: {d}")
376:                     except Exception:
377:                         pass
378: 
379:     def stop(self):
380:         """Gracefully stop observer and polling threads."""
381:         if self._running:
382:             self._stop_event.set()
383:             self.observer.stop()
384:             self.observer.join(timeout=1.0)
385:             self._running = False
386:             print("\n  Monitor stopped. Goodbye.")
387: 
388:     def is_running(self) -> bool:
389:         return self._running
