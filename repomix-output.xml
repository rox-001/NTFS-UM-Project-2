631:     def _poll_new_drives(self):
632:         """Polls periodically for newly plugged-in USB or network drives."""
633:         while not self._stop_event.is_set():
634:             time.sleep(5.0)
635:             if not self._running:
636:                 break
637:             discovered = get_auto_discovered_targets()
638:             for d in discovered:
639:                 norm = os.path.normcase(os.path.normpath(d))
640:                 if norm not in self._scheduled_paths and os.path.isdir(d):
641:                     try:
642:                         watch = self.observer.schedule(self.event_handler, path=d, recursive=True)
643:                         self._scheduled_paths.add(norm)
644:                         self._watches[norm] = watch
645:                         if norm not in self.directories:
646:                             self.directories.append(norm)
647:                         print(f"  [+] Auto-detected & watching new target: {d}")
648:                     except Exception:
649:                         pass
