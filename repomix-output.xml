 1: """
 2: dashboard/app.py - SPLUNK-style Local Web Dashboard
 3: Serves a real-time log viewer at http://localhost:5000
 4: 100% LOCAL — no internet, no external APIs, reads only from local log files.
 5: """
 6: 
 7: import sys
 8: import os
 9: 
10: # Allow imports from parent directory
11: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
12: 
13: from flask import Flask, render_template, jsonify, request
14: import logger
15: import alerter
16: from config import DASHBOARD_HOST, DASHBOARD_PORT, DASHBOARD_DEBUG, LOGS_PER_PAGE, RESOURCE_DIR
17: 
18: template_dir = os.path.join(RESOURCE_DIR, "dashboard", "templates")
19: static_dir   = os.path.join(RESOURCE_DIR, "dashboard", "static")
20: 
21: app = Flask(__name__, template_folder=template_dir, static_folder=static_dir)
22: 
23: 
24: @app.route("/")
25: def index():
26:     """Serve the main dashboard page."""
27:     return render_template("index.html")
28: 
29: 
30: @app.route("/api/logs")
31: def api_logs():
32:     """
33:     Return paginated, filterable log entries as JSON.
34:     Query params:
35:       - level:   Filter by alert level (INFO / WARNING / CRITICAL)
36:       - keyword: Search in source/destination/event_type
37:       - page:    Page number (1-indexed)
38:     """
39:     level   = request.args.get("level", "").upper() or None
40:     keyword = request.args.get("keyword", "") or None
41:     page    = max(1, int(request.args.get("page", 1)))
42: 
43:     entries  = logger.load_logs(level_filter=level, keyword=keyword)
44:     total    = len(entries)
45:     # Most recent first for display
46:     entries  = list(reversed(entries))
47:     start    = (page - 1) * LOGS_PER_PAGE
48:     end      = start + LOGS_PER_PAGE
49:     page_entries = entries[start:end]
50: 
51:     return jsonify({
52:         "logs":       page_entries,
53:         "total":      total,
54:         "page":       page,
55:         "per_page":   LOGS_PER_PAGE,
56:         "total_pages": max(1, (total + LOGS_PER_PAGE - 1) // LOGS_PER_PAGE),
57:     })
58: 
59: 
60: @app.route("/api/stats")
61: def api_stats():
62:     """Return summary statistics."""
63:     return jsonify(logger.get_stats())
64: 
65: 
66: @app.route("/api/alerts")
67: def api_alerts():
68:     """Return the most recent alerts."""
69:     limit  = int(request.args.get("limit", 20))
70:     alerts = alerter.load_alerts(limit=limit)
71:     return jsonify(list(reversed(alerts)))  # Most recent first
72: 
73: 
74: def run_dashboard(host: str = DASHBOARD_HOST, port: int = DASHBOARD_PORT):
75:     """Start the Flask development server (blocking call)."""
76:     print(f"\n  Dashboard → http://{host}:{port}  (local only, no internet needed)")
77:     app.run(host=host, port=port, debug=DASHBOARD_DEBUG, use_reloader=False)
