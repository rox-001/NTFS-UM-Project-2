592:     def start(self):
593:         """Schedule watchers for all discovered directories and start observer."""
594:         scheduled = 0
595:         for directory in self.directories:
596:             directory = os.path.expandvars(directory)
597:             if os.path.isdir(directory):
598:                 norm = os.path.normcase(os.path.normpath(directory))
599:                 if norm not in self._scheduled_paths:
600:                     try:
601:                         watch = self.observer.schedule(
602:                             self.event_handler,
603:                             path      = directory,
604:                             recursive = True,
605:                         )
606:                         self._scheduled_paths.add(norm)
607:                         self._watches[norm] = watch
608:                         print(f"  [+] Watching: {directory}")
609:                         scheduled += 1
610:                     except Exception as e:
611:                         print(f"  [-] Could not watch {directory}: {e}")
612:             else:
613:                 print(f"  [-] Skipped (not found): {directory}")
614: 
615:         if scheduled == 0:
616:             print("[WARNING] No valid directories to monitor. Edit config.py to add paths.")
617:             return
618: 
619:         self.observer.start()
620:         self._running = True
621:         print(f"\n  Monitoring {scheduled} director(ies) & cloud/removable drives. Press Ctrl+C to stop.\n")
622: 
623:         # Start dynamic USB/removable drive attachment watcher
624:         poll_thread = threading.Thread(target=self._poll_new_drives, daemon=True)
625:         poll_thread.start()
626: 
627:         # Seed baseline hashes and diff caches in background
628:         seed_thread = threading.Thread(target=self._seed_baseline, daemon=True)
629:         seed_thread.start()
