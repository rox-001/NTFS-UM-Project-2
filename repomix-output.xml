  1: """
  2: reporter.py - Audit Report Generator
  3: Reads audit.log and produces a formatted text report with summary stats and event table.
  4: """
  5: 
  6: import os
  7: from datetime import datetime
  8: from tabulate import tabulate
  9: 
 10: from config import REPORT_DIR, AUDIT_LOG_PATH
 11: from logger import load_logs, get_stats
 12: 
 13: os.makedirs(REPORT_DIR, exist_ok=True)
 14: 
 15: 
 16: def generate_report(output_path: str = None) -> str:
 17:     """
 18:     Generate a comprehensive audit report from the current audit.log.
 19: 
 20:     Args:
 21:         output_path: Optional custom file path. Defaults to
 22:                      reports/audit_report_<timestamp>.txt
 23: 
 24:     Returns:
 25:         Absolute path to the generated report file.
 26:     """
 27:     if not output_path:
 28:         ts = datetime.now().strftime("%Y%m%d_%H%M%S")
 29:         output_path = os.path.join(REPORT_DIR, f"audit_report_{ts}.txt")
 30: 
 31:     entries = load_logs()
 32:     stats   = get_stats()
 33:     now     = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
 34: 
 35:     lines = []
 36: 
 37:     # ─── Header ───────────────────────────────────────────────────────────────
 38:     lines.append("=" * 72)
 39:     lines.append("  SECURE FILE TRANSFER MONITORING SYSTEM — AUDIT REPORT")
 40:     lines.append("=" * 72)
 41:     lines.append(f"  Generated : {now}")
 42:     lines.append(f"  Log file  : {AUDIT_LOG_PATH}")
 43:     lines.append("=" * 72)
 44:     lines.append("")
 45: 
 46:     # ─── Summary Statistics ───────────────────────────────────────────────────
 47:     lines.append("[ SUMMARY STATISTICS ]")
 48:     lines.append("")
 49:     summary_table = [
 50:         ["Total Events",            stats["total"]],
 51:         ["INFO",                    stats["info"]],
 52:         ["WARNING",                 stats["warning"]],
 53:         ["CRITICAL",                stats["critical"]],
 54:         ["Integrity OK",            stats["integrity_ok"]],
 55:         ["Integrity TAMPERED",      stats["integrity_tampered"]],
 56:     ]
 57:     lines.append(tabulate(summary_table, headers=["Metric", "Count"], tablefmt="grid"))
 58:     lines.append("")
 59: 
 60:     # ─── Top Suspicious Sources ───────────────────────────────────────────────
 61:     critical_entries = [e for e in entries if e.get("alert_level") == "CRITICAL"]
 62:     warning_entries  = [e for e in entries if e.get("alert_level") == "WARNING"]
 63: 
 64:     if critical_entries or warning_entries:
 65:         lines.append("[ POLICY VIOLATIONS ]")
 66:         lines.append("")
 67:         violations = []
 68:         for e in (critical_entries + warning_entries):
 69:             violations.append([
 70:                 e.get("timestamp", "")[:19],
 71:                 e.get("alert_level", ""),
 72:                 e.get("event_type", ""),
 73:                 _truncate(e.get("source", ""), 35),
 74:                 _truncate(e.get("destination", ""), 25),
 75:                 e.get("user", ""),
 76:                 e.get("integrity_status", ""),
 77:             ])
 78:         headers = ["Timestamp", "Level", "Event", "Source", "Destination", "User", "Integrity"]
 79:         lines.append(tabulate(violations, headers=headers, tablefmt="grid"))
 80:         lines.append("")
 81: 
 82:     # ─── Full Event Log ───────────────────────────────────────────────────────
 83:     lines.append("[ FULL EVENT LOG ]")
 84:     lines.append("")
 85:     if not entries:
 86:         lines.append("  No events recorded.")
 87:     else:
 88:         rows = []
 89:         for e in entries[-100:]:   # Last 100 entries in report
 90:             rows.append([
 91:                 e.get("timestamp", "")[:19],
 92:                 e.get("alert_level", ""),
 93:                 e.get("event_type", ""),
 94:                 _truncate(e.get("source", ""), 40),
 95:                 _truncate(e.get("destination", ""), 30),
 96:                 e.get("user", ""),
 97:                 e.get("integrity_status", ""),
 98:             ])
 99:         headers = ["Timestamp", "Level", "Event", "Source", "Destination", "User", "Integrity"]
100:         lines.append(tabulate(rows, headers=headers, tablefmt="simple"))
101: 
102:     lines.append("")
103:     lines.append("=" * 72)
104:     lines.append("  END OF REPORT")
105:     lines.append("=" * 72)
106: 
107:     report_text = "\n".join(lines)
108: 
109:     # Write to file
110:     with open(output_path, "w", encoding="utf-8") as f:
111:         f.write(report_text)
112: 
113:     print(report_text)
114:     print(f"\n  Report saved → {output_path}")
115:     return output_path
116: 
117: 
118: def _truncate(text: str, max_len: int) -> str:
119:     """Truncate a string to max_len characters, adding '…' if cut."""
120:     if not text:
121:         return ""
122:     return text if len(text) <= max_len else text[:max_len - 1] + "…"
