<file path="alerter.py">
  1: """
  2: alerter.py - Alert Generation & Policy Violation Notification
  3: Writes alerts to logs/alerts.log and prints to console (colorama).
  4: Supports desktop toast notification callbacks when running in Desktop App mode.
  5: Entirely local — no network dependency. Safe on Windows cp1252.
  6: """
  7: 
  8: import json
  9: import os
 10: import sys
 11: from datetime import datetime
 12: 
 13: from colorama import Fore, Back, Style, init as colorama_init
 14: 
 15: from config import ALERT_LOG_PATH, LOG_DIR
 16: 
 17: colorama_init(autoreset=True)
 18: os.makedirs(LOG_DIR, exist_ok=True)
 19: 
 20: # Console display prefix per level (pure ASCII safe)
 21: _LEVEL_STYLE = {
 22:     "INFO":     (Fore.CYAN,   "[INFO] "),
 23:     "WARNING":  (Fore.YELLOW, "[WARN] "),
 24:     "CRITICAL": (Fore.RED,    "[CRIT] "),
 25: }
 26: 
 27: # Optional desktop notification callback (registered by desktop app)
 28: _desktop_notifier = None
 29: 
 30: 
 31: def register_desktop_notifier(callback):
 32:     """Register a callback function to display native OS notifications."""
 33:     global _desktop_notifier
 34:     _desktop_notifier = callback
 35: 
 36: 
 37: def trigger_alert(level: str, message: str, event_data: dict = None):
 38:     """
 39:     Generate an alert at the specified severity level.
 40: 
 41:     - Writes to logs/alerts.log (JSON-line format)
 42:     - Prints a formatted, color-coded message to the console
 43:     - Prints a full banner for CRITICAL alerts
 44:     - Dispatches native OS notification if desktop mode is active
 45: 
 46:     Args:
 47:         level:      'INFO', 'WARNING', or 'CRITICAL'
 48:         message:    Human-readable alert summary
 49:         event_data: Optional dict of event context (source, destination, etc.)
 50:     """
 51:     ts = datetime.now().isoformat()
 52:     alert_entry = {
 53:         "timestamp":  ts,
 54:         "level":      level,
 55:         "message":    message,
 56:         "event_data": event_data or {},
 57:     }
 58: 
 59:     # Write to alerts log
 60:     with open(ALERT_LOG_PATH, "a", encoding="utf-8") as f:
 61:         f.write(json.dumps(alert_entry) + "\n")
 62: 
 63:     # Console output
 64:     color, icon = _LEVEL_STYLE.get(level, (Fore.WHITE, "[ALERT]"))
 65:     ts_short = datetime.now().strftime("%H:%M:%S")
 66: 
 67:     if level == "CRITICAL":
 68:         _print_critical_banner(message, event_data, ts_short)
 69:     else:
 70:         out = f"{color}{ts_short} {icon} [{level}] {message}{Style.RESET_ALL}"
 71:         try:
 72:             print(out)
 73:         except UnicodeEncodeError:
 74:             print(out.encode("ascii", errors="replace").decode("ascii"))
 75: 
 76:     # Native desktop toast notification for policy violations
 77:     if level in ("WARNING", "CRITICAL") and _desktop_notifier:
 78:         try:
 79:             _desktop_notifier(level, message, event_data or {})
 80:         except Exception:
 81:             pass
 82: 
 83: 
 84: def _print_critical_banner(message: str, event_data: dict, ts: str):
 85:     """Print a loud CRITICAL alert banner to the console."""
 86:     src  = event_data.get("source", "N/A")      if event_data else "N/A"
 87:     dest = event_data.get("destination", "N/A") if event_data else "N/A"
 88:     user = event_data.get("user", "N/A")        if event_data else "N/A"
 89: 
 90:     line = "=" * 62
 91:     banner = f"""
 92: {Fore.RED}{Back.BLACK}
 93: +{line}+
 94: |  [!]  CRITICAL SECURITY ALERT  {ts:>29}  |
 95: +{line}+
 96: |  {message[:60]:<60}  |
 97: |  User   : {user[:52]:<52}  |
 98: |  Source : {src[:52]:<52}  |
 99: |  Dest   : {dest[:52]:<52}  |
100: +{line}+
101: {Style.RESET_ALL}"""
102:     try:
103:         print(banner)
104:     except UnicodeEncodeError:
105:         print(banner.encode("ascii", errors="replace").decode("ascii"))
106: 
107: 
108: def load_alerts(limit: int = 50) -> list[dict]:
109:     """
110:     Read the most recent alert entries from alerts.log.
111: 
112:     Args:
113:         limit: Maximum number of alerts to return.
114: 
115:     Returns:
116:         List of alert dicts, most recent last.
117:     """
118:     if not os.path.exists(ALERT_LOG_PATH):
119:         return []
120: 
121:     alerts = []
122:     with open(ALERT_LOG_PATH, "r", encoding="utf-8") as f:
123:         for line in f:
124:             line = line.strip()
125:             if not line:
126:                 continue
127:             try:
128:                 alerts.append(json.loads(line))
129:             except json.JSONDecodeError:
130:                 continue
131: 
132:     return alerts[-limit:]
</file>

<file path="app_desktop.py">
  1: """
  2: app_desktop.py - Native Windows Desktop Application for FileSentinel DLP
  3: Combines:
  4:   - pywebview: Native Chromium/Edge desktop window for the SPLUNK dashboard
  5:   - pystray: System tray icon with right-click menu
  6:   - Native toast notifications for WARNING and CRITICAL policy violations
  7:   - Background watchdog filesystem monitoring
  8:   - Instant and clean shutdown on window close [X] or Ctrl+C
  9: """
 10: 
 11: import os
 12: import sys
 13: import time
 14: import signal
 15: import threading
 16: from PIL import Image
 17: import webview
 18: 
 19: # Ensure project root is in python path
 20: BASE_DIR = os.path.dirname(os.path.abspath(__file__))
 21: sys.path.insert(0, BASE_DIR)
 22: 
 23: from config import DASHBOARD_HOST, DASHBOARD_PORT, BASE_DIR, RESOURCE_DIR
 24: from monitor import FileMonitor
 25: import alerter
 26: import reporter
 27: from dashboard.app import app as flask_app
 28: 
 29: ICON_PATH = os.path.join(RESOURCE_DIR, "assets", "icon.png")
 30: 
 31: # Global state handles
 32: _monitor = None
 33: _tray_icon = None
 34: _main_window = None
 35: _is_monitoring = True
 36: _is_shutting_down = False
 37: 
 38: 
 39: def _quit_app(icon=None, item=None):
 40:     """Shuts down all threads, monitor, tray icon, and exits immediately."""
 41:     global _monitor, _tray_icon, _main_window, _is_shutting_down
 42:     if _is_shutting_down:
 43:         return
 44:     _is_shutting_down = True
 45: 
 46:     print("\n  [+] FileSentinel shutting down...")
 47: 
 48:     if _monitor:
 49:         try:
 50:             _monitor.stop()
 51:         except Exception:
 52:             pass
 53: 
 54:     if _tray_icon:
 55:         try:
 56:             _tray_icon.stop()
 57:         except Exception:
 58:             pass
 59: 
 60:     if _main_window:
 61:         try:
 62:             _main_window.destroy()
 63:         except Exception:
 64:             pass
 65: 
 66:     # Hard exit guarantees no background threads (Flask, Watchdog) linger in memory
 67:     os._exit(0)
 68: 
 69: 
 70: def _handle_exit_signal(sig=None, frame=None):
 71:     """Signal handler for Ctrl+C (SIGINT) and termination (SIGTERM)."""
 72:     _quit_app()
 73: 
 74: 
 75: # Register signal handlers
 76: try:
 77:     signal.signal(signal.SIGINT, _handle_exit_signal)
 78:     signal.signal(signal.SIGTERM, _handle_exit_signal)
 79: except Exception:
 80:     pass
 81: 
 82: # Windows console control handler (handles Ctrl+C even if Python thread is blocked in C loop)
 83: try:
 84:     import win32api
 85: 
 86:     def _console_ctrl_handler(ctrl_type):
 87:         _quit_app()
 88:         return True
 89: 
 90:     win32api.SetConsoleCtrlHandler(_console_ctrl_handler, True)
 91: except Exception:
 92:     pass
 93: 
 94: 
 95: def _run_flask_server():
 96:     """Runs the local Flask backend server in a background thread."""
 97:     flask_app.run(host=DASHBOARD_HOST, port=DASHBOARD_PORT, debug=False, use_reloader=False)
 98: 
 99: 
100: def _show_toast_notification(level: str, message: str, event_data: dict):
101:     """Dispatches a native Windows toast notification via the system tray icon."""
102:     global _tray_icon
103:     if _tray_icon:
104:         src = event_data.get("source", "")
105:         file_name = os.path.basename(src) if src else ""
106:         title = f"FileSentinel [{level}]"
107:         body = f"{message}\nFile: {file_name}" if file_name else message
108:         try:
109:             _tray_icon.notify(body[:120], title)
110:         except Exception:
111:             pass
112: 
113: 
114: def _on_generate_report(icon=None, item=None):
115:     """Menu action: generates an audit report and displays notification."""
116:     report_file = reporter.generate_report()
117:     if _tray_icon:
118:         _tray_icon.notify(f"Audit report saved to:\n{os.path.basename(report_file)}", "Report Generated")
119: 
120: 
121: def _toggle_monitoring(icon=None, item=None):
122:     """Menu action: pauses or resumes the filesystem monitor."""
123:     global _monitor, _is_monitoring
124:     if _monitor:
125:         if _is_monitoring:
126:             _monitor.stop()
127:             _is_monitoring = False
128:             if _tray_icon:
129:                 _tray_icon.notify("File transfer monitoring is paused.", "Monitoring Paused")
130:         else:
131:             _monitor = FileMonitor()
132:             _monitor.start()
133:             _is_monitoring = True
134:             if _tray_icon:
135:                 _tray_icon.notify("File transfer monitoring has resumed.", "Monitoring Active")
136: 
137: 
138: def _show_window(icon=None, item=None):
139:     """Brings the dashboard desktop window to the front."""
140:     global _main_window
141:     if _main_window:
142:         try:
143:             _main_window.show()
144:             _main_window.restore()
145:         except Exception:
146:             pass
147: 
148: 
149: def _setup_system_tray():
150:     """Initializes and runs the system tray icon with context menu."""
151:     global _tray_icon
152:     import pystray
153:     from pystray import MenuItem as item
154: 
155:     if os.path.exists(ICON_PATH):
156:         tray_img = Image.open(ICON_PATH)
157:     else:
158:         tray_img = Image.new("RGB", (64, 64), (13, 27, 42))
159: 
160:     menu = pystray.Menu(
161:         item("Open Dashboard", _show_window, default=True),
162:         item("Generate Report", _on_generate_report),
163:         pystray.Menu.SEPARATOR,
164:         item(lambda text: "Pause Monitoring" if _is_monitoring else "Resume Monitoring", _toggle_monitoring),
165:         pystray.Menu.SEPARATOR,
166:         item("Exit FileSentinel", _quit_app),
167:     )
168: 
169:     _tray_icon = pystray.Icon("FileSentinel", tray_img, "FileSentinel DLP", menu)
170:     _tray_icon.run()
171: 
172: 
173: def _on_window_closing():
174:     """When the user closes the window with [X], cleanly exit the entire application."""
175:     _quit_app()
176: 
177: 
178: def launch_desktop_app():
179:     """Main entry point for the desktop application."""
180:     global _monitor, _main_window
181: 
182:     # 1. Register native toast notification callback (only for security alerts)
183:     alerter.register_desktop_notifier(_show_toast_notification)
184: 
185:     # 2. Start Flask Web Server thread
186:     flask_thread = threading.Thread(target=_run_flask_server, daemon=True)
187:     flask_thread.start()
188:     time.sleep(0.8)
189: 
190:     # 3. Start File Monitor thread
191:     _monitor = FileMonitor()
192:     _monitor.start()
193: 
194:     # 4. Start System Tray icon in background thread
195:     tray_thread = threading.Thread(target=_setup_system_tray, daemon=True)
196:     tray_thread.start()
197: 
198:     # 5. Create Native pywebview desktop window
199:     dashboard_url = f"http://{DASHBOARD_HOST}:{DASHBOARD_PORT}"
200:     _main_window = webview.create_window(
201:         title="FileSentinel DLP - Secure File Transfer System",
202:         url=dashboard_url,
203:         width=1240,
204:         height=820,
205:         min_size=(920, 600),
