<file path="build_all.ps1">
  1: <#
  2: .SYNOPSIS
  3:     Builds the FileSentinel Standalone Executable (.exe) and Windows Installer (.msi).
  4: 
  5: .DESCRIPTION
  6:     1. Verifies/downloads portable WiX Toolset binaries into tools\wix
  7:     2. Runs PyInstaller to compile FileSentinel.exe with embedded templates, static files, icons, and PE version resource
  8:     3. Runs WiX candle and light to generate FileSentinel-Setup.msi
  9:     4. Applies Authenticode code-signing to both binaries
 10:     5. Outputs all distribution packages into the dist\ directory
 11: #>
 12: 
 13: $ErrorActionPreference = "Stop"
 14: $ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
 15: Set-Location $ScriptDir
 16: 
 17: Write-Host "`n========================================================" -ForegroundColor Cyan
 18: Write-Host "   FileSentinel DLP - Automated Build Pipeline (.exe & .msi)" -ForegroundColor Cyan
 19: Write-Host "========================================================`n" -ForegroundColor Cyan
 20: 
 21: # 1. Check Python & PyInstaller
 22: Write-Host "[1/5] Checking Python environment and dependencies..." -ForegroundColor Yellow
 23: $py = Get-Command python -ErrorAction SilentlyContinue
 24: if (!$py) {
 25:     Write-Error "Python was not found in PATH. Please install Python 3.10+."
 26: }
 27: 
 28: $hasPyInstaller = python -c "import PyInstaller" 2>$null
 29: if ($LASTEXITCODE -ne 0) {
 30:     Write-Host "  Installing PyInstaller..." -ForegroundColor DarkGray
 31:     python -m pip install pyinstaller
 32: }
 33: 
 34: # 2. Check/Download WiX Toolset (portable binaries)
 35: Write-Host "[2/5] Ensuring WiX Toolset binaries..." -ForegroundColor Yellow
 36: $WixDir = Join-Path $ScriptDir "tools\wix"
 37: $CandleExe = Join-Path $WixDir "candle.exe"
 38: $LightExe = Join-Path $WixDir "light.exe"
 39: 
 40: if (!(Test-Path $CandleExe) -or !(Test-Path $LightExe)) {
 41:     Write-Host "  Downloading portable WiX 3.11 binaries..." -ForegroundColor DarkGray
 42:     if (!(Test-Path $WixDir)) { New-Item -ItemType Directory -Path $WixDir -Force | Out-Null }
 43:     $ZipPath = Join-Path $WixDir "wix.zip"
 44:     Invoke-WebRequest -Uri "https://github.com/wixtoolset/wix3/releases/download/wix3112rtm/wix311-binaries.zip" -OutFile $ZipPath
 45:     Expand-Archive -Path $ZipPath -DestinationPath $WixDir -Force
 46:     Remove-Item $ZipPath -Force
 47: }
 48: Write-Host "  WiX Toolset ready." -ForegroundColor Green
 49: 
 50: # 3. Build Standalone Executable (.exe)
 51: Write-Host "[3/5] Building FileSentinel.exe with PyInstaller & PE Version Info..." -ForegroundColor Yellow
 52: $VersionFile = Join-Path $ScriptDir "installer\version_info.txt"
 53: 
 54: python -m PyInstaller `
 55:     --noconsole `
 56:     --onefile `
 57:     --name "FileSentinel" `
 58:     --icon "assets/icon.ico" `
 59:     --version-file "$VersionFile" `
 60:     --collect-all "webview" `
 61:     --collect-all "pystray" `
 62:     --add-data "dashboard/templates;dashboard/templates" `
 63:     --add-data "dashboard/static;dashboard/static" `
 64:     --add-data "assets;assets" `
 65:     main.py
 66: 
 67: if ($LASTEXITCODE -ne 0) {
 68:     Write-Error "PyInstaller build failed."
 69: }
 70: Write-Host "  FileSentinel.exe generated successfully." -ForegroundColor Green
 71: 
 72: # 4. Compile Windows MSI Installer (.msi)
 73: Write-Host "[4/5] Compiling Windows Installer (.msi) with WiX..." -ForegroundColor Yellow
 74: $InstallerDir = Join-Path $ScriptDir "installer"
 75: $WixObj = Join-Path $InstallerDir "FileSentinel.wixobj"
 76: $WxsFile = Join-Path $InstallerDir "FileSentinel.wxs"
 77: $MsiOutput = Join-Path $ScriptDir "dist\FileSentinel-Setup.msi"
 78: 
 79: & $CandleExe -nologo -arch x64 -ext WixUIExtension $WxsFile -out $WixObj
 80: if ($LASTEXITCODE -ne 0) { Write-Error "WiX candle compilation failed." }
 81: 
 82: & $LightExe -nologo -ext WixUIExtension -sice:ICE69 -out $MsiOutput $WixObj
 83: if ($LASTEXITCODE -ne 0) { Write-Error "WiX light linking failed." }
 84: 
 85: # Cleanup intermediate obj file
 86: if (Test-Path $WixObj) { Remove-Item $WixObj -Force }
 87: 
 88: # 5. Apply Authenticode Digital Signatures
 89: Write-Host "[5/5] Applying Authenticode Code Signing..." -ForegroundColor Yellow
 90: $cert = Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert -ErrorAction SilentlyContinue | Select-Object -First 1
 91: if (!$cert) {
 92:     $cert = New-SelfSignedCertificate -Type CodeSigningCert -Subject "CN=FileSentinel Security, O=FileSentinel, C=US" -CertStoreLocation "Cert:\CurrentUser\My" -NotAfter (Get-Date).AddYears(5)
 93: }
 94: 
 95: if ($cert) {
 96:     Set-AuthenticodeSignature -FilePath "dist\FileSentinel.exe" -Certificate $cert | Out-Null
 97:     Set-AuthenticodeSignature -FilePath "dist\FileSentinel-Setup.msi" -Certificate $cert | Out-Null
 98:     Write-Host "  Digital signatures applied to FileSentinel.exe and FileSentinel-Setup.msi." -ForegroundColor Green
 99: }
100: 
101: Write-Host "`n========================================================" -ForegroundColor Green
102: Write-Host "   BUILD SUCCESSFUL!" -ForegroundColor Green
103: Write-Host "========================================================" -ForegroundColor Green
104: $ExeItem = Get-Item "dist\FileSentinel.exe"
105: $MsiItem = Get-Item "dist\FileSentinel-Setup.msi"
106: 
107: Write-Host ("  Standalone Executable : {0} ({1:N2} MB)" -f $ExeItem.FullName, ($ExeItem.Length / 1MB)) -ForegroundColor Cyan
108: Write-Host ("  Windows Installer MSI : {0} ({1:N2} MB)" -f $MsiItem.FullName, ($MsiItem.Length / 1MB)) -ForegroundColor Cyan
109: Write-Host "========================================================`n" -ForegroundColor Green
</file>

<file path="db.py">
  1: """
  2: db.py - Persistent SQLite Database Engine for FileSentinel
  3: Manages persistent baseline file hashes, custom monitored directories,
  4: SOC allowlists, and quarantine vault metadata across system reboots.
  5: """
  6: 
  7: import os
  8: import sqlite3
  9: import threading
 10: import time
 11: import shutil
 12: from config import BASE_DIR
 13: 
 14: DATA_DIR = os.path.join(BASE_DIR, "data")
 15: VAULT_DIR = os.path.join(BASE_DIR, "vault")
 16: QUARANTINE_DIR = os.path.join(VAULT_DIR, "quarantine")
 17: DB_PATH = os.path.join(DATA_DIR, "filesentinel.db")
 18: 
 19: os.makedirs(DATA_DIR, exist_ok=True)
 20: os.makedirs(QUARANTINE_DIR, exist_ok=True)
 21: 
 22: _db_lock = threading.Lock()
 23: 
 24: 
 25: def _get_connection() -> sqlite3.Connection:
 26:     conn = sqlite3.connect(DB_PATH, timeout=10.0)
 27:     conn.row_factory = sqlite3.Row
 28:     return conn
