 2: tests/test_integration.py - Live integration test for debounce and self-logging prevention
 3: """
 4: 
 5: import os
 6: import sys
 7: import time
 8: import tempfile
 9: import shutil
10: 
11: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
12: 
13: from monitor import FileMonitor
14: import logger
15: 
16: 
17: def test_monitor_no_flood():
18:     # Record starting log count
19:     start_logs = len(logger.load_logs())
20: 
21:     # Create a temporary monitored directory
22:     temp_dir = tempfile.mkdtemp(prefix="sec_mon_test_")
23: 
24:     monitor = FileMonitor(directories=[temp_dir])
25:     monitor.start()
26:     time.sleep(0.5)
27: 
28:     try:
29:         # 1. Create a normal file and write to it multiple times in rapid succession
30:         normal_file = os.path.join(temp_dir, "notes.txt")
31:         with open(normal_file, "w") as f:
32:             f.write("Hello World\n")
33: 
34:         # Simulate rapid write flushes like Windows does during file copy
35:         for i in range(10):
36:             with open(normal_file, "a") as f:
37:                 f.write(f"Line {i}\n")
38:             time.sleep(0.05)
39: 
40:         time.sleep(1.0)
41: 
42:         # 2. Create a sensitive file
43:         sensitive_file = os.path.join(temp_dir, "payroll.xlsx")
44:         with open(sensitive_file, "wb") as f:
45:             f.write(b"PK\x03\x04DummyExcelBytes")
46: 
47:         for i in range(10):
48:             with open(sensitive_file, "ab") as f:
49:                 f.write(b"extra_chunk")
50:             time.sleep(0.05)
51: 
52:         time.sleep(1.0)
53: 
54:     finally:
55:         monitor.stop()
56:         shutil.rmtree(temp_dir, ignore_errors=True)
57: 
58:     # Check results
59:     new_logs = logger.load_logs()[start_logs:]
60:     print(f"\n--- INTEGRATION TEST RESULTS ---")
61:     print(f"Total events recorded: {len(new_logs)}")
62:     for l in new_logs:
63:         print(f"[{l['alert_level']}] {l['event_type']} -> {os.path.basename(l['source'])}")
64: 
65:     normal_events = [l for l in new_logs if "notes.txt" in l["source"]]
66:     sensitive_events = [l for l in new_logs if "payroll.xlsx" in l["source"]]
67: 
68:     print(f"Normal file events: {len(normal_events)} (expected 1, was 0 without debounce)")
69:     print(f"Sensitive file events: {len(sensitive_events)} (expected 1, was 0 without debounce)")
70: 
71:     assert len(normal_events) <= 2, f"Too many normal file events: {len(normal_events)}"
72:     assert len(sensitive_events) <= 2, f"Too many sensitive file events: {len(sensitive_events)}"
73: 
74:     # Check alert levels
75:     if normal_events:
76:         assert normal_events[0]["alert_level"] == "INFO", f"Expected INFO for notes.txt, got {normal_events[0]['alert_level']}"
77:     if sensitive_events:
78:         assert sensitive_events[0]["alert_level"] == "WARNING", f"Expected WARNING for payroll.xlsx, got {sensitive_events[0]['alert_level']}"
79: 
80:     print("ALL INTEGRATION ASSERTIONS PASSED! Clean, non-flooded monitoring verified.")
81: 
82: 
