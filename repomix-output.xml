205: # ── Quarantine Vault Functions ───────────────────────────────────────────────
206: 
207: def quarantine_file(src_path: str, reason: str = "User Initiated Quarantine") -> dict:
208:     """
209:     Safely relocate a file to the isolated quarantine vault,
210:     rename it with .quarantine extension, and make it read-only.
211:     """
212:     if not src_path or not os.path.exists(src_path):
213:         return {"success": False, "error": f"File does not exist on disk: '{src_path}'"}
214: 
215:     norm_src = os.path.normpath(os.path.abspath(src_path))
216:     try:
217:         size = os.path.getsize(norm_src)
218:     except OSError:
219:         size = 0
220: 
221:     basename = os.path.basename(norm_src)
222:     ts = int(time.time())
223:     dest_filename = f"{ts}_{basename}.quarantine"
224:     dest_path = os.path.join(QUARANTINE_DIR, dest_filename)
225: 
226:     try:
227:         shutil.move(norm_src, dest_path)
228:         # Set read-only permissions on quarantined file
229:         try:
230:             os.chmod(dest_path, 0o444)
231:         except OSError:
232:             pass
233: 
234:         with _db_lock, _get_connection() as conn:
235:             cursor = conn.execute("""
236:                 INSERT INTO quarantine_vault (original_path, quarantined_path, quarantined_at, file_size, reason)
237:                 VALUES (?, ?, ?, ?, ?)
238:             """, (norm_src, dest_path, time.time(), size, reason))
239:             conn.commit()
240:             record_id = cursor.lastrowid
241: 
242:         # Remove from baseline registry
243:         remove_baseline(norm_src)
244: 
245:         return {
246:             "success": True,
247:             "record_id": record_id,
248:             "original_path": norm_src,
249:             "quarantined_path": dest_path,
250:             "size": size,
251:             "message": f"Successfully quarantined {basename} to vault."
252:         }
253:     except Exception as e:
254:         return {"success": False, "error": str(e)}
255: 
256: 
257: def get_quarantined_files() -> list[dict]:
258:     with _db_lock, _get_connection() as conn:
259:         rows = conn.execute("""
260:             SELECT id, original_path, quarantined_path, quarantined_at, file_size, reason
261:             FROM quarantine_vault ORDER BY quarantined_at DESC
262:         """).fetchall()
263:         return [dict(r) for r in rows]
