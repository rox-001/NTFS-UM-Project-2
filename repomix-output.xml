 59:           <div class="stat-label">INFO</div>
 60:         </div>
 61:       </div>
 62:       <div class="stat-card warning">
 63:         <div class="stat-icon">⚠</div>
 64:         <div class="stat-body">
 65:           <div class="stat-value" id="statWarning">0</div>
 66:           <div class="stat-label">WARNINGS</div>
 67:         </div>
 68:       </div>
 69:       <div class="stat-card critical">
 70:         <div class="stat-icon">🔴</div>
 71:         <div class="stat-body">
 72:           <div class="stat-value" id="statCritical">0</div>
 73:           <div class="stat-label">CRITICAL</div>
 74:         </div>
 75:       </div>
 76:       <div class="stat-card tampered">
 77:         <div class="stat-icon">🔐</div>
 78:         <div class="stat-body">
 79:           <div class="stat-value" id="statTampered">0</div>
 80:           <div class="stat-label">Tampered</div>
 81:         </div>
 82:       </div>
 83:     </section>
 84: 
 85:     <!-- Filter Bar -->
 86:     <section class="filter-bar">
 87:       <input type="text"  id="searchInput"  class="filter-input" placeholder="🔍  Search source, destination, event type, user…" />
 88:       <select id="levelFilter" class="filter-select" title="Filter by alert level">
 89:         <option value="">All Levels</option>
 90:         <option value="INFO">INFO</option>
 91:         <option value="WARNING">WARNING</option>
 92:         <option value="CRITICAL">CRITICAL</option>
 93:       </select>
 94:       <select id="fileTypeFilter" class="filter-select" title="Filter by file type">
 95:         <option value="">All File Types</option>
 96:         <option value="documents">📄 Documents (.docx, .pdf, .xlsx...)</option>
 97:         <option value="secrets">🔑 Secrets & Keys (.pem, .env...)</option>
 98:         <option value="databases">🗄️ Databases (.sql, .db...)</option>
 99:         <option value="scripts">📜 Scripts & Code (.py, .ps1...)</option>
100:         <option value="archives">📦 Archives (.zip, .7z...)</option>
101:       </select>
102:       <select id="sortSelect" class="filter-select" title="Sort log events" onchange="onSortSelectChange()">
103:         <option value="timestamp_desc">📅 Date: Newest First</option>
104:         <option value="timestamp_asc">📅 Date: Oldest First</option>
105:         <option value="level_desc">🚨 Severity: High → Low</option>
106:         <option value="level_asc">ℹ️ Severity: Low → High</option>
107:         <option value="source_asc">📁 Directory / Path (A-Z)</option>
