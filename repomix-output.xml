651:     def stop(self):
652:         """Gracefully stop observer, timers, and polling threads."""
653:         global _active_monitor
654:         if self._running:
655:             self._stop_event.set()
656:             with _debounce_lock:
657:                 for timer in _pending_delete_timers.values():
658:                     timer.cancel()
659:                 _pending_delete_timers.clear()
660:                 _pending_deletions.clear()
661:             self.observer.stop()
662:             self.observer.join(timeout=1.0)
663:             self._running = False
664:             self._watches.clear()
665:             self._scheduled_paths.clear()
666:             _active_monitor = None
667:             print("\n  Monitor stopped. Goodbye.")
668: 
669:     def is_running(self) -> bool:
670:         return self._running
